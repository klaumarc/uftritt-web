---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Button from "../components/Button.astro";
import LocalTrust from "../components/LocalTrust.astro";
import OfferLink from "../components/OfferLink.astro";
import { projects } from "../data/projects";

const cases = projects.filter((p) =>
  ["cynterim", "architekturmacher", "beat-brugger"].includes(p.slug)
);

const saeulen = [
  {
    title: "Positionierung",
    note: "Im Workshop klären wir, wofür deine Marke steht, wen sie anspricht und wogegen sie sich abgrenzt. Das Ergebnis halten wir schriftlich fest. Es wird zum Kompass für jede spätere Entscheidung, vom Namen bis zur Bildwelt.",
  },
  {
    title: "Naming",
    note: "Wir entwickeln Namensrichtungen mit klaren Kriterien, prüfen sie grob auf Kollisionen und Verfügbarkeiten und begleiten dich bis zur Entscheidung. Die juristische Absicherung übernehmen Markenrechtlerinnen und Anwälte.",
  },
  {
    title: "Verbal Identity",
    note: "Wie klingt deine Marke? Tonalität, Kernbotschaften und Wording, damit du auf der Website, in der Offerte und auf Social Media mit einer Stimme sprichst statt jedes Mal neu anzufangen.",
  },
  {
    title: "Visuelles Erscheinungsbild",
    note: "Erst wenn Strategie und Sprache stehen, gestalten wir Logo, Farben und Typografie. So wird das Design zum Ausdruck der Strategie statt zur reinen Geschmacksfrage.",
  },
];

const prozess = [
  "Workshop: Wir hören zu und stellen die Fragen zu Markt, Zielgruppe und Ambition",
  "Strategie: Positionierung und Kernbotschaft, schriftlich festgehalten als Kompass",
  "Name: Kreation, Shortlist und Grobprüfung, die verbindliche Prüfung folgt mit Markenrechtlerinnen",
  "Design: Logo, Farbwelt, Typografie und Regeln, entwickelt aus der Strategie",
  "Rollout: Übergabe aller Dateien und Begleitung bei den ersten Anwendungen",
];

const faq = [
  {
    q: "Was kostet Branding bei euch?",
    a: "Das hängt vom Umfang ab: nur Strategie und Name oder der ganze Weg bis zum fertigen Erscheinungsbild und Rollout. Nach einem kostenlosen Erstgespräch bekommst du ein transparentes Angebot mit klarem Preis. Als erste Orientierung für den visuellen Teil dienen unsere Corporate-Design-Pakete zum Fixpreis: Logo ab CHF 2500, Corporate Design klein ab CHF 5500, gross ab CHF 12 500. Die Strategie- und Naming-Phase kommt je nach Umfang dazu.",
  },
  {
    q: "Was ist der Unterschied zwischen Branding und Logo?",
    a: "Das Logo ist ein Zeichen. Branding ist die Strategie dahinter: wofür du stehst, wie du heisst, wie du sprichst und wie du aussiehst. Ein Logo ohne diese Grundlagen ist Dekoration und wird bei der nächsten Geschmacksdiskussion neu verhandelt. Eine Marke mit klarer Positionierung gibt dagegen jeder Umsetzung eine Richtung, von der Visitenkarte bis zur Website.",
  },
  {
    q: "Wie lange dauert ein Branding-Projekt?",
    a: "Rechne in Wochen bis wenigen Monaten statt in Tagen: Workshop und Strategie gehen zügig, das Naming braucht wegen Prüfschlaufen und Abstimmungen mit dem Markenrecht seine Zeit, Design und Rollout hängen vom Umfang der Anwendungen ab. Beim Kick-off bekommst du einen verbindlichen Zeitplan, an dem wir uns messen lassen.",
  },
  {
    q: "Macht ihr auch Namen für Firma oder Produkt?",
    a: "Ja, Naming ist ein fester Teil unseres Prozesses: Kriterien definieren, Richtungen entwickeln, Shortlist bilden und grob prüfen, etwa auf offensichtliche Kollisionen und freie Domains. Die verbindliche Recherche und die Registrierung der Marke beim Eidgenössischen Institut für Geistiges Eigentum (IGE) übernehmen spezialisierte Markenrechtlerinnen und Anwälte. Wir bereiten alles so vor, dass dieser Schritt nicht zur teuren Überraschung wird.",
  },
  {
    q: "Kümmert ihr euch auch ums Markenrecht?",
    a: "Ehrliche Antwort: Wir sind Gestalter und Strategen, keine Juristen. Wir prüfen Namen im Prozess grob vor, damit du nicht in eine Sackgasse läufst. Für die verbindliche Identitäts- und Ähnlichkeitsrecherche und die Markenanmeldung beim IGE ziehen wir Markenrechtler bei. Das kostet extra, ist aber deutlich günstiger als ein Namenswechsel nach dem Launch.",
  },
  {
    q: "Wir haben schon eine Marke. Ist das hier das Richtige?",
    a: "Dann ist Branding von Grund auf der falsche Ansatz. Wenn deine Marke existiert, aber gewachsen, veraltet oder unklar geworden ist, richten wir sie im Rahmen eines Rebrandings neu aus. Dabei bleibt erhalten, was funktioniert, und du musst nicht bei null starten. Sag uns im Erstgespräch, wo du stehst, und wir empfehlen dir den passenden Weg.",
  },
];
---

<Layout
  title="Branding Agentur: neue Marken für KMU, Uftritt"
  description="Branding Agentur für KMU: Wir bauen deine neue Marke von Grund auf. Positionierung, Naming, Verbal Identity, dann erst das Design. Aus dem Zürcher Oberland."
>
  <PageHero
    eyebrow="Neue Marke von Grund auf"
    title={"Branding Agentur\nfür neue Marken"}
    lead="Branding heisst bei uns: erst denken, dann gestalten. Als Branding Agentur bauen wir deine neue Marke von Grund auf: Positionierung im Workshop, Naming und Verbal Identity, und erst dann das visuelle Erscheinungsbild. So wird deine Marke nicht zur hübschen Hülle, sondern zum Fundament, auf dem alles Weitere steht."
    lottie="/lottie/grafikdesign.json"
    lottieLabel="Grafikdesign"
  >
    <div slot="hero-extra" class="hero-ctas">
      <Button href="/kontakt/" variant="blue">Kostenloses Erstgespräch</Button>
      <Button href="/projekte/" variant="text">Projekte ansehen</Button>
    </div>
  </PageHero>

  <OfferLink href="/angebot/grafikdesign/" label="Grafikdesign" lottie="/lottie/grafikdesign.json" projects={cases} />

  {/* Säulen */}
  <section class="section">
    <div class="container">
      <header class="section-head" data-reveal>
        <span class="eyebrow">Strategie vor Gestaltung</span>
        <h2>Die vier Säulen deiner neuen Marke</h2>
      </header>
      <div class="karten karten--4" data-reveal>
        {
          saeulen.map((s) => (
            <article class="karte">
              <h3>{s.title}</h3>
              <p class="karte-note">{s.note}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* Dedupe */}
  <section class="section section--soft">
    <div class="container">
      <header class="section-head" data-reveal>
        <span class="eyebrow">Die richtige Tür wählen</span>
        <h2>Branding, Corporate Design oder Rebranding?</h2>
      </header>
      <div class="karten karten--3" data-reveal>
        <article class="karte">
          <h3>Branding: diese Seite</h3>
          <p class="karte-note">
            Du gründest neu oder bringst ein Angebot auf den Markt. Wir bauen die
            Marke von Grund auf: Strategie, Name, Sprache und dann das Design.
          </p>
        </article>
        <article class="karte">
          <h3>Corporate Design</h3>
          <p class="karte-note">
            Strategie und Name stehen schon? Dann geht es um die visuelle
            Umsetzung als System: Logo, Farbwelt, Typografie und Manual. Unsere
            Pakete mit Fixpreis findest du unter
            <a href="/corporate-design/">Corporate Design</a>.
          </p>
        </article>
        <article class="karte">
          <h3>Rebranding</h3>
          <p class="karte-note">
            Deine Marke existiert, ist aber gewachsen, veraltet oder unklar
            geworden? Dann richten wir sie neu aus statt bei null zu starten.
            Mehr dazu unter <a href="/rebranding/">Rebranding</a>.
          </p>
        </article>
      </div>
    </div>
  </section>

  {/* Prozess + Markenrecht ehrlich */}
  <section class="section">
    <div class="container lp-blocks">
      <article class="lp-block" data-reveal>
        <h2>So entsteht deine Marke</h2>
        <div class="lp-text">
          <p>
            Fünf Schritte, klare Reihenfolge, kein Agentur-Theater: Du weisst
            jederzeit, wo wir stehen und was als Nächstes kommt. Die Reihenfolge
            ist dabei kein Zufall. Wer mit dem Design startet, dekoriert eine
            ungeprüfte Idee. Wer mit der Strategie startet, bekommt ein Design,
            das begründet ist und bleibt.
          </p>
          <ul class="modul-liste">
            {prozess.map((p, i) => <li><span class="modul-nr">{i + 1}</span>{p}</li>)}
          </ul>
        </div>
      </article>
      <article class="lp-block" data-reveal>
        <h2>Ehrlich gesagt: Am Namen hängt Juristerei</h2>
        <div class="lp-text">
          <p>
            Ein guter Name nützt nichts, wenn er eine bestehende Marke verletzt
            oder sich nicht schützen lässt. Darum prüfen wir schon im Prozess
            grob: offensichtliche Kollisionen, freie Domains, erste Abklärungen
            in öffentlichen Registern.
          </p>
          <p>
            Die verbindliche Recherche und die Registrierung deiner Marke beim
            Eidgenössischen Institut für Geistiges Eigentum (IGE) gehört aber in
            die Hände von Markenrechtlerinnen und Anwälten. Wir sagen dir, wann
            es so weit ist, und bereiten alles so vor, dass dieser Check nicht
            zur teuren Überraschung wird.
          </p>
        </div>
      </article>
    </div>
  </section>

  {/* Cases + Abgrenzung Logo */}
  <section class="section section--soft">
    <div class="container lp-blocks">
      <article class="lp-block" data-reveal>
        <h2>Marken, die bei uns entstanden sind</h2>
        <div class="lp-text">
          <p>
            Für die Cynterim GmbH aus Hinwil haben wir zum Markteinstieg Logo,
            Branding und Website gebaut, damit das Salesforce-Partnerunternehmen
            vom ersten Tag an stringent auftritt. Für die Architekturmacher GmbH
            entstanden Wortmarke, Corporate-Farbe und Schriftenkonzept, als sich
            der erfahrene Architekt selbständig machte. Und für das neu
            gegründete Beratungsunternehmen Beat Brugger Impulse haben wir das
            komplette Erscheinungsbild mit Logo und Drucksachen entwickelt.
          </p>
          <p>
            Gemeinsam haben diese Projekte eines: Die Markenarbeit begann vor
            dem ersten Auftritt, nicht danach.
          </p>
        </div>
      </article>
      <article class="lp-block" data-reveal>
        <h2>Brauchst du wirklich das ganze Programm?</h2>
        <div class="lp-text">
          <p>
            Ehrliche Einordnung: Nicht jedes Vorhaben braucht Strategie, Naming
            und das volle System. Für einen Anlass, ein Nebenprojekt oder ein
            einzelnes Zeichen ist der kürzere Weg unsere Seite
            <a href="/logo-erstellen-lassen/">Logo erstellen lassen</a>.
          </p>
          <p>
            Sobald aber eine Firma, ein Produkt oder ein Angebot jahrelang unter
            diesem Namen verkaufen soll, lohnt sich das Fundament. Später
            umbauen kostet fast immer mehr als gleich richtig bauen.
          </p>
        </div>
      </article>
    </div>
  </section>

  {/* FAQ */}
  <section class="section">
    <div class="container faq-wrap">
      <header class="section-head" data-reveal>
        <span class="eyebrow">FAQ</span>
        <h2>Häufige Fragen zum Branding</h2>
      </header>
      <div class="faq" data-reveal>
        {
          faq.map((f, i) => (
            <details class="faq-item" name="faq" open={i === 0}>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <LocalTrust check={false} />

  <section class="section section--yellow">
    <div class="container lp-cta" data-reveal>
      <h2>Noch eine Idee oder schon ein Businessplan?</h2>
      <p class="lp-cta-text">
        Erzähl uns, was du aufbauen willst. Wir sagen dir ehrlich, was deine
        Marke braucht, und machen dir ein transparentes Angebot.
      </p>
      <Button href="/kontakt/" variant="blue">Schriib eus</Button>
    </div>
  </section>

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faq.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    })}
  />
</Layout>

<style>
  .karten { display: grid; gap: clamp(0.75rem, 2vw, 1.5rem); }
  .karten--3 { grid-template-columns: repeat(3, 1fr); }
  .karten--4 { grid-template-columns: repeat(4, 1fr); }
  .karte {
    display: flex; flex-direction: column; gap: 0.5rem;
    background: #fff; border: 1px solid #e7ecf3; padding: clamp(1.25rem, 2.5vw, 1.75rem);
  }
  .karte h3 { color: var(--color-blue); font-size: 1.15rem; }
  .karte-note { color: var(--color-blue); opacity: 0.85; font-size: 0.95rem; line-height: 1.6; margin: 0; }
  .karte-note a { color: var(--color-blue); font-weight: 700; }
  .karte-note a:hover { color: var(--color-pink); }

  .lp-blocks { display: flex; flex-direction: column; gap: clamp(2.5rem, 5vw, 4.5rem); }
  .lp-block { display: grid; grid-template-columns: 1fr 2fr; gap: clamp(1rem, 3vw, 3rem); align-items: start; }
  .lp-block h2 { position: sticky; top: 100px; }
  .lp-text p { color: var(--color-blue); font-size: 1.1rem; line-height: 1.7; margin-bottom: 1rem; }
  .lp-text a { color: var(--color-blue); font-weight: 700; }
  .lp-text a:hover { color: var(--color-pink); }

  .modul-liste { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .modul-liste li {
    display: flex; align-items: baseline; gap: 0.9rem;
    padding: 0.8rem 0; border-bottom: 1px solid rgba(1, 64, 128, 0.15);
    color: var(--color-blue); font-size: 1.05rem; line-height: 1.5;
  }
  .modul-liste li:last-child { border-bottom: 0; }
  .modul-nr {
    flex: none; display: inline-flex; align-items: center; justify-content: center;
    width: 1.6em; height: 1.6em; background: var(--color-yellow); color: var(--color-blue);
    font-weight: 700; font-size: 0.9rem;
  }

  .faq-wrap { max-width: 860px; }
  .faq-item { border-bottom: 1px solid rgba(1, 64, 128, 0.2); }
  .faq-item summary {
    cursor: var(--cur-hand); list-style: none; padding: 1.1rem 0;
    font-weight: 700; color: var(--color-blue); font-size: 1.15rem;
    display: flex; justify-content: space-between; gap: 1rem;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: "+"; display: inline-flex; align-items: center; justify-content: center; width: 1em; height: 1em; line-height: 1; transform-origin: center; font-weight: 700; transition: transform 0.3s var(--ease); }
  .faq-item[open] summary::after { transform: rotate(45deg); }
  .faq-item p { color: var(--color-blue); line-height: 1.7; padding-bottom: 1.1rem; max-width: 70ch; }
  .lp-cta { display: flex; flex-direction: column; align-items: flex-start; gap: 1.25rem; }
  .lp-cta-text { color: var(--color-blue); font-size: 1.1rem; line-height: 1.7; max-width: 60ch; margin: 0; }

  @media (max-width: 900px) {
    .karten--3, .karten--4 { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 760px) {
    .lp-block { grid-template-columns: 1fr; }
    .lp-block h2 { position: static; }
  }
  @media (max-width: 520px) {
    .karten--3, .karten--4 { grid-template-columns: 1fr; }
  }
</style>
