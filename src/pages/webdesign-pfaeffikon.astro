---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Button from "../components/Button.astro";
import LocalTrust from "../components/LocalTrust.astro";
import OfferLink from "../components/OfferLink.astro";
import { projects } from "../data/projects";

const cases = projects.filter((p) =>
  ["ripa-immobilien", "beat-brugger", "ripa-weihnachtskarte"].includes(p.slug)
);

const orte = [
  { name: "Wetzikon", href: "/webdesign-wetzikon/", note: "grösste Stadt der Region" },
  { name: "Uster", href: "/webdesign-uster/", note: "Stadt am Greifensee" },
  { name: "Hinwil", href: "/webdesign-hinwil/", note: "Bezirkshauptort am Bachtel" },
  { name: "Bäretswil", href: "/webdesign-baeretswil/", note: "Nachbargemeinde im Hügelland" },
  { name: "Bauma", href: "/webdesign-bauma/", note: "unsere Heimgemeinde im Tösstal" },
  { name: "Rüti", href: "/webdesign-rueti/", note: "im Jonatal, Richtung Rapperswil" },
];

const weitere = ["Fehraltorf", "Russikon", "Seegräben", "Hittnau", "Wildberg", "Wermatswil"];

const faq = [
  { q: "Was kostet eine Website für einen Betrieb in Pfäffikon?", a: "Das hängt vom Umfang ab, vom schlanken Onepager bis zur Plattform mit Kundenlogin. Nach einem kostenlosen Erstgespräch erhältst du ein transparentes Angebot mit klarem Preis. Keine versteckten Kosten, keine Überraschungen." },
  { q: "Kommst du zu uns nach Pfäffikon?", a: "Gerne. Von Saland führt der direkte Weg über Hittnau, in gut einer Viertelstunde sind wir bei dir, im Dorf genauso wie in Auslikon oder Irgenhausen. Auf Wunsch treffen wir uns auch per Video-Call." },
  { q: "Macht ihr auch mehr als Websites?", a: "Ja: Logo, Corporate Design, Broschüren, Fotografie und Video kommen bei uns aus demselben Haus. In Pfäffikon haben wir genau so gearbeitet, von der Website über die Fotos bis zur illustrierten Weihnachtskarte." },
  { q: "Werde ich als Betrieb in Pfäffikon überhaupt gefunden?", a: "Nur mit einer Website allein ist es nicht getan, aber fast: Wir liefern jede Website mit sauberer SEO-Basis aus, also klarer Struktur, schnellen Ladezeiten, Meta-Texten und der Anmeldung bei Google. Dazu gehört ein gepflegtes Google-Unternehmensprofil, damit du in Pfäffikon und Umgebung gefunden wirst, auch auf der Karte. Und weil es gleich zwei Pfäffikon gibt, achten wir darauf, dass Google deinen Betrieb dem richtigen zuordnet." },
  { q: "Wir haben schon eine Website, lohnt sich ein Relaunch?", a: "Oft ja. Wenn die Seite älter als vier, fünf Jahre ist, auf dem Handy hakt oder bei Google abrutscht, bringt ein Neubau meist mehr als Flickwerk. Wir schauen uns deine bestehende Seite kostenlos an und sagen dir ehrlich, ob sich ein Relaunch lohnt, oder ob ein paar gezielte Anpassungen genügen." },
  { q: "Lohnt sich eine eigene Website auch für einen kleinen Betrieb?", a: "Ja. Gerade in einer Gemeinde wie Pfäffikon googeln Kundinnen und Kunden zuerst, eine klare, schnelle Website mit Leistungen, Öffnungszeiten und Kontakt wirkt rund um die Uhr, auch wenn du gerade auf dem Werkhof oder bei Kunden unterwegs bist. Wir sagen dir ehrlich, was sich für deine Grösse lohnt und was nicht." },
  { q: "Wer kümmert sich nach dem Launch um die Website?", a: "Auf Wunsch wir: Updates, Backups, kleine Anpassungen und laufende Betreuung, damit die Seite sicher bleibt und mit deinem Betrieb wächst. Oder wir zeigen dir, wie du die Inhalte selbst pflegst, ganz ohne Abhängigkeit von einer Agentur." },
  { q: "Wie lange dauert ein Website-Projekt?", a: "Je nach Umfang 4 bis 12 Wochen. Du siehst früh einen klickbaren Prototypen und bleibst durchgehend im Bild." },
];
---

<Layout
  title="Webdesign Pfäffikon, Uftritt"
  description="Webdesign für Pfäffikon ZH: Homepage oder Website erstellen lassen, für KMU am Pfäffikersee, von der Agentur aus Saland. Persönlich, ehrlich, ohne Template."
  noindex={true}
>
  <PageHero
    eyebrow="Webdesign · Pfäffikon"
    title={"Webdesign\nPfäffikon"}
    lead="Du suchst Webdesign in Pfäffikon? Uftritt ist die Kommunikationsagentur aus Saland im Zürcher Oberland: Wir entwickeln Websites und Erscheinungsbilder für KMU in Pfäffikon, persönlich, ohne Template und mit Betreuung nach dem Launch. Von unserem Büro aus sind wir in gut einer Viertelstunde bei dir am Pfäffikersee."
    lottie="/lottie/webdesign.json"
    lottieLabel="Webdesign"
  >
    <div slot="hero-extra" class="hero-ctas">
      <Button href="/kontakt/" variant="blue">Kostenloses Erstgespräch</Button>
      <Button href="/projekte/" variant="text">Projekte ansehen</Button>
    </div>
  </PageHero>

  <OfferLink href="/angebot/webdesign/" label="Webdesign und Entwicklung" lottie="/lottie/webdesign.json" projects={cases} />

  <section class="section">
    <div class="container lp-blocks">
      <article class="lp-block" data-reveal>
        <h2>Für den Hauptort am Pfäffikersee</h2>
        <div class="lp-text">
          <p>
            Pfäffikon zählt 12 750 Einwohnerinnen und Einwohner (Stand 2024) und ist
            Hauptort des gleichnamigen Bezirks, gelegen am Nord- und Ostufer des
            Pfäffikersees. Vom Dorfkern über Auslikon und Irgenhausen bis nach
            Hermatswil, Oberwil und Sulzberg arbeiten hier KMU, Gewerbebetriebe und
            Dienstleister. Bekannt ist der Ort auch für das Römerkastell in Irgenhausen
            und das Reeds-Openair direkt am See.
          </p>
          <p>
            Geprägt ist Pfäffikon durch Gewerbe und Industrie: Die 1882 hier gegründete
            Firma R.+E. Huber, aus der Huber+Suhner hervorging, betreibt bis heute das
            Werk Witzberg. Und dank S-Bahn bist du im Halbstundentakt in Zürich, viele
            Betriebe hier arbeiten weit über die Region hinaus. Unser Büro liegt in
            Saland im Tösstal, die direkte Strasse führt über Hittnau. Besprechungen
            finden bei dir statt, nicht in einer anonymen Agentur-Etage.
          </p>
          <p>
            Der See ist dabei mehr als Kulisse: Er prägt die Freizeit der ganzen
            Region, vom Reeds-Openair bis zu den Spuren der Pfahlbauer, die hier vor
            Tausenden von Jahren siedelten. Wer in Pfäffikon einen Betrieb führt, ist
            im Ort verwurzelt, und zugleich bestens angebunden.
          </p>
        </div>
      </article>
      <article class="lp-block" data-reveal>
        <h2>In Pfäffikon schon zuhause</h2>
        <div class="lp-text">
          <p>
            Die Website der RIPA Immobilien GmbH an der Pilatusstrasse? Von uns -
            inklusive Fotoshooting und Texten, die die Kompetenz der
            Immobilienverwaltung auf den Punkt bringen. Seither betreuen wir RIPA
            laufend: neue Liegenschaftsseiten, Stelleninserate, Verkaufskampagnen.
            Und auch die illustrierte Weihnachtskarte, mit der sich RIPA jedes Jahr
            bei ihrer Kundschaft bedankt, stammt aus unserer Feder.
          </p>
          <p>
            Und als Beat Brugger Anfang 2025 sein Beratungsunternehmen in Pfäffikon
            gründete, durften wir das komplette Erscheinungsbild entwickeln, vom Logo
            über die Visitenkarte bis zum Flyer. Kommunikation für Pfäffikon aus einer
            Hand. Weitere Arbeiten findest du in unseren
            <a href="/projekte/">Projekten</a>.
          </p>
        </div>
      </article>
      <article class="lp-block" data-reveal>
        <h2>Webseite erstellen lassen, ohne Umweg über die Stadt</h2>
        <div class="lp-text">
          <p>
            Wer in Pfäffikon eine Webseite erstellen lassen will, muss dafür nicht in
            die Stadt fahren. Was deine Homepage leisten muss, ist klar: Wer nach dir
            sucht, findet dich sofort, mit Leistungen, Öffnungszeiten und Kontakt auf
            einen Blick, auf dem Handy genauso wie am Computer. Und wer noch nicht nach
            dir sucht, soll dich über Google entdecken, egal ob jemand nach einem
            Elektrobetrieb in Pfäffikon oder einer Praxis am Pfäffikersee sucht. Denn
            eins ist sicher: Wer dich nicht findet, landet beim nächsten Betrieb in
            Wetzikon oder Uster.
          </p>
          <p>
            Ein Detail, das viele unterschätzen: Es gibt zwei Pfäffikon in der Schweiz -
            eines am Zürichsee, eines am Pfäffikersee. Damit Google deinen Betrieb dem
            richtigen zuordnet, braucht es saubere lokale Signale: klare Ortsangaben,
            eine saubere technische Struktur und ein gepflegtes
            <a href="/google-business-profile/">Google-Unternehmensprofil</a>. Diese
            SEO-Basis liefern wir bei jeder Website gleich mit.
          </p>
          <p>
            Uftritt ist dabei mehr als eine Webagentur: Als Werbeagentur decken wir ab,
            was über die Website hinausgeht, Logo und Erscheinungsbild, Printwerbung,
            Video und die laufende Betreuung deiner Kommunikation. Ein Partner für
            alles, statt fünf Ansprechpersonen für fünf Disziplinen. Und wir sagen es
            auch, wenn weniger genügt: Für manchen Betrieb am See ist ein gut gemachter
            Onepager die richtige Lösung, kein Grossprojekt.
          </p>
        </div>
      </article>
      <article class="lp-block" data-reveal>
        <h2>In vier Schritten zur neuen Website</h2>
        <div class="lp-text">
          <p>
            <strong>1. Erstgespräch bei dir.</strong> Kostenlos und unverbindlich, am
            liebsten bei dir im Betrieb in Pfäffikon, egal ob im Dorfkern, in Auslikon
            oder Irgenhausen. Auf Wunsch auch bei uns in Saland oder per Video-Call.
            Wir hören zu, fragen nach und beraten ehrlich.
          </p>
          <p>
            <strong>2. Konzept und Prototyp.</strong> Du bekommst früh einen klickbaren
            Entwurf zu sehen, Bilder, Farben und Struktur stehen, bevor eine Zeile
            Code geschrieben ist. So gibt es keine Überraschungen.
          </p>
          <p>
            <strong>3. Umsetzung.</strong> Wir bauen die Seite, schreiben auf Wunsch
            die Texte und organisieren die Fotografie, alles aus einer Hand, alles
            aus dem Zürcher Oberland.
          </p>
          <p>
            <strong>4. Launch und Betreuung.</strong> Nach dem Go-Live lassen wir dich
            nicht im Stich: <a href="/website-betreuung/">Betreuung und Wartung</a>,
            <a href="/seo-betreuung/">SEO-Begleitung</a> oder eine Schulung, damit du
            die Inhalte selbst pflegen kannst. Du hast schon eine ältere Website? Dann
            ist ein <a href="/website-relaunch/">Relaunch</a> der richtige Einstieg.
          </p>
        </div>
      </article>
      <article class="lp-block" data-reveal>
        <h2>Was kostet das?</h2>
        <div class="lp-text">
          <p>
            Die ehrliche Antwort: Es kommt darauf an, was du brauchst. Ein Onepager
            kostet weniger als eine Plattform mit Kundenlogin, wie wir sie für die
            RIPA Immobilien hier in Pfäffikon gebaut haben. Pauschalpreise von der
            Stange wären unseriös. Nach dem kostenlosen Erstgespräch erhältst du
            deshalb ein transparentes Angebot: alle Leistungen aufgelistet, ein
            klarer Preis.
          </p>
          <p>
            Zur Orientierung vorab: In unserem <a href="/website-kosten/">Guide zu
            Website-Kosten</a> zeigen wir echte Marktpreise in der Schweiz, damit du
            weisst, was eine Website kosten darf, bevor du mit uns oder einer anderen
            Agentur sprichst. Und weil Vertrauen gut ist, Kontrolle aber besser:
            Beratung, saubere Technik und die SEO-Basis sind bei jedem Projekt
            inklusive.
          </p>
        </div>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <header class="section-head" data-reveal>
        <span class="eyebrow">In deiner Nähe</span>
        <h2>Webdesign in deinem Ort</h2>
      </header>
      <div class="orte" data-reveal>
        {
          orte.map((o) => (
            <a class="ort-card" href={o.href}>
              <span class="ort-name">{o.name}</span>
              <span class="ort-note">{o.note}</span>
            </a>
          ))
        }
      </div>
      <p class="orte-note" data-reveal>
        Und natürlich auch in: {weitere.join(", ")}, kurzum: im ganzen Bezirk
        Pfäffikon und im umliegenden Oberland.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container faq-wrap">
      <header class="section-head" data-reveal>
        <span class="eyebrow">FAQ</span>
        <h2>Die wichtigsten Fragen, ehrlich beantwortet</h2>
      </header>
      <div class="faq" data-reveal>
        {
          faq.map((f, i) => (
            <details class="faq-item" name="faq" open={i === 0}>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <LocalTrust />

  <section class="section section--yellow">
    <div class="container lp-cta" data-reveal>
      <h2>Bereit für deinen neuen Webauftritt in Pfäffikon?</h2>
      <Button href="/kontakt/" variant="blue">Schriib eus</Button>
    </div>
  </section>

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faq.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    })}
  />
</Layout>

<style>
  .lp-blocks { display: flex; flex-direction: column; gap: clamp(2.5rem, 5vw, 4.5rem); }
  .lp-block { display: grid; grid-template-columns: 1fr 2fr; gap: clamp(1rem, 3vw, 3rem); align-items: start; }
  .lp-block h2 { position: sticky; top: 100px; }
  .lp-text p { color: var(--color-blue); font-size: 1.1rem; line-height: 1.7; margin-bottom: 1rem; }
  .lp-text a { color: var(--color-blue); text-decoration: underline; text-underline-offset: 0.15em; }

  .orte { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(0.75rem, 2vw, 1.5rem); }
  .ort-card {
    display: flex; flex-direction: column; gap: 0.3rem;
    background: #fff; border: 1px solid #e7ecf3; padding: clamp(1.25rem, 2.5vw, 1.75rem);
    transition: border-color 0.3s var(--ease), transform 0.3s var(--ease);
  }
  .ort-card:hover { border-color: var(--color-blue); transform: translateY(-2px); }
  .ort-name { font-weight: 700; font-size: 1.25rem; color: var(--color-blue); }
  .ort-note { color: var(--color-blue); opacity: 0.8; font-size: 0.95rem; }
  .orte-note { margin-top: 1.5rem; color: var(--color-blue); line-height: 1.7; max-width: 75ch; }

  .faq-wrap { max-width: 860px; }
  .faq-item { border-bottom: 1px solid rgba(1, 64, 128, 0.2); }
  .faq-item summary {
    cursor: var(--cur-hand); list-style: none; padding: 1.1rem 0;
    font-weight: 700; color: var(--color-blue); font-size: 1.15rem;
    display: flex; justify-content: space-between; gap: 1rem;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: "+"; display: inline-flex; align-items: center; justify-content: center; width: 1em; height: 1em; line-height: 1; transform-origin: center; font-weight: 700; transition: transform 0.3s var(--ease); }
  .faq-item[open] summary::after { transform: rotate(45deg); }
  .faq-item p { color: var(--color-blue); line-height: 1.7; padding-bottom: 1.1rem; max-width: 70ch; }
  .lp-cta { display: flex; flex-direction: column; align-items: flex-start; gap: 1.25rem; }

  @media (max-width: 900px) {
    .orte { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 760px) {
    .lp-block { grid-template-columns: 1fr; }
    .lp-block h2 { position: static; }
  }
  @media (max-width: 520px) {
    .orte { grid-template-columns: 1fr; }
  }
</style>
