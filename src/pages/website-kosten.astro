---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Button from "../components/Button.astro";
import LocalTrust from "../components/LocalTrust.astro";
import OfferLink from "../components/OfferLink.astro";
import { projects } from "../data/projects";

const cases = projects.filter((p) =>
  ["physio-rothe", "it-stall", "aweso", "cynterim", "emotion-hinwil", "garage-frei"].includes(p.slug)
);

const ranges = [
  {
    name: "Einfache Website / Onepager",
    price: "CHF 3000 bis 5000",
    note: "Eine Seite, klarer Inhalt, Kontaktmöglichkeit. Mit Konzept, eigenem Design und Prototyp von einer Agentur statt einer Vorlage von der Stange.",
  },
  {
    name: "KMU-Website",
    price: "CHF 5000 bis 15 000",
    note: "Mehrere Seiten, individuelles Design, Kontaktformular, Suchmaschinen-Basis. Die typische Firmenwebsite für einen Betrieb aus der Region. Funktionen und Inhalte entscheiden, wo du in dieser Range landest.",
  },
  {
    name: "Webshop / E-Commerce",
    price: "CHF 10 000 bis 50 000",
    note: "Zahlungen, Produktdaten, Versand und Steuern machen Shops aufwendig. Sehr grosse Lösungen gehen auch darüber hinaus.",
  },
  {
    name: "Web-Applikation / Plattform",
    price: "CHF 15 000 bis 120 000",
    note: "Mitgliederbereiche, Schnittstellen, individuelle Funktionen: Hier wird sauber gerechnet statt pauschal versprochen.",
  },
];

const laufend = [
  { name: "Hosting", value: "ca. CHF 15 bis 30 pro Monat (CHF 180 bis 360 pro Jahr)" },
  { name: "Domain (.ch)", value: "ca. CHF 15 bis 25 pro Jahr" },
  { name: "SSL-Zertifikat", value: "heute Standard, meist inklusive" },
  { name: "Wartung, Updates, Schulung", value: "jährlich einbudgetieren, in keiner Offerte der Erstellung inklusive" },
];

const faq = [
  {
    q: "Was kostet eine einfache Website in der Schweiz?",
    a: "Mit einer Vorlage und viel Eigenarbeit geht es auch günstiger, das Ergebnis ist dann aber kein Unikat und selten für Google gebaut. Professionell gemacht, mit Konzept, individuellem Design, sauberen Texten und Suchmaschinen-Grundlagen, kostet eine einseitige Website bei einer Agentur zwischen CHF 3000 und 5000.",
  },
  {
    q: "Was kostet eine Website mit Shop?",
    a: "Ein Webshop startet bei ungefähr CHF 10 000, aufwendige Lösungen gehen Richtung CHF 50 000. Der Preis entsteht durch Zahlungsanbindung, Produktdaten, Versandlogik und Steuern, nicht durch die Seitenzahl.",
  },
  {
    q: "Warum zeigt ihr keine Preise auf eurer Website?",
    a: "Weil jedes Projekt anders ist. Ein Listenpreis wäre für das eine Projekt zu hoch, für das andere zu tief, und für beide unehrlich. Übrigens: Keine der führenden Schweizer Agenturen nennt Preise auf ihrer Website. Bei uns bekommst du nach einem kostenlosen Erstgespräch ein transparentes Angebot mit allen Leistungen und einem klaren Preis. Zwei Ausnahmen gibt es, weil sie fix sind: unsere Website-Betreuung mit Hosting, Wartung und Updates für CHF 33 pro Monat und unsere klar umrissenen Pakete für Startups und Corporate Design.",
  },
  {
    q: "Was kostet eine Website pro Jahr?",
    a: "Rechne mit CHF 200 bis 400 pro Jahr für Hosting und Domain. Dazu kommt Wartung: Updates, Backups und kleine Anpassungen. Bei Baukasten-Abos (Wix, Squarespace und Co.) zahlst du je nach Plan CHF 70 bis 500 pro Jahr, dafür ist deine Arbeitszeit der grösste Posten.",
  },
  {
    q: "Ist ein Baukasten nicht viel günstiger?",
    a: "Beim Preis ja, und für manche Vorhaben ist das die richtige Wahl. Der Unterschied steckt in deiner Arbeitszeit, der Auffindbarkeit bei Google und der Frage, ob die Website nach dir aussieht oder nach Template. Vorsicht bei Gratis-Angeboten: Da hängen Werbung, Subdomain und ein Datenumzug dran, der beim Anbieterwechsel teuer wird.",
  },
  {
    q: "Gibt es bei euch versteckte Kosten?",
    a: "Nein. Unser Angebot listet alle Leistungen und den Preis dafür. Was nicht drinsteht, wird nicht extra verrechnet. Änderungswünsche ausserhalb des Umfangs besprechen wir vorher, nie hinterher auf der Rechnung.",
  },
];
---

<Layout
  title="Was kostet eine Website in der Schweiz? - Uftritt"
  description="Was kostet eine Website? Ehrliche Preisranges für die Schweiz: Onepager, KMU-Website, Webshop, laufende Kosten und Preistreiber. Ohne Listenpreis-Getue."
>
  <PageHero
    eyebrow="Website-Kosten · Schweiz"
    title={"Was kostet\neine Website?"}
    lead="Die ehrliche Antwort vorweg: Eine professionelle Website von einer Agentur kostet in der Schweiz CHF 3000 bis 5000 als Onepager, CHF 5000 bis 15 000 als KMU-Website und CHF 10 000 bis 50 000 als Webshop. Günstiger geht es mit Vorlagen und Eigenarbeit, dann steckt aber weder Strategie noch eigenes Design drin."
    lottie="/lottie/webdesign.json"
    lottieLabel="Website-Kosten"
  >
    <div slot="hero-extra" class="hero-ctas">
      <Button href="/kontakt/" variant="blue">Kostenloses Erstgespräch</Button>
      <Button href="/projekte/" variant="text">Projekte ansehen</Button>
    </div>
  </PageHero>

  <OfferLink href="/angebot/webdesign/" label="Webdesign und Entwicklung" lottie="/lottie/webdesign.json" projects={cases} />

  {/* Antwort-Block: Preisranges */}
  <section class="section">
    <div class="container">
      <header class="section-head" data-reveal>
        <span class="eyebrow">Marktüberblick</span>
        <h2>Die Preisranges im Überblick</h2>
      </header>
      <div class="ranges" data-reveal>
        {
          ranges.map((r) => (
            <article class="range-card">
              <h3>{r.name}</h3>
              <p class="range-price">{r.price}</p>
              <p class="range-note">{r.note}</p>
            </article>
          ))
        }
      </div>
      <p class="quellen" data-reveal>
        Richtwerte aus unserer Projekterfahrung. Jede Website ist individuell,
        darum sind das Ranges und keine Ladenpreise.
      </p>
    </div>
  </section>

  {/* Preistreiber + laufende Kosten */}
  <section class="section section--soft">
    <div class="container lp-blocks">
      <article class="lp-block" data-reveal>
        <h2>Was den Preis wirklich treibt</h2>
        <div class="lp-text">
          <p>
            Funktionsumfang schlägt Seitenzahl: Shop, Zahlungsintegration, Mitgliederbereich
            oder Schnittstellen machen aus einem CHF-3000-Projekt schnell ein
            fünfstelliges. Jede Zusatzfunktion hat ihren Preis.
          </p>
          <p>
            Der zweite grosse Posten sind Inhalte: individuelles Design, Texte, Fotos und
            Grafiken kosten oft mehr als die Technik dahinter. Und zwei unterschätzte
            Treiber in der Schweiz: Mehrsprachigkeit und Abstimmungsschlaufen, je mehr
            Entscheider am Tisch, desto mehr Stunden.
          </p>
          <p>
            Zum Einordnen: Freelance-Webdesigner in der Schweiz rechnen ab ca. CHF 130
            pro Stunde.
          </p>
        </div>
      </article>
      <article class="lp-block" data-reveal>
        <h2>Laufende Kosten, an die niemand denkt</h2>
        <div class="lp-text">
          <p>
            Der Kaufpreis ist nicht die Gesamtrechnung. Diese Posten kommen jedes Jahr
            dazu, egal wer die Website gebaut hat:
          </p>
          <ul class="kosten-liste">
            {
              laufend.map((l) => (
                <li>
                  <strong>{l.name}</strong>
                  <span>{l.value}</span>
                </li>
              ))
            }
          </ul>
          <p class="abo-hinweis" data-reveal>
            <strong>Und bei uns fix:</strong> Hosting, Wartung, tägliche Backups und
            alle Updates für CHF 33 pro Monat, ohne Kleingedrucktes.
          </p>
        </div>
      </article>
    </div>
  </section>

  {/* Baukasten vs. Agentur */}
  <section class="section">
    <div class="container lp-blocks">
      <article class="lp-block" data-reveal>
        <h2>Baukasten oder Agentur?</h2>
        <div class="lp-text">
          <p>
            Baukästen wie Hostpoint Sites, Webador oder Wix kosten CHF 6 bis 40 pro
            Monat. Ehrlich gesagt: Für den Vereinsanlass oder die erste Idee reicht das.
            Du zahlst dann nicht mit Geld, sondern mit deiner Zeit, und die Website sieht
            aus wie viele andere.
          </p>
          <p>
            Günstige Anbieter sparen genau an diesen Ecken: Sie nehmen eine Vorlage,
            kopieren Seiten und liefern kein Unikat, sondern eine Website, die es so
            schon hundertfach gibt. Eine Agentur lohnt sich, wenn die Website Kunden
            bringen soll: bei Google in deiner Region gefunden werden, ein Design, das
            zu dir passt und niemand sonst hat, und jemand, der sich nach dem Launch
            weiter kümmert.
          </p>
        </div>
      </article>
      <article class="lp-block" data-reveal>
        <h2>Warum seriöse Agenturen keine Listenpreise nennen</h2>
        <div class="lp-text">
          <p>
            Weil es sie nicht gibt. Kein seriöses Projekt gleicht dem anderen, darum
            nennt auch keine führende Schweizer Agentur Preise auf ihrer Website. Ein
            Listenpreis wäre für das einfache Projekt zu hoch und für das anspruchsvolle
            zu tief kalkuliert. Für beide Seiten unehrlich.
          </p>
          <p>
            Vorsicht ist bei Lockangeboten geboten: Der K-Tipp dokumentierte den Fall
            einer «300-Franken-Website», die am Ende in einem Rechtsstreit um CHF 20 000
            mündete. Billigste Offerten holen sich ihren Preis über Zusatzposten zurück.
          </p>
          <p>
            Darum arbeiten wir so: kostenloses Erstgespräch, danach ein transparentes
            Angebot mit allen Leistungen und einem klaren Preis. Bei uns steckt von
            Anfang an viel Arbeit drin: individuelles Konzept, eigenes Design und früh
            ein klickbarer Prototyp, damit du siehst, was du bekommst, bevor du dich
            entscheidest. Keine versteckten Kosten, keine Überraschungen.
          </p>
        </div>
      </article>
    </div>
  </section>

  {/* FAQ */}
  <section class="section">
    <div class="container faq-wrap">
      <header class="section-head" data-reveal>
        <span class="eyebrow">FAQ</span>
        <h2>Häufige Fragen zu Website-Kosten</h2>
      </header>
      <div class="faq" data-reveal>
        {
          faq.map((f, i) => (
            <details class="faq-item" name="faq" open={i === 0}>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <LocalTrust />

  <section class="section section--yellow">
    <div class="container lp-cta" data-reveal>
      <h2>Willst du wissen, was deine Website kostet?</h2>
      <p class="lp-cta-text">
        Erzähl uns von deinem Vorhaben. Du bekommst ein ehrliches, transparentes
        Angebot, kostenlos und unverbindlich.
      </p>
      <Button href="/kontakt/" variant="blue">Schriib eus</Button>
    </div>
  </section>

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faq.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    })}
  />
</Layout>

<style>
  .ranges { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(0.75rem, 2vw, 1.5rem); }
  .range-card {
    display: flex; flex-direction: column; gap: 0.5rem;
    background: #fff; border: 1px solid #e7ecf3; padding: clamp(1.25rem, 2.5vw, 1.75rem);
  }
  .range-card h3 { color: var(--color-blue); font-size: 1.15rem; }
  .range-price { font-weight: 700; font-size: 1.35rem; color: var(--color-pink); margin: 0; }
  .range-note { color: var(--color-blue); opacity: 0.85; font-size: 0.95rem; line-height: 1.6; margin: 0; }
  .quellen { margin-top: 1.5rem; color: var(--color-blue); opacity: 0.75; font-size: 0.9rem; line-height: 1.6; max-width: 75ch; }

  .lp-blocks { display: flex; flex-direction: column; gap: clamp(2.5rem, 5vw, 4.5rem); }
  .lp-block { display: grid; grid-template-columns: 1fr 2fr; gap: clamp(1rem, 3vw, 3rem); align-items: start; }
  .lp-block h2 { position: sticky; top: 100px; }
  .lp-text p { color: var(--color-blue); font-size: 1.1rem; line-height: 1.7; margin-bottom: 1rem; }
  .kosten-liste { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .kosten-liste li {
    display: flex; flex-direction: column; gap: 0.15rem;
    padding: 0.9rem 0; border-bottom: 1px solid rgba(1, 64, 128, 0.15);
    color: var(--color-blue); font-size: 1.05rem;
  }
  .kosten-liste li:last-child { border-bottom: 0; }
  .kosten-liste span { opacity: 0.85; }
  .abo-hinweis {
    margin-top: 1.25rem; padding: 1rem 1.25rem;
    border-left: 4px solid var(--color-yellow);
    background: #fff; color: var(--color-blue);
    font-size: 1.05rem !important; line-height: 1.6;
  }

  .faq-wrap { max-width: 860px; }
  .faq-item { border-bottom: 1px solid rgba(1, 64, 128, 0.2); }
  .faq-item summary {
    cursor: var(--cur-hand); list-style: none; padding: 1.1rem 0;
    font-weight: 700; color: var(--color-blue); font-size: 1.15rem;
    display: flex; justify-content: space-between; gap: 1rem;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: "+"; display: inline-flex; align-items: center; justify-content: center; width: 1em; height: 1em; line-height: 1; transform-origin: center; font-weight: 700; transition: transform 0.3s var(--ease); }
  .faq-item[open] summary::after { transform: rotate(45deg); }
  .faq-item p { color: var(--color-blue); line-height: 1.7; padding-bottom: 1.1rem; max-width: 70ch; }
  .lp-cta { display: flex; flex-direction: column; align-items: flex-start; gap: 1.25rem; }
  .lp-cta-text { color: var(--color-blue); font-size: 1.1rem; line-height: 1.7; max-width: 60ch; margin: 0; }

  @media (max-width: 900px) {
    .ranges { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 760px) {
    .lp-block { grid-template-columns: 1fr; }
    .lp-block h2 { position: static; }
  }
  @media (max-width: 520px) {
    .ranges { grid-template-columns: 1fr; }
  }
</style>
