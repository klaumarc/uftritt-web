---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Button from "../components/Button.astro";
import LocalTrust from "../components/LocalTrust.astro";
import OfferLink from "../components/OfferLink.astro";
import { projects } from "../data/projects";

const cases = projects.filter((p) =>
  ["physio-rothe", "it-stall", "aweso", "cynterim"].includes(p.slug)
);

const orte = [
  { name: "Wetzikon", href: "/webdesign-wetzikon/", note: "zweitgrösste Stadt der Region" },
  { name: "Hinwil", href: "/webdesign-hinwil/", note: "Bezirkshauptort am Bachtel" },
  { name: "Bauma", href: "/webdesign-bauma/", note: "unser Heimdorf im Tösstal" },
  { name: "Saland", href: "/webdesign-saland/", note: "hier sind wir zuhause" },
  { name: "Rüti", href: "/webdesign-rueti/", note: "Bahnknoten der Region" },
  { name: "Bäretswil", href: "/webdesign-baeretswil/", note: "zwischen Glatt- und Tösstal" },
  { name: "Pfäffikon", href: "/webdesign-pfaeffikon/", note: "am Pfäffikersee" },
  { name: "Uster", href: "/webdesign-uster/", note: "Stadt am Greifensee" },
  { name: "Wald", href: "/webdesign-wald/", note: "Gewerbeort im Jonatal" },
  { name: "Dürnten", href: "/webdesign-duernten/", note: "im Tössbergland" },
  { name: "Tösstal", href: "/webdesign-toesstal/", note: "unsere Heimregion" },
  { name: "Winterthur", href: "/webdesign-winterthur/", note: "Stadt am Töss-Ausgang" },
];

const weitere = [
  "Bubikon", "Fehraltorf", "Fischenthal", "Gossau", "Grüningen", "Russikon", "Wila", "Wildberg",
];

const faq = [
  { q: "Was kostet eine Website für einen Betrieb im Zürcher Oberland?", a: "Ehrlich: Das hängt vom Umfang ab, vom schlanken Onepager bis zur mehrseitigen Plattform mit Shop oder Mitgliederbereich. Wir arbeiten nicht mit Pauschalen von der Stange: Nach einem kostenlosen Erstgespräch erhältst du ein transparentes Angebot mit allen Leistungen und einem klaren Preis. Keine versteckten Kosten, keine Überraschungen." },
  { q: "Kommst du auch zu uns ins Geschäft?", a: "Gerne, genau das ist der Vorteil der kurzen Wege. Unser Büro ist in Saland, mitten im Zürcher Oberland, und wir sind in wenigen Minuten bei dir, egal ob in Wetzikon, Hinwil, Bauma, Rüti oder anderswo in der Region. Auf Wunsch auch per Video-Call." },
  { q: "Lohnt sich eine eigene Website auch für ein kleines Gewerbe?", a: "Ja. Gerade im Oberland googeln Kundinnen und Kunden zuerst, eine klare, schnelle Website mit Öffnungszeiten, Leistungen und Kontakt wirkt rund um die Uhr, auch wenn dein Geschäft geschlossen ist. Wir sagen dir ehrlich, was sich für deine Grösse lohnt, und was nicht." },
  { q: "Werde ich mit meinem Betrieb im Zürcher Oberland überhaupt gefunden?", a: "Mit einer Website allein ist es nicht getan, aber fast: Wir liefern jede Seite mit sauberer SEO-Basis aus, von der Struktur über die Ladezeiten bis zu den Meta-Texten. Dazu gehört ein gepflegtes Google-Unternehmensprofil, damit wirst du auf der Karte und in der ganzen Region gefunden, etwa wenn jemand «Elektriker Hinwil» oder «Coiffeur Wetzikon» sucht." },
  { q: "Wir haben schon eine Website, lohnt sich ein Relaunch?", a: "Oft ja: Wenn die Seite älter als vier, fünf Jahre ist, auf dem Handy hakt oder bei Google abrutscht, bringt ein Neubau mehr als Flickwerk. Wir schauen uns deine Seite kostenlos an und sagen dir ehrlich, ob sich ein Relaunch lohnt, oder ob ein paar gezielte Anpassungen genügen." },
  { q: "Wie lange dauert ein Website-Projekt?", a: "Je nach Umfang 4 bis 12 Wochen. Du bekommst früh einen klickbaren Prototypen zu sehen, und wir halten dich durchgehend auf dem Laufenden." },
  { q: "Kann ich die Website danach selbst pflegen?", a: "Klar. Wir zeigen dir, wie du Texte und Bilder selbst anpasst, oder wir übernehmen Pflege, Updates und Backups im Rahmen einer laufenden Betreuung für dich." },
];
---

<Layout
  title="Webdesign Zürcher Oberland | Websites für KMU, Uftritt"
  description="Webseite erstellen lassen im Zürcher Oberland: individuelle Websites für KMU aus Wetzikon, Uster und Hinwil, persönlich, ohne Template. Erstgespräch gratis."
>
  <PageHero
    eyebrow="Webdesign · Zürcher Oberland"
    title={"Webdesign im\nZürcher Oberland"}
    lead="Du suchst Webdesign im Zürcher Oberland? Uftritt ist die Kommunikationsagentur aus Saland, mitten in der Region. Wir entwickeln Websites für KMU aus Wetzikon, Hinwil, Bauma, Rüti und Umgebung: persönlich, ehrlich und ohne Template. Vom Onepager bis zur Web-App, mit klickbarem Prototyp und Betreuung nach dem Launch."
    lottie="/lottie/webdesign.json"
    lottieLabel="Webdesign"
  >
    <div slot="hero-extra" class="hero-ctas">
      <Button href="/kontakt/" variant="blue">Kostenloses Erstgespräch</Button>
      <Button href="/projekte/" variant="text">Projekte ansehen</Button>
    </div>
  </PageHero>

  <OfferLink href="/angebot/webdesign/" label="Webdesign und Entwicklung" lottie="/lottie/webdesign.json" projects={cases} />

  {/* Antwort-Block + regionale Verankerung */}
  <section class="section">
    <div class="container lp-blocks">
      <article class="lp-block" data-reveal>
        <h2>Aus der Region, für die Region</h2>
        <div class="lp-text">
          <p>
            Das Zürcher Oberland, das ist die Region östlich von Zürich: vom Greifensee
            und Pfäffikersee über Uster und Wetzikon bis hinauf ins Tösstal und aufs
            Tössbergland mit dem Bachtel. Wo früher Spinnereien und Webereien entlang
            von Töss, Jona und Aabach das Land prägten, arbeiten heute Hightech-Firmen,
            Maschinenbauer und ein dichtes Netz aus Gewerbe, Handwerk und Dienstleistern.
            Und mit der S-Bahn ist Uster in einer Viertelstunde in Zürich, trotzdem
            tickt das Oberland eigenständig.
          </p>
          <p>
            Mitten drin sind wir zuhause: Unser Büro ist in Saland, an der Frauwisstrasse 9.
            Für dich heisst das kurze Wege, ein Gegenüber, das die Region aus dem Alltag
            kennt, und Termine, die auch mal spontan bei dir im Geschäft stattfinden -
            egal ob in Wetzikon, Hinwil, Rüti oder Bauma.
          </p>
          <p>
            Entsprechend gut kennen wir die Betriebe hier: Für die Aweso AG in Wetzikon
            steuern wir die gesamte Kommunikation, für die Physio &amp; Sportreha Rothe
            in Bauma haben wir die Website samt Fotografie gebaut, und auch die Websites
            von Cynterim aus Hinwil und des Salander IT-Dienstleisters it-stall stammen
            von uns. Und weil das Vereinsleben hier stark ist, von der Dampfbahn
            zwischen Bauma und Hinwil bis zu den Gewerbevereinen, bauen wir Websites
            auch für Vereine, Anlässe und gemeinnützige Organisationen.
          </p>
        </div>
      </article>
      <article class="lp-block" data-reveal>
        <h2>Deine Website, die gefunden wird</h2>
        <div class="lp-text">
          <p>
            Eine schöne Website allein reicht nicht, sie muss auch gefunden werden, wenn
            jemand aus der Region nach deiner Leistung sucht. Darum bauen wir jede Seite
            von Anfang an suchmaschinenfreundlich: saubere Technik, schnelle Ladezeiten
            und Inhalte, die deine Kundinnen und Kunden wirklich interessieren.
          </p>
          <p>
            Dazu gehört die lokale Sichtbarkeit: Auf Wunsch richten wir dein
            <a href="/google-business-profile/">Google-Unternehmensprofil</a> ein und
            zeigen dir, wie du es pflegst, damit du auf der Karte erscheinst, wenn
            jemand in deiner Nähe sucht.
          </p>
          <p>
            Und weil wir auch Grafikdesign, Text und Video selbst machen, kommt alles
            aus einer Hand, ohne Schnittstellenchaos.
          </p>
        </div>
      </article>
      <article class="lp-block" data-reveal>
        <h2>Webseite erstellen lassen, was deine Website leisten muss</h2>
        <div class="lp-text">
          <p>
            Wer im Zürcher Oberland eine Webseite erstellen lässt, braucht mehr als ein
            hübsches Design. Deine Homepage muss auf dem Handy genauso funktionieren wie
            am Computer, Leistungen, Öffnungszeiten und Kontakt auf den ersten Blick
            zeigen und Vertrauen schaffen, bevor jemand überhaupt anruft. Genau dafür
            bauen wir: klar strukturiert, schnell und ohne Template-Look.
          </p>
          <p>
            Uftritt ist dabei mehr als eine Webagentur: Als Werbeagentur decken wir ab,
            was darüber hinausgeht, Logo und Erscheinungsbild, Printwerbung, Video und
            die laufende Betreuung deiner Kommunikation. Ein Partner für alles, statt
            fünf Ansprechpersonen für fünf Disziplinen.
          </p>
          <p>
            Und wir sagen es auch, wenn weniger genügt: Für viele Betriebe in der Region
            ist ein gut gemachter Onepager die richtige Lösung, kein Grossprojekt.
          </p>
        </div>
      </article>
      <article class="lp-block" data-reveal>
        <h2>In vier Schritten zur neuen Website</h2>
        <div class="lp-text">
          <p>
            <strong>1. Erstgespräch bei dir.</strong> Kostenlos und unverbindlich, am
            liebsten bei dir im Betrieb, egal wo im Zürcher Oberland, auf Wunsch auch
            bei uns in Saland oder per Video-Call. Wir hören zu, fragen nach und beraten
            ehrlich.
          </p>
          <p>
            <strong>2. Konzept und Prototyp.</strong> Du bekommst früh einen klickbaren
            Entwurf zu sehen, nicht erst am Ende. So gibt es keine Überraschungen.
          </p>
          <p>
            <strong>3. Umsetzung.</strong> Wir bauen die Seite, schreiben auf Wunsch die
            Texte und organisieren Fotografie, alles aus einer Hand.
          </p>
          <p>
            <strong>4. Launch und Betreuung.</strong> Nach dem Go-Live lassen wir dich
            nicht im Stich: <a href="/website-betreuung/">Betreuung und Wartung</a>,
            <a href="/seo-betreuung/">SEO-Begleitung</a> oder Schulung, damit du die
            Seite selbst pflegen kannst. Du hast schon eine ältere Website? Dann ist ein
            <a href="/website-relaunch/">Relaunch</a> der richtige Einstieg.
          </p>
        </div>
      </article>
      <article class="lp-block" data-reveal>
        <h2>Was kostet das?</h2>
        <div class="lp-text">
          <p>
            Die ehrliche Antwort: Es kommt darauf an, was du brauchst, ein Onepager
            kostet weniger als eine Plattform mit Shop. Was den Preis treibt, sind
            Umfang, Funktionen und Inhalte, und genau das besprechen wir vorab Zeile
            für Zeile. Pauschalpreise von der Stange wären unseriös. Nach dem
            kostenlosen Erstgespräch erhältst du ein transparentes Angebot mit allen
            Leistungen und einem klaren Preis.
          </p>
          <p>
            Zur Orientierung vorab: In unserem <a href="/website-kosten/">Guide zu
            Website-Kosten</a> zeigen wir echte Marktpreise in der Schweiz, damit du
            weisst, was eine Website kosten darf, bevor du mit uns oder einer anderen
            Agentur sprichst.
          </p>
        </div>
      </article>
    </div>
  </section>

  {/* Orts-Seiten + Abdeckung */}
  <section class="section section--soft">
    <div class="container">
      <header class="section-head" data-reveal>
        <span class="eyebrow">In deiner Nähe</span>
        <h2>Webdesign in deinem Ort</h2>
      </header>
      <div class="orte" data-reveal>
        {
          orte.map((o) => (
            <a class="ort-card" href={o.href}>
              <span class="ort-name">{o.name}</span>
              <span class="ort-note">{o.note}</span>
            </a>
          ))
        }
      </div>
      <p class="orte-note" data-reveal>
        Und natürlich auch in: {weitere.join(", ")}, kurzum: im ganzen Zürcher Oberland.
      </p>
    </div>
  </section>

  {/* FAQ */}
  <section class="section">
    <div class="container faq-wrap">
      <header class="section-head" data-reveal>
        <span class="eyebrow">FAQ</span>
        <h2>Die wichtigsten Fragen, ehrlich beantwortet</h2>
      </header>
      <div class="faq" data-reveal>
        {
          faq.map((f, i) => (
            <details class="faq-item" name="faq" open={i === 0}>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <LocalTrust />

  <section class="section section--yellow">
    <div class="container lp-cta" data-reveal>
      <h2>Bereit für deinen neuen Webauftritt im Zürcher Oberland?</h2>
      <Button href="/kontakt/" variant="blue">Schriib eus</Button>
    </div>
  </section>

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faq.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    })}
  />
</Layout>

<style>
  .lp-blocks { display: flex; flex-direction: column; gap: clamp(2.5rem, 5vw, 4.5rem); }
  .lp-block { display: grid; grid-template-columns: 1fr 2fr; gap: clamp(1rem, 3vw, 3rem); align-items: start; }
  .lp-block h2 { position: sticky; top: 100px; }
  .lp-text p { color: var(--color-blue); font-size: 1.1rem; line-height: 1.7; margin-bottom: 1rem; }
  .lp-text a { color: var(--color-blue); text-decoration: underline; text-underline-offset: 0.15em; }

  .orte { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(0.75rem, 2vw, 1.5rem); }
  .ort-card {
    display: flex; flex-direction: column; gap: 0.3rem;
    background: #fff; border: 1px solid #e7ecf3; padding: clamp(1.25rem, 2.5vw, 1.75rem);
    transition: border-color 0.3s var(--ease), transform 0.3s var(--ease);
  }
  .ort-card:hover { border-color: var(--color-blue); transform: translateY(-2px); }
  .ort-name { font-weight: 700; font-size: 1.25rem; color: var(--color-blue); }
  .ort-note { color: var(--color-blue); opacity: 0.8; font-size: 0.95rem; }
  .orte-note { margin-top: 1.5rem; color: var(--color-blue); line-height: 1.7; max-width: 75ch; }

  .faq-wrap { max-width: 860px; }
  .faq-item { border-bottom: 1px solid rgba(1, 64, 128, 0.2); }
  .faq-item summary {
    cursor: var(--cur-hand); list-style: none; padding: 1.1rem 0;
    font-weight: 700; color: var(--color-blue); font-size: 1.15rem;
    display: flex; justify-content: space-between; gap: 1rem;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: "+"; display: inline-flex; align-items: center; justify-content: center; width: 1em; height: 1em; line-height: 1; transform-origin: center; font-weight: 700; transition: transform 0.3s var(--ease); }
  .faq-item[open] summary::after { transform: rotate(45deg); }
  .faq-item p { color: var(--color-blue); line-height: 1.7; padding-bottom: 1.1rem; max-width: 70ch; }
  .lp-cta { display: flex; flex-direction: column; align-items: flex-start; gap: 1.25rem; }

  @media (max-width: 900px) {
    .orte { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 760px) {
    .lp-block { grid-template-columns: 1fr; }
    .lp-block h2 { position: static; }
  }
  @media (max-width: 520px) {
    .orte { grid-template-columns: 1fr; }
  }
</style>
