{/* Rotator-CSS global: Die Woerter werden per JS eingesetzt (saubere H1 fuer
    Crawler) und tragen deshalb keine Astro-Scoped-Attribute. */}
<style is:global>
  .rotator {
    /* alle Wörter liegen in derselben Grid-Zelle -> Breite = längstes Wort,
       kein Springen des Layouts beim Wechsel */
    display: inline-grid;
    vertical-align: top;
    color: var(--color-blue);
  }
  .rotator-word {
    grid-area: 1 / 1;
    opacity: 0;
    /* Ausblenden des ablösenden Wortes */
    transition: opacity 0.4s var(--ease), transform 0.4s var(--ease);
    pointer-events: none;
    transform-origin: left center;
    will-change: transform, opacity, filter;
  }
  /* Wort, das gerade verschwindet: kurz nach oben ausgleiten */
  .rotator-word.is-leaving {
    opacity: 0;
    transform: translateY(-0.28em);
    filter: blur(2px);
  }

  /* Jedes Wort bekommt einen zur Bedeutung passenden Einblende-Effekt.
     animation-fill-mode: both hält Anfangs- und Endzustand sauber. */
  .rotator-word.is-active { opacity: 1; }

  /* wirkungsvoll, Farbwechsel Blau -> Pink -> Blau als kurzer Akzent */
  .rotator-word.fx-impact.is-active {
    animation: fx-impact 2.4s ease-in-out both;
  }
  @keyframes fx-impact {
    0%   { opacity: 0; color: var(--color-blue); }
    12%  { opacity: 1; color: var(--color-blue); }
    35%  { color: var(--color-pink); }
    70%  { color: var(--color-pink); }
    100% { opacity: 1; color: var(--color-blue); }
  }

  /* glaubwürdig, ruhig, weich, unaufgeregt scharfstellen */
  .rotator-word.fx-calm.is-active {
    animation: fx-calm 0.95s var(--ease) both;
  }
  @keyframes fx-calm {
    0%   { opacity: 0; filter: blur(8px); transform: translateY(0.12em); }
    100% { opacity: 1; filter: blur(0); transform: none; }
  }

  /* dynamisch, energiegeladen von links reinschiessen, leicht geschert */
  .rotator-word.fx-dynamic.is-active {
    animation: fx-dynamic 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  @keyframes fx-dynamic {
    0%   { opacity: 0; transform: translateX(-0.7em) skewX(14deg); }
    55%  { opacity: 1; transform: translateX(0.12em) skewX(-4deg); }
    100% { opacity: 1; transform: none; }
  }

  /* schlagkräftig, harter Schlag mit Nachbeben */
  .rotator-word.fx-punch.is-active {
    animation: fx-punch 0.62s cubic-bezier(0.3, 0.8, 0.3, 1) both;
  }
  @keyframes fx-punch {
    0%   { opacity: 0; transform: scale(1.25) translateX(0); }
    18%  { opacity: 1; transform: scale(1) translateX(-8px); }
    34%  { transform: translateX(6px); }
    50%  { transform: translateX(-4px); }
    66%  { transform: translateX(3px); }
    82%  { transform: translateX(-2px); }
    100% { opacity: 1; transform: translateX(0); }
  }

  /* konstant, gleichmässig, ruhig, ohne Schnörkel */
  .rotator-word.fx-constant.is-active {
    animation: fx-constant 0.8s linear both;
  }
  @keyframes fx-constant {
    0%   { opacity: 0; }
    100% { opacity: 1; }
  }

  /* Bewegung reduzieren: alle Effekte auf einen ruhigen Fade zurückführen */
  @media (prefers-reduced-motion: reduce) {
    .rotator-word.is-active { animation: fx-constant 0.3s linear both; }
    .rotator-word.is-leaving { transform: none; filter: none; }
  }
</style>
