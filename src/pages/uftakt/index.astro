---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import Button from "../../components/Button.astro";
import Reviews from "../../components/Reviews.astro";
import RefStrip from "../../components/RefStrip.astro";
import ProcessSteps from "../../components/ProcessSteps.astro";
import { projects } from "../../data/projects";

const ablaufSchritte = [
  {
    t: "Erstgespräch",
    d: "Kostenlos und unverbindlich. Wir klären, was du brauchst, und machen dir ein Angebot.",
  },
  {
    t: "Rechnung und Inhalte",
    d: "Das Paket startet mit Vorauszahlung. Du schickst uns Stichworte zu deinen Texten und lädst dein Bildmaterial direkt hoch.",
  },
  {
    t: "Wir bauen",
    d: "Sobald die Zahlung da ist und die Inhalte vollständig sind, starten wir. Du bekommst 3 Logo-Varianten zur Auswahl und eine fertige Webseite.",
  },
  {
    t: "Unterhalt per Mail",
    d: "Eine Mail genügt, wir passen an. 2 Stunden pro Jahr sind im Abo inklusive.",
  },
];

const logoPunkte = [
  "3 ausgearbeitete Varianten zur Auswahl",
  "Sauber reingezeichnet, für Web und Druck",
  "Alle Dateiformate mit Quer- und Hochformat in dunkler und heller Version",
];

const logos = [
  { name: "Felix Kran AG", slug: "felix-kran", varianten: ["v1.png", "v2.png"] },
  { name: "Beat Brugger Impulse", slug: "bb-impulse", varianten: ["v1.png", "v2.png"] },
  { name: "smart navigator", slug: "smart-navigator", varianten: ["v1.svg", "v2.svg", "v3.jpg"] },
  { name: "Schöner Feiern", slug: "schoener-feiern", varianten: ["v1.png", "v2.png"] },
  { name: "emotion Hinwil", slug: "emotion-hinwil", varianten: ["v1.png", "v2.png"] },
  { name: "Cynterim", slug: "cynterim", varianten: ["v1.svg", "v2.svg"] },
  { name: "it-stall", slug: "it-stall", varianten: ["v1.svg", "v2.svg"] },
  { name: "Architekturmacher", slug: "architekturmacher", varianten: ["v1.png"] },
  { name: "Fahrschule Schweiz", slug: "fahrschule-schweiz", varianten: ["v1.png", "v2.png", "v3.png"] },
];

const referenzen = [
  { img: "/uftakt/refs/neo-fahrzeugservice.jpg", name: "NEO Fahrzeugservice", host: "neo-fahrzeugservice.ch" },
  { img: "/uftakt/refs/cvaglobal.jpg", name: "CVA Global Shipping", host: "cvaglobal.com" },
  { img: "/uftakt/refs/kskosmetik.jpg", name: "KS Kosmetik", host: "kskosmetik.ch" },
  { img: "/uftakt/refs/felixkran.jpg", name: "Felix Kran AG", host: "felixkran.ch" },
  { img: "/uftakt/refs/vakuum-technik.jpg", name: "Vakuum-Technik Bär", host: "vakuum-technik.ch" },
];

const mehrProjekte = ["ehc-wetzikon", "ripa-immobilien", "aweso"]
  .map((slug) => projects.find((p) => p.slug === slug))
  .filter((p): p is (typeof projects)[number] => p !== undefined);

const faq = [
  {
    q: "Was muss ich liefern?",
    a: "Stichworte zu deinen Texten: was du anbietest, für wen und in welcher Region. Dazu dein Bildmaterial, das du direkt bei uns hochlädst. Die Texte daraus schreiben wir.",
  },
  {
    q: "Ich bin schon länger im Geschäft. Gilt das Angebot auch für mich?",
    a: "Ja. Uftakt ist die Linie für Einmannbetriebe und kleine Firmen, frisch gegründet oder seit Jahren im Geschäft. Die Konditionen gelten für alle gleich.",
  },
  {
    q: "Kann ich die Webseite selbst bearbeiten?",
    a: "Nein, und das ist Absicht. Du hast kein System zu lernen und kannst nichts verstellen. Schick uns ein Mail, wir erledigen Anpassungen. 2 Stunden pro Jahr sind im Abo inklusive, das reicht für die üblichen kleinen Änderungen.",
  },
  {
    q: "Wann startet ihr?",
    a: "Sobald die Rechnung bezahlt ist und deine Stichworte und Bilder vollständig sind.",
  },
  {
    q: "Bekomme ich vorab einen Entwurf?",
    a: "Nein. Wir bauen die Webseite direkt und fertig. Das hält den Preis tief und das Tempo hoch.",
  },
  {
    q: "Wie läuft die Betreuung?",
    a: "Hosting, Updates, Backups und kleine Anpassungen sind im Abo drin: CHF 780 pro Jahr bei 2-jähriger Laufzeit oder CHF 900 pro Jahr bei 1-jähriger. Verrechnet wird einmal pro Jahr, die erste Rechnung kommt nach Fertigstellung der Webseite.",
  },
  {
    q: "Wie komme ich aus dem Abo wieder raus?",
    a: "Das Abo läuft 1 oder 2 Jahre und verlängert sich jeweils automatisch um die gewählte Laufzeit. Du kannst 3 Monate vor Ablauf kündigen.",
  },
];
---

<Layout
  title="Uftakt: Logo und Webseite zum Fixpreis - Uftritt"
  description="Uftakt ist die Linie von Uftritt für Einmannbetriebe, kleine Firmen und Startups: Logo und Webseite zum Fixpreis, Paket CHF 3500, Betreuung im Abo inklusive."
  ogImage="/uftakt/og-uftakt.png"
>
  <PageHero
    title={"Logo und Webseite zum Fixpreis."}
    lead="Du lieferst Stichworte und Bilder, wir schreiben die Texte, bauen Logo und Webseite und kümmern uns um den Unterhalt. Beides zusammen für CHF 3500."
  >
    <p class="brand-lockup" slot="hero-top" data-reveal>
      <span class="brand-mark">uftakt</span>
      <span class="brand-sub">– preisgünstig stark auftreten</span>
    </p>
    <div slot="hero-extra">
      <div class="hero-ctas">
        <Button href="/kontakt/" variant="blue">Kostenloses Erstgespräch</Button>
        <Button href="#referenzen" variant="text">Referenzen ansehen</Button>
      </div>
    </div>
  </PageHero>

  {/* Ablauf */}
  <section class="section" id="ablauf">
    <div class="container">
      <header class="section-head" data-reveal>
        <span class="eyebrow">Der Ablauf</span>
        <h2>Schnell zum Erfolg</h2>
      </header>
      <ProcessSteps steps={ablaufSchritte} cols={4} />
    </div>
  </section>

  {/* Logo */}
  <section class="section section--soft" id="logo">
    <div class="container">
      <header class="section-head" data-reveal>
        <span class="eyebrow">Dein Logo</span>
        <h2>Ein Logo, das lange trägt.</h2>
      </header>
      <p class="et-lead" data-reveal>
        Dein Logo prägt auf der Webseite, auf Visitenkarten, auf Rechnungen,
        vielleicht auf dem Fahrzeug deinen Auftritt. Es später zu ersetzen ist
        aufwendig, und jeder Wechsel kostet Wiedererkennung. Darum lohnt es
        sich, von Anfang an einen soliden Grundstein zu legen.
      </p>
      <ul class="et-tick" data-reveal>
        {logoPunkte.map((p) => <li>{p}</li>)}
      </ul>
      <p class="et-pricechip" data-reveal>Einzeln CHF 1750 · im Paket inklusive</p>

      <h3 class="et-subhead" data-reveal>Logos von Uftritt</h3>
      <div class="et-logos" data-reveal>
        {
          logos.map((l) => (
            <figure class="et-logocard" data-logo-slider>
              <div class="et-logocard-viewport">
                <div class="et-logocard-track">
                  {l.varianten.map((v, vi) => (
                    <div class="et-logocard-slide">
                      <img
                        src={`/uftakt/logos/${l.slug}/${v}`}
                        alt={`Logo ${l.name}${l.varianten.length > 1 ? `, Variante ${vi + 1}` : ""}`}
                        loading="lazy"
                        draggable="false"
                      />
                    </div>
                  ))}
                </div>
              </div>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  {/* Webseite-Referenzen */}
  <section class="section" id="referenzen">
    <div class="container">
      <header class="section-head" data-reveal>
        <span class="eyebrow">Webseiten</span>
        <h2>Über zehn Jahre Erfahrung, Werkzeuge von heute.</h2>
      </header>
      <p class="et-lead" data-reveal>
        Wir bauen Webseiten seit über zehn Jahren und arbeiten heute mit
        KI-Werkzeugen. Das macht uns schnell: Wir bauen deine Seite direkt und
        fertig, ohne Prototyp und ohne lange Korrekturschleifen. Darum können
        wir den Fixpreis anbieten, den du hier siehst.
      </p>
      <p class="et-lead" data-reveal>
        Und du musst dich um nichts kümmern: kein System zu lernen, nichts zu
        aktualisieren, nichts kaputt zu machen. Änderungen schickst du uns per
        Mail.
      </p>

      <h3 class="et-subhead" data-reveal>Webseiten, gebaut und betreut von Uftritt</h3>
      <div class="et-carousel" data-et-carousel data-reveal aria-roledescription="Karussell" aria-label="Webseite-Referenzen">
        <div class="et-carousel-viewport">
          <div class="et-carousel-track">
            {
              referenzen.map((r) => (
                <div class="et-carousel-slide">
                  <a class="et-refcard" href={`https://${r.host}`} target="_blank" rel="noopener" aria-label={`Webseite ${r.host} besuchen`}>
                    <img src={r.img} alt={`Webseite ${r.host}`} width="800" height="600" loading="lazy" draggable="false" />
                    <span class="et-refcard-ov">
                      <span class="et-refcard-name">{r.name}</span>
                      <span class="et-refcard-host">{r.host}</span>
                    </span>
                  </a>
                </div>
              ))
            }
          </div>
        </div>
        <div class="et-carousel-ui">
          <button type="button" class="et-carousel-arrow et-carousel-prev" aria-label="Vorherige Referenz"></button>
          <span class="et-carousel-dots"></span>
          <button type="button" class="et-carousel-arrow et-carousel-next" aria-label="Nächste Referenz"></button>
        </div>
      </div>
    </div>
  </section>

  {/* Preise */}
  <section class="section section--soft" id="preise">
    <div class="container">
      <header class="section-head" data-reveal>
        <span class="eyebrow">Preise</span>
        <h2>Das ganze Paket oder einzeln</h2>
      </header>
      <div class="et-prices" data-reveal>
        <article class="et-pcard et-pcard--hero">
          <div class="et-badge">Paketpreis</div>
          <h3>Logo + Webseite</h3>
          <p class="et-preis">CHF 3500 <small class="et-statt">CHF 4250</small></p>
          <p class="et-save">Du sparst CHF 750 auf die Webseite, weil du beides zusammen kaufst.</p>
          <ul>
            <li>3 ausgearbeitete Logo-Varianten zur Auswahl</li>
            <li>Sauber reingezeichnet, für Web und Druck</li>
            <li>Alle Dateiformate mit Quer- und Hochformat in dunkler und heller Version</li>
            <li>Texte aus deinen Stichworten von uns geschrieben</li>
            <li>E-Mail-Adresse auf deiner Domain inklusive</li>
            <li>DNS-Zone wird für dich aufgesetzt</li>
            <li>SSL-Zertifikat inklusive</li>
            <li>Fürs Handy optimiert</li>
            <li>Hochwertige Stockbilder inklusive Bildlizenzen</li>
            <li>Rechtliche Seiten inklusive (Impressum, Datenschutz)</li>
            <li>Basisoptimierung für Google und KI</li>
            <li>Sehr schnelle Ladegeschwindigkeit</li>
          </ul>
          <p class="et-exkl">exkl. MwSt. und exkl. Betreuungsabo</p>
        </article>
        <article class="et-pcard">
          <h3>Nur die Webseite?</h3>
          <p class="et-preis">CHF 2500 <small>einmalig</small></p>
          <ul>
            <li>Texte aus deinen Stichworten von uns geschrieben</li>
            <li>E-Mail-Adresse auf deiner Domain inklusive</li>
            <li>DNS-Zone wird für dich aufgesetzt</li>
            <li>SSL-Zertifikat inklusive</li>
            <li>Fürs Handy optimiert</li>
            <li>Hochwertige Stockbilder inklusive Bildlizenzen</li>
            <li>Rechtliche Seiten inklusive (Impressum, Datenschutz)</li>
            <li>Basisoptimierung für Google und KI</li>
            <li>Sehr schnelle Ladegeschwindigkeit</li>
          </ul>
          <p class="et-exkl">exkl. MwSt. und exkl. Betreuungsabo</p>
          <h3 class="et-pcard-sub">Nur das Logo?</h3>
          <p class="et-preis">CHF 1750 <small>einmalig</small></p>
          <ul>
            <li>3 ausgearbeitete Varianten zur Auswahl</li>
            <li>Sauber reingezeichnet, für Web und Druck</li>
            <li>Alle Dateiformate mit Quer- und Hochformat in dunkler und heller Version</li>
          </ul>
          <p class="et-exkl">exkl. MwSt.</p>
        </article>
      </div>

      <div class="et-abo" data-et-abo data-reveal>
        <h3>Betreuung im Abo</h3>
        <div class="et-abo-toggle" role="group" aria-label="Laufzeit wählen">
          <button type="button" class="et-abo-btn is-active" aria-pressed="true" data-abo="zwei">2-jährig</button>
          <button type="button" class="et-abo-btn" aria-pressed="false" data-abo="eins">1-jährig</button>
        </div>
        <p class="et-abo-preis">
          <span data-abo-preis>CHF 780</span> <small data-abo-einheit>pro Jahr</small>
        </p>
        <p class="et-abo-text">
          Alles inklusive: Hosting, Updates, Backups, SSL-Zertifikat, deine
          E-Mail-Adresse, persönlicher Ansprechpartner.
        </p>
        <ul class="et-abo-list">
          <li><strong>Keine Sorgen mehr rund um die Webseite:</strong> Schick uns Bilder und Texte und wir setzen die Anpassungen innerhalb von 48 Stunden um.</li>
          <li><strong>Planbar und transparent</strong> dank fixen Kosten.</li>
          <li><strong>2 Stunden inklusive:</strong> Reicht in 95 % der Fälle aus.</li>
        </ul>
        <p class="et-abo-hinweis" data-abo-hinweis>Entspricht CHF 65 pro Monat. Rechnung nach Fertigstellung der Webseite, jeweils für das ganze Jahr.</p>
      </div>
    </div>
  </section>

  {/* Kundenstimmen (gleiche Komponente wie auf der Startseite) */}
  <section class="section" id="stimmen">
    <div class="container">
      <Reviews />
    </div>
  </section>

  {/* Mehr als der Einstieg: RefStrip-Pattern wie auf /angebot/webdesign/ */}
  <RefStrip
    title="Bist du schon weiter? Brauchst du mehr?"
    projects={mehrProjekte}
    ctaText="Alle Projekte ansehen"
  />

  {/* FAQ */}
  <section class="section" id="faq">
    <div class="container faq-wrap">
      <header class="section-head" data-reveal>
        <span class="eyebrow">FAQ</span>
        <h2>Häufige Fragen zu Uftakt</h2>
      </header>
      <div class="faq" data-reveal>
        {
          faq.map((f, i) => (
            <details class="faq-item" name="faq" open={i === 0}>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  {/* Final CTA */}
  <section class="section section--yellow" id="kontakt">
    <div class="container lp-cta" data-reveal>
      <h2>uftakt – preisgünstig stark auftreten</h2>
      <p class="lp-cta-text">
        Im kostenlosen Erstgespräch klären wir, was du brauchst, und du bekommst
        ein Angebot zum Fixpreis.
      </p>
      <Button href="/kontakt/" variant="blue">Kostenloses Erstgespräch</Button>
      <p class="et-linie-hinweis">
        Uftakt · eine Linie der <a href="/">Uftritt GmbH</a>, Saland
      </p>
    </div>
  </section>

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faq.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    })}
  />
</Layout>

<script>
  // Logo-Kacheln: Autoslider pro Marke (Endlosschleife, Pause bei Hover/Fokus,
  // kein Autoplay bei reduzierter Bewegung). Pattern wie st-slider in projekte/[slug].astro.
  document.querySelectorAll<HTMLElement>("[data-logo-slider]").forEach((root) => {
    const track = root.querySelector<HTMLElement>(".et-logocard-track");
    const slides = root.querySelectorAll<HTMLElement>(".et-logocard-slide");
    if (!track || slides.length < 2) return;
    let i = 0;
    let timer: number | undefined;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const go = (n: number) => {
      i = (n + slides.length) % slides.length;
      track.style.transform = `translateX(-${i * 100}%)`;
    };
    const stop = () => {
      if (timer !== undefined) {
        clearInterval(timer);
        timer = undefined;
      }
    };
    const start = () => {
      if (!reduced && timer === undefined) timer = window.setInterval(() => go(i + 1), 2800);
    };
    root.addEventListener("pointerenter", stop);
    root.addEventListener("pointerleave", start);
    root.addEventListener("focusin", stop);
    root.addEventListener("focusout", start);
    start();
  });

  // Referenz-Karussell: 3 Karten Desktop, 1 mobil, Auto-Loop 4.5 s,
  // Pfeile + Punkte, Wischen, Pause bei Hover/Fokus, reduced-motion ohne Autoplay.
  document.querySelectorAll<HTMLElement>("[data-et-carousel]").forEach((root) => {
    const track = root.querySelector<HTMLElement>(".et-carousel-track");
    const slides = root.querySelectorAll<HTMLElement>(".et-carousel-slide");
    const dotsWrap = root.querySelector<HTMLElement>(".et-carousel-dots");
    if (!track || !dotsWrap || slides.length < 2) return;
    const mql = window.matchMedia("(max-width: 900px)");
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let i = 0;
    let timer: number | undefined;
    const visible = () => (mql.matches ? 1 : 3);
    const maxIndex = () => Math.max(0, slides.length - visible());
    const go = (n: number) => {
      const max = maxIndex();
      i = ((n % (max + 1)) + max + 1) % (max + 1);
      track.style.transform = `translateX(-${i * (100 / visible())}%)`;
      dotsWrap.querySelectorAll("button").forEach((d, k) => d.classList.toggle("active", k === i));
    };
    const buildDots = () => {
      dotsWrap.innerHTML = "";
      for (let k = 0; k <= maxIndex(); k++) {
        const b = document.createElement("button");
        b.type = "button";
        b.className = "et-carousel-dot";
        b.setAttribute("aria-label", `Position ${k + 1} von ${maxIndex() + 1}`);
        b.addEventListener("click", () => go(k));
        dotsWrap.appendChild(b);
      }
    };
    const stop = () => {
      if (timer !== undefined) {
        clearInterval(timer);
        timer = undefined;
      }
    };
    const start = () => {
      if (!reduced && timer === undefined) timer = window.setInterval(() => go(i + 1), 4500);
    };
    root.querySelector<HTMLButtonElement>(".et-carousel-prev")?.addEventListener("click", () => go(i - 1));
    root.querySelector<HTMLButtonElement>(".et-carousel-next")?.addEventListener("click", () => go(i + 1));
    root.addEventListener("pointerenter", stop);
    root.addEventListener("pointerleave", start);
    root.addEventListener("focusin", stop);
    root.addEventListener("focusout", start);
    let x0: number | null = null;
    track.addEventListener("pointerdown", (e) => {
      x0 = e.clientX;
    });
    track.addEventListener("pointerup", (e) => {
      if (x0 === null) return;
      const dx = e.clientX - x0;
      if (Math.abs(dx) > 40) go(i + (dx < 0 ? 1 : -1));
      x0 = null;
    });
    mql.addEventListener("change", () => {
      buildDots();
      go(i);
    });
    buildDots();
    go(0);
    start();
  });

  // Abo-Toggle: 2-jährig / 1-jährig (ohne JS bleibt die 2-jährige Ansicht stehen).
  document.querySelectorAll<HTMLElement>("[data-et-abo]").forEach((root) => {
    const preis = root.querySelector<HTMLElement>("[data-abo-preis]");
    const einheit = root.querySelector<HTMLElement>("[data-abo-einheit]");
    const hinweis = root.querySelector<HTMLElement>("[data-abo-hinweis]");
    const btns = root.querySelectorAll<HTMLButtonElement>(".et-abo-btn");
    if (!preis || !einheit || !hinweis || btns.length === 0) return;
    const daten: Record<string, { preis: string; einheit: string; hinweis: string }> = {
      zwei: {
        preis: "CHF 780",
        einheit: "pro Jahr",
        hinweis: "Entspricht CHF 65 pro Monat. Rechnung nach Fertigstellung der Webseite, jeweils für das ganze Jahr.",
      },
      eins: {
        preis: "CHF 900",
        einheit: "pro Jahr",
        hinweis: "Entspricht CHF 75 pro Monat. Rechnung nach Fertigstellung der Webseite, jeweils für das ganze Jahr.",
      },
    };
    btns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const key = btn.dataset.abo ?? "zwei";
        const d = daten[key];
        if (!d) return;
        preis.textContent = d.preis;
        einheit.textContent = d.einheit;
        hinweis.textContent = d.hinweis;
        btns.forEach((b) => {
          const aktiv = b === btn;
          b.classList.toggle("is-active", aktiv);
          b.setAttribute("aria-pressed", aktiv ? "true" : "false");
        });
      });
    });
  });
</script>

<style>
  /* Markenzeile im Hero */
  .brand-lockup {
    display: flex; align-items: baseline; gap: 0.75rem; flex-wrap: wrap;
    margin: 0 0 1rem;
  }
  .brand-mark { font-weight: 800; font-size: 1.5rem; letter-spacing: 0.01em; color: var(--color-blue); }
  .brand-sub { font-size: 0.95rem; font-weight: 700; color: var(--color-blue); opacity: 0.65; }

  .et-lead { color: var(--color-blue); font-size: 1.1rem; line-height: 1.7; max-width: 70ch; margin-bottom: 1rem; }
  .et-subhead { margin-top: 2.5rem; }

  /* Logo-Sektion */
  .et-tick { list-style: none; margin: 1rem 0 0; padding: 0; }
  .et-tick li { position: relative; padding-left: 1.6rem; margin-bottom: 0.6rem; color: var(--color-blue); font-size: 1.05rem; }
  .et-tick li::before { content: ""; position: absolute; left: 0; top: 0.5em; width: 0.75rem; height: 0.75rem; background: var(--color-yellow); }
  .et-pricechip { display: inline-block; background: var(--color-yellow); color: var(--color-blue); font-weight: 800; padding: 0.5rem 1rem; margin-top: 1.25rem; }

  /* Logo-Wand mit Autoslider-Kacheln */
  .et-logos { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(0.75rem, 2vw, 1.25rem); margin-top: 1.25rem; }
