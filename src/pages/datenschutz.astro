    max-width: 1040px;
  }
  .legal h2 {
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
  }
  .legal h3 {
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
    font-size: 1.25rem;
  }
  .legal p {
    color: var(--color-blue);
    line-height: 1.75;
    margin-bottom: 1rem;
  }
  .legal ul {
    list-style: disc;
    padding-left: 1.25rem;
    margin-bottom: 1.25rem;
    color: var(--color-blue);
  }
  .legal li {
    line-height: 1.7;
    margin-bottom: 0.35rem;
  }
  .legal a:hover {
    color: var(--color-pink);
  }
  .legal-stand {
    margin-top: 2rem;
    font-weight: 700;
  }
</style>
