---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Button from "../components/Button.astro";
import LocalTrust from "../components/LocalTrust.astro";
import OfferLink from "../components/OfferLink.astro";
import { projects } from "../data/projects";

const cases = projects.filter((p) =>
  ["heusser-holzbau", "peter-ott", "empower", "aas-freight", "youngstars", "fahrschule-schweiz"].includes(p.slug)
);

const ranges = [
  {
    name: "Eigenproduktion mit dem Smartphone",
    price: "fast nichts",
    note: "Für spontane Clips auf Social Media völlig okay. Du zahlst nicht mit Geld, sondern mit deiner Zeit, und bei Ton und Licht zeigt sich schnell der Unterschied.",
  },
  {
    name: "Social-Clip / kurzer Bewegtbild-Content",
    price: "CHF 800 bis 3000",
    note: "Kurze Videos für Instagram, LinkedIn oder die Website: ein kompakter Dreh, ein Schnitt, Untertitel. Konzept und Aufwand der Postproduktion entscheiden, wo du in dieser Range landest.",
  },
  {
    name: "Klassischer Imagefilm",
    price: "CHF 3000 bis 15 000",
    note: "Der typische Firmenfilm mit ein bis zwei Drehtagen: Konzept, professionelles Team, sauberer Ton, Sprecherin oder Musik. Genau hier spielen die meisten KMU-Produktionen.",
  },
  {
    name: "Aufwendige Produktion",
    price: "CHF 15 000 bis 50 000",
    note: "Mehrere Drehtage und Locations, Drohnenaufnahmen, Schauspielende, Animation und Motion Design. Grosse Marken-Kampagnen gehen auch deutlich darüber hinaus.",
  },
];

const posten = [
  { name: "Konzept, Drehbuch, Storyboard", value: "ca. CHF 200 bis 250 pro Stunde" },
  { name: "Dreh, pro Person im Team", value: "ca. CHF 120 bis 180 pro Stunde" },
  { name: "Schnitt und Postproduktion", value: "ca. CHF 120 bis 180 pro Stunde" },
  { name: "Sprecherin, Musik, Darstellende", value: "sehr unterschiedlich: Stock-Musik kostet wenig, professionelle Stimmen und Schauspielende werden nach Rechten und Einsatz abgerechnet" },
  { name: "Drohne und Spezialtechnik", value: "Zuschlag je nach Einsatz, Equipment und Location" },
  { name: "Versionen und Formate", value: "jede Zusatzversion (Kurzformat, Untertitel, Sprachversion) ist eigener Aufwand" },
];

const faq = [
  {
    q: "Was kostet ein Imagefilm in der Schweiz?",
    a: "Eine einfache, professionelle Produktion mit einem bis zwei Drehtagen kostet in der Schweiz zwischen CHF 3000 und 15 000. Kurze Social-Clips starten bei rund CHF 800 bis 3000, aufwendige Produktionen mit mehreren Drehtagen, Drohne und Motion Design liegen zwischen CHF 15 000 und 50 000. Grosse Kampagnen gehen auch darüber hinaus.",
  },
  {
    q: "Warum sind die Preisranges so gross?",
    a: "Weil ein Imagefilm kein Standardprodukt ist. Der Preis entsteht aus Drehtagen und Teamgrösse, Konzept und Drehbuch, Sprecherin und Musik, Drohne oder Animation und der Anzahl Schnittversionen. Ein Film mit einer Person und einer Kamera kostet einen Bruchteil einer Produktion mit Regie, Licht, Ton und mehreren Locations, und beide heissen Imagefilm.",
  },
  {
    q: "Reicht ein Smartphone-Video?",
    a: "Für spontane Social-Media-Clips ja, manchmal ist es sogar besser, weil es echt wirkt. Für den Film, der deine Firma auf der Website oder im Verkaufsgespräch repräsentiert, lohnt sich Profiqualität: Den Unterschied hörst du beim Ton, siehst du beim Licht und merkst du an der erzählten Geschichte. Unser Rat: Kurze Clips selbst machen, den einen wichtigen Film professionell produzieren lassen.",
  },
  {
    q: "Wie lange dauert eine Imagefilm-Produktion?",
    a: "Vom ersten Gespräch bis zum fertigen Film vergehen in der Regel mehrere Wochen: Konzept und Drehbuch, ein bis zwei Drehtage, danach Schnitt, Musik und Abstimmungsschlaufen. Wer straff entscheidet und Feedback termingerecht gibt, kommt schneller ans Ziel.",
  },
  {
    q: "Was kostet ein Imagefilm bei euch?",
    a: "Das sagen wir dir ehrlich erst nach dem Erstgespräch, weil kein Film dem anderen gleicht. Darum arbeiten wir so: kostenloses Erstgespräch, danach bekommst du ein transparentes Angebot mit allen Leistungen und einem klaren Preis. Was nicht drinsteht, wird nicht extra verrechnet, und Änderungswünsche ausserhalb des Umfangs besprechen wir vorher, nie hinterher auf der Rechnung.",
  },
  {
    q: "Lohnt sich ein Imagefilm für ein KMU?",
    a: "Wenn du Vertrauen aufbauen willst, ja. Auf der Website, an Messen, im Verkauf und beim Recruiting wirkt ein guter Film jahrelang. Brauchst du eigentlich nur kurze Inhalte für Social Media, ist eine Serie von Kurzclips die günstigere und oft reichweitenstärkere Lösung. Erst das Ziel klären, dann das Budget, so vermeidest du teure Fehlkäufe.",
  },
];
---

<Layout
  title="Was kostet ein Imagefilm?, Uftritt"
  description="Was kostet ein Imagefilm? Ehrliche Preisranges für die Schweiz: Social-Clip, klassischer Imagefilm, aufwendige Produktion, dazu Preistreiber und FAQ."
>
  <PageHero
    eyebrow="Imagefilm-Kosten · Schweiz"
    title={"Was kostet\nein Imagefilm?"}
    lead="Die ehrliche Antwort vorweg: Ein kurzer Social-Clip kostet in der Schweiz CHF 800 bis 3000, ein klassischer Imagefilm mit ein bis zwei Drehtagen CHF 3000 bis 15 000, eine aufwendige Produktion mit Drohne und Motion Design CHF 15 000 bis 50 000. Was du am Ende zahlst, entscheidet sich an Drehtagen, Team und Konzept."
    lottie="/lottie/videoproduktion.json"
    lottieLabel="Imagefilm-Kosten"
  >
    <div slot="hero-extra" class="hero-ctas">
      <Button href="/kontakt/" variant="blue">Kostenloses Erstgespräch</Button>
      <Button href="/projekte/" variant="text">Projekte ansehen</Button>
    </div>
  </PageHero>

  <OfferLink href="/angebot/videoproduktion/" label="Videoproduktion" lottie="/lottie/videoproduktion.json" projects={cases} />

  {/* Antwort-Block: Preisranges */}
  <section class="section">
    <div class="container">
      <header class="section-head" data-reveal>
        <span class="eyebrow">Marktüberblick</span>
        <h2>Die Preisranges im Überblick</h2>
      </header>
      <div class="ranges" data-reveal>
        {
          ranges.map((r) => (
            <article class="range-card">
              <h3>{r.name}</h3>
              <p class="range-price">{r.price}</p>
              <p class="range-note">{r.note}</p>
            </article>
          ))
        }
      </div>
      <p class="quellen" data-reveal>
        Richtwerte aus unserer Projekterfahrung. Jeder Film ist individuell, darum
        sind das Ranges und keine Ladenpreise.
      </p>
    </div>
  </section>

  {/* Preistreiber + Kostenposten */}
  <section class="section section--soft">
    <div class="container lp-blocks">
      <article class="lp-block" data-reveal>
        <h2>Was den Preis wirklich treibt</h2>
        <div class="lp-text">
          <p>
            Wer einen Imagefilm erstellen lassen will, bezahlt am Ende vor allem
            Drehtage und Teamgrösse: Jeder zusätzliche Drehtag kostet Crew, Equipment
            und Logistik, und eine Person mit einer Kamera kostet einen Bruchteil
            eines Teams mit Regie, Licht und Ton.
          </p>
          <p>
            Der zweite grosse Posten ist die Arbeit vor und nach dem Dreh: Konzept und
            Drehbuch entscheiden, ob der Film trägt, und in der Postproduktion
            entstehen Schnitt, Farben, Grafik und Vertonung. Dazu kommen Sprecherin
            und Musik sowie Specials wie Drohnenaufnahmen oder Animation. Und ein
            unterschätzter Treiber: die Anzahl Versionen. Hauptfilm, Kurzversion für
            Instagram, Untertitel, Zweitsprache, jede Variante ist Mehraufwand.
          </p>
          <p>
            Zum Einordnen: Videoproduzenten in der Schweiz rechnen für Dreh und
            Schnitt grob mit CHF 120 bis 180 pro Stunde, für Konzeptarbeit mit CHF
            200 bis 250.
          </p>
        </div>
      </article>
      <article class="lp-block" data-reveal>
        <h2>Aus diesen Posten setzt sich der Preis zusammen</h2>
        <div class="lp-text">
          <p>
            Der Gesamtpreis ist die Summe vieler Einzelposten. Diese Positionen
            stehen in fast jeder Offerte für eine Videoproduktion:
          </p>
          <ul class="kosten-liste">
            {
              posten.map((l) => (
                <li>
                  <strong>{l.name}</strong>
                  <span>{l.value}</span>
                </li>
              ))
            }
          </ul>
          <p class="abo-hinweis" data-reveal>
            <strong>Und bei uns fix:</strong> kostenloses Erstgespräch, danach ein
            transparentes Angebot mit allen Posten und einem klaren Preis, ohne
            Kleingedrucktes.
          </p>
        </div>
      </article>
    </div>
  </section>

  {/* Smartphone vs. Produktionsfirma + Listenpreise */}
  <section class="section">
    <div class="container lp-blocks">
      <article class="lp-block" data-reveal>
        <h2>Smartphone-Video oder Produktionsfirma?</h2>
        <div class="lp-text">
          <p>
            Ehrlich gesagt: Für den spontanen Einblick auf Social Media ist das
            Smartphone oft die bessere Wahl, weil es echt und nahbar wirkt. Mit
            etwas Tageslicht und einem ruhigen Hintergrund kommst du weit.
          </p>
          <p>
            Für den Film, der deine Firma über Jahre repräsentiert, auf der Website,
            im Verkaufsgespräch, an der Messe, lohnt sich Profiqualität. Den
            Unterschied hörst du beim Ton, siehst du beim Licht und merkst du an der
            Geschichte, die erzählt wird. Unser Rat aus der Praxis: Kurze Clips selbst
            machen und den einen wichtigen Film professionell produzieren lassen.
          </p>
          <p>
            Übrigens: Was der Webauftritt kostet, auf dem dein Film später laufen
            soll, legen wir genauso offen dar. Hier geht es zum Guide:{" "}
            <a href="/website-kosten/">Website-Kosten</a>.
          </p>
        </div>
      </article>
      <article class="lp-block" data-reveal>
        <h2>Warum seriöse Produzenten keine Listenpreise nennen</h2>
        <div class="lp-text">
          <p>
            Weil es sie nicht gibt. Kein Film gleicht dem anderen, darum nennt auch
            kaum eine seriöse Produktionsfirma Pauschalpreise auf ihrer Website. Ein
            Listenpreis wäre für das einfache Projekt zu hoch und für das
            anspruchsvolle zu tief kalkuliert. Für beide Seiten unehrlich.
          </p>
          <p>
            Vorsicht bei Lockangeboten: Wird ein «professioneller Imagefilm» für ein
            paar hundert Franken angepriesen, fehlen meist Konzept, Licht, sauberer
            Ton oder die Musikrechte. Oder die fehlenden Posten tauchen später auf
            der Rechnung auf.
          </p>
          <p>
            Darum arbeiten wir so: kostenloses Erstgespräch, danach ein transparentes
            Angebot mit allen Leistungen und einem klaren Preis. Wie wir Filme
            konzipieren und produzieren, zeigen wir im{" "}
            <a href="/angebot/videoproduktion/">Angebot Videoproduktion</a> und auf
            unserer Seite zur{" "}
            <a href="/videoproduktion-zuercher-oberland/">Videoproduktion im Zürcher Oberland</a>.
            Keine versteckten Kosten, keine Überraschungen.
          </p>
        </div>
      </article>
    </div>
  </section>

  {/* FAQ */}
  <section class="section">
    <div class="container faq-wrap">
      <header class="section-head" data-reveal>
        <span class="eyebrow">FAQ</span>
        <h2>Häufige Fragen zu Imagefilm-Kosten</h2>
      </header>
      <div class="faq" data-reveal>
        {
          faq.map((f, i) => (
            <details class="faq-item" name="faq" open={i === 0}>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <LocalTrust check={false} />

  <section class="section section--yellow">
    <div class="container lp-cta" data-reveal>
      <h2>Willst du wissen, was dein Film kostet?</h2>
      <p class="lp-cta-text">
        Erzähl uns von deiner Idee. Du bekommst ein ehrliches, transparentes
        Angebot, kostenlos und unverbindlich.
      </p>
      <Button href="/kontakt/" variant="blue">Schriib eus</Button>
    </div>
  </section>

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faq.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    })}
  />
</Layout>

<style>
  .ranges { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(0.75rem, 2vw, 1.5rem); }
  .range-card {
    display: flex; flex-direction: column; gap: 0.5rem;
    background: #fff; border: 1px solid #e7ecf3; padding: clamp(1.25rem, 2.5vw, 1.75rem);
  }
  .range-card h3 { color: var(--color-blue); font-size: 1.15rem; }
  .range-price { font-weight: 700; font-size: 1.35rem; color: var(--color-pink); margin: 0; }
  .range-note { color: var(--color-blue); opacity: 0.85; font-size: 0.95rem; line-height: 1.6; margin: 0; }
  .quellen { margin-top: 1.5rem; color: var(--color-blue); opacity: 0.75; font-size: 0.9rem; line-height: 1.6; max-width: 75ch; }

  .lp-blocks { display: flex; flex-direction: column; gap: clamp(2.5rem, 5vw, 4.5rem); }
  .lp-block { display: grid; grid-template-columns: 1fr 2fr; gap: clamp(1rem, 3vw, 3rem); align-items: start; }
  .lp-block h2 { position: sticky; top: 100px; }
  .lp-text p { color: var(--color-blue); font-size: 1.1rem; line-height: 1.7; margin-bottom: 1rem; }
  .kosten-liste { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .kosten-liste li {
    display: flex; flex-direction: column; gap: 0.15rem;
    padding: 0.9rem 0; border-bottom: 1px solid rgba(1, 64, 128, 0.15);
    color: var(--color-blue); font-size: 1.05rem;
  }
  .kosten-liste li:last-child { border-bottom: 0; }
  .kosten-liste span { opacity: 0.85; }
  .abo-hinweis {
    margin-top: 1.25rem; padding: 1rem 1.25rem;
    border-left: 4px solid var(--color-yellow);
    background: #fff; color: var(--color-blue);
    font-size: 1.05rem !important; line-height: 1.6;
  }

  .faq-wrap { max-width: 860px; }
  .faq-item { border-bottom: 1px solid rgba(1, 64, 128, 0.2); }
  .faq-item summary {
    cursor: var(--cur-hand); list-style: none; padding: 1.1rem 0;
    font-weight: 700; color: var(--color-blue); font-size: 1.15rem;
    display: flex; justify-content: space-between; gap: 1rem;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: "+"; display: inline-flex; align-items: center; justify-content: center; width: 1em; height: 1em; line-height: 1; transform-origin: center; font-weight: 700; transition: transform 0.3s var(--ease); }
  .faq-item[open] summary::after { transform: rotate(45deg); }
  .faq-item p { color: var(--color-blue); line-height: 1.7; padding-bottom: 1.1rem; max-width: 70ch; }
  .lp-cta { display: flex; flex-direction: column; align-items: flex-start; gap: 1.25rem; }
  .lp-cta-text { color: var(--color-blue); font-size: 1.1rem; line-height: 1.7; max-width: 60ch; margin: 0; }

  @media (max-width: 900px) {
    .ranges { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 760px) {
    .lp-block { grid-template-columns: 1fr; }
    .lp-block h2 { position: static; }
  }
  @media (max-width: 520px) {
    .ranges { grid-template-columns: 1fr; }
  }
</style>
