---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Button from "../components/Button.astro";
import LocalTrust from "../components/LocalTrust.astro";
import OfferLink from "../components/OfferLink.astro";
import { projects } from "../data/projects";

const cases = projects.filter((p) =>
  ["garage-frei", "cynterim", "it-stall", "physio-rothe"].includes(p.slug)
);

const orte = [
  { name: "Tösstal", href: "/webdesign-toesstal/", note: "unsere Heimregion entlang der S26" },
  { name: "Zürcher Oberland", href: "/webdesign-zuercher-oberland/", note: "hier sind wir zuhause, in Saland" },
  { name: "Pfäffikon", href: "/webdesign-pfaeffikon/", note: "Bezirkshauptort Richtung Süden" },
  { name: "Uster", href: "/webdesign-uster/", note: "drittgrösste Stadt des Kantons" },
  { name: "Wetzikon", href: "/webdesign-wetzikon/", note: "grösste Stadt des Oberlands" },
  { name: "Zürich", href: "/webdesign-zuerich/", note: "20 Kilometer südwestlich" },
];

const weitere = ["Seuzach", "Dinhard", "Wiesendangen", "Elsau", "Neftenbach", "Illnau-Effretikon", "Kyburg", "Russikon"];

const faq = [
  { q: "Was kostet eine Website für einen Betrieb in Winterthur?", a: "Das hängt vom Umfang ab, vom schlanken Onepager bis zur Plattform mit Shop. Nach einem kostenlosen Erstgespräch erhältst du ein transparentes Angebot mit klarem Preis. Ohne Kleingedrucktes, ohne versteckte Kosten." },
  { q: "Kommt ihr zu uns nach Winterthur?", a: "Gerne. Unser Büro ist zwar nicht in Winterthur, sondern in Saland im Tösstal, aber die S26 bringt uns ohne Umsteigen an deinen Bahnhof, und mit dem Auto sind wir in einer guten halben Stunde da, ob in der Altstadt, in Oberwinterthur oder in Wülflingen. Auf Wunsch besprechen wir alles auch per Video-Call." },
  { q: "Werde ich als Winterthurer Betrieb bei Google überhaupt gefunden?", a: "In einer Stadt mit viel Konkurrenz ist das die entscheidende Frage. Eine Website allein reicht nicht, aber fast: Wir liefern jede Seite mit sauberer SEO-Basis aus, also mit klarer Struktur, schnellen Ladezeiten, Meta-Texten und Google-Anmeldung. Dazu gehört ein gepflegtes Google-Unternehmensprofil, damit du in Winterthur und Umgebung gefunden wirst, auch auf der Karte." },
  { q: "Wir haben schon eine Website, lohnt sich ein Relaunch?", a: "Oft ja: Wenn die Seite älter als vier, fünf Jahre ist, auf dem Handy hakt oder bei Google abrutscht, bringt ein Relaunch mehr als Flickwerk. Wir schauen uns deine Seite kostenlos an und sagen dir ehrlich, ob sich ein Neubau lohnt." },
  { q: "Macht ihr auch mehr als Websites?", a: "Ja: Logo, Corporate Design, Broschüren, Fotografie und Video kommen bei uns aus demselben Haus. So entsteht dein Auftritt aus einem Guss, vom Erscheinungsbild bis zur fertigen Website, ohne dass du fünf Agenturen koordinieren musst." },
  { q: "Lohnt sich eine eigene Website auch für ein kleines Gewerbe?", a: "Ja. Gerade in Winterthur googeln Kundinnen und Kunden zuerst, wer dort nicht sauber erscheint, verliert Aufträge an die Konkurrenz. Eine klare, schnelle Website mit Leistungen, Öffnungszeiten und Kontakt wirkt rund um die Uhr. Wir sagen dir ehrlich, was sich für deinen Betrieb lohnt und was nicht." },
  { q: "Wer kümmert sich nach dem Launch um die Website?", a: "Auf Wunsch wir: Updates, Backups, kleine Anpassungen und laufende Betreuung, damit die Seite sicher bleibt und wächst. Oder wir zeigen dir, wie du die Inhalte selbst pflegst. Du hast die Wahl." },
  { q: "Wie lange dauert ein Website-Projekt?", a: "Je nach Umfang 4 bis 12 Wochen. Du siehst früh einen klickbaren Prototypen und bleibst durchgehend im Bild." },
];
---

<Layout
  title="Webdesign Winterthur, Uftritt"
  description="Webdesign Winterthur: Webseite erstellen lassen bei Uftritt, Websites, Branding und SEO-Basis für KMU, von der Agentur aus Saland im Zürcher Oberland."
>
  <PageHero
    eyebrow="Webdesign · Winterthur"
    title={"Webdesign\nWinterthur"}
    lead="Du suchst Webdesign in Winterthur? Uftritt ist die Kommunikationsagentur aus Saland im Zürcher Oberland: Wir entwickeln Websites und Erscheinungsbilder für KMU in Winterthur, persönlich, ohne Template und mit ehrlicher Beratung. Mit dem Auto in einer guten halben Stunde bei dir, mit der S26 ohne Umsteigen."
    lottie="/lottie/webdesign.json"
    lottieLabel="Webdesign"
  >
    <div slot="hero-extra" class="hero-ctas">
      <Button href="/kontakt/" variant="blue">Kostenloses Erstgespräch</Button>
      <Button href="/projekte/" variant="text">Projekte ansehen</Button>
    </div>
  </PageHero>

  <OfferLink href="/angebot/webdesign/" label="Webdesign und Entwicklung" lottie="/lottie/webdesign.json" projects={cases} />

  <section class="section">
    <div class="container lp-blocks">
      <article class="lp-block" data-reveal>
        <h2>Für die Stadt am Ausgang des Tösstals</h2>
        <div class="lp-text">
          <p>
            Winterthur ist mit gut 120'000 Einwohnerinnen und Einwohnern (Stand Ende
            2024) die sechstgrösste Stadt der Schweiz und die zweitgrösste im Kanton
            Zürich. Aus der Industriestadt von Sulzer, Rieter und SLM ist ein
            Dienstleistungs-, Bildungs- und Kulturzentrum geworden, mit 16 Museen,
            der ZHAW und einem Bahnhof, der als Knotenpunkt die vierthöchste
            Passagierfrequenz des Landes bewältigt. Dazu kommen sieben Stadtkreise
            mit ausgeprägtem Eigenleben, von der Altstadt über Oberwinterthur, Seen
            und Töss bis Veltheim, Wülflingen und Mattenbach. Kein Wunder gilt die
            Stadt als Tor zur Ostschweiz: Mit den Nachbargemeinden bildet sie eine
            eigene Agglomeration mit knapp 150'000 Menschen.
          </p>
          <p>
            Und: Winterthur liegt am Ausgang des oberen Tösstals, genau da kommen
            wir her. Unser Büro in Saland steht an der S26, die uns ohne Umsteigen
            direkt an den Winterthurer Hauptbahnhof bringt. Kurze Wege, Besprechungen
            bei dir im Betrieb und ein Gegenüber, das die Region zwischen Tösstal
            und Eulachstadt kennt.
          </p>
        </div>
      </article>
      <article class="lp-block" data-reveal>
        <h2>Ehrlich gesagt: Unser Büro ist nicht in Winterthur</h2>
        <div class="lp-text">
          <p>
            Unser Büro steht in Saland im Zürcher Oberland, nicht an der Marktgasse.
            Und ein abgeschlossenes Projekt direkt in Winterthur haben wir noch
            nicht vorzuweisen, das sagen wir offen, statt mit falschem Lokalbezug
            zu werben. Was wir vorzuweisen haben: KMU-Projekte in der ganzen Region.
            Für die Autogarage Frei in Dübendorf haben wir die Website neu konzipiert
            und realisiert, für den Salesforce-Partner Cynterim in Hinwil Logo,
            Branding und Website von Grund auf gebaut.
          </p>
          <p>
            Entlang der S26-Achse, die Winterthur mit dem Tösstal verbindet, kennen
            wir uns ohnehin bestens aus: Für die Physiotherapie &amp; Sport-Reha in
            Bauma kamen Website und Fotografie von uns, für den IT-Dienstleister
            it-stall in Saland Branding, Texte und Webdesign. Für dich heisst das:
            Du bekommst keine anonyme Grossagentur, sondern ein Team, das anpackt,
            persönlich bleibt und dir ehrlich sagt, was sich lohnt und was nicht.
          </p>
        </div>
      </article>
      <article class="lp-block" data-reveal>
        <h2>Webseite erstellen lassen, in einer Stadt, in der alle googeln</h2>
        <div class="lp-text">
          <p>
            Was muss eine Website für einen Winterthurer Betrieb leisten? In einer
            Stadt mit Tausenden von Anbieterinnen und Anbietern reicht es nicht,
            einfach irgendwo online zu sein: Wer dich sucht, muss dich finden, mit
            Leistungen, Öffnungszeiten und Kontakt auf einen Blick, auf dem Handy
            genauso wie am Computer. Und wer noch nicht nach dir sucht, soll dich
            bei Google entdecken können. Genau dafür bauen wir: schnell, klar
            strukturiert und mit der SEO-Basis gleich mitgeliefert. Auf Wunsch
            richten wir dir auch dein
            <a href="/google-business-profile/">Google-Unternehmensprofil</a> ein,
            damit du auf der Karte präsent bist.
          </p>
          <p>
            Uftritt ist dabei mehr als eine Webagentur: Als Werbeagentur decken wir
            ab, was darüber hinausgeht, Logo und Erscheinungsbild, Printwerbung,
            Video und die laufende Betreuung deiner Kommunikation. Deine Homepage
            und alles, was dazugehört, aus einer Hand, statt fünf Ansprechpersonen
            für fünf Disziplinen.
          </p>
          <p>
            Und wir sagen es auch, wenn weniger genügt: Für viele Betriebe ist ein
            gut gemachter Onepager die richtige Lösung, kein Grossprojekt.
          </p>
        </div>
      </article>
      <article class="lp-block" data-reveal>
        <h2>In vier Schritten zur neuen Website</h2>
        <div class="lp-text">
          <p>
            <strong>1. Erstgespräch bei dir.</strong> Kostenlos und unverbindlich -
            am liebsten bei dir in Winterthur, auf Wunsch bei uns in Saland (die
            S26 fährt direkt) oder per Video-Call. Wir hören zu, fragen nach und
            beraten ehrlich.
          </p>
          <p>
            <strong>2. Konzept und Prototyp.</strong> Du bekommst früh einen
            klickbaren Entwurf zu sehen, nicht erst am Ende. So gibt es keine
            Überraschungen.
          </p>
          <p>
            <strong>3. Umsetzung.</strong> Wir bauen die Seite, schreiben auf Wunsch
            die Texte und organisieren Fotografie, alles aus einer Hand.
          </p>
          <p>
            <strong>4. Launch und Betreuung.</strong> Nach dem Go-Live lassen wir
            dich nicht im Stich: <a href="/website-betreuung/">Betreuung und
            Wartung</a>, <a href="/seo-betreuung/">SEO-Begleitung</a> oder Schulung,
            damit du die Seite selbst pflegen kannst. Du hast schon eine ältere
            Website? Dann ist ein <a href="/website-relaunch/">Relaunch</a> der
            richtige Einstieg.
          </p>
        </div>
      </article>
      <article class="lp-block" data-reveal>
        <h2>Was kostet das?</h2>
        <div class="lp-text">
          <p>
            Die ehrliche Antwort: Es kommt darauf an, was du brauchst, ein Onepager
            für dein Gewerbe kostet weniger als eine Plattform mit Shop. Den Preis
            bestimmen Umfang, Funktionen und Inhalte: Wie viele Seiten braucht es?
            Schreiben wir die Texte, oder lieferst du sie? Pauschalpreise von der
            Stange wären unseriös. Was wir stattdessen anbieten: Nach dem kostenlosen
            Erstgespräch erhältst du ein transparentes Angebot mit allen Leistungen
            und einem klaren Preis.
          </p>
          <p>
            Zur Orientierung vorab: In unserem <a href="/website-kosten/">Guide zu
            Website-Kosten</a> zeigen wir echte Marktpreise in der Schweiz, damit
            du weisst, was eine Website kosten darf, bevor du mit uns oder einer
            anderen Agentur sprichst.
          </p>
        </div>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <header class="section-head" data-reveal>
        <span class="eyebrow">In deiner Nähe</span>
        <h2>Webdesign in deinem Ort</h2>
      </header>
      <div class="orte" data-reveal>
        {
          orte.map((o) => (
            <a class="ort-card" href={o.href}>
              <span class="ort-name">{o.name}</span>
              <span class="ort-note">{o.note}</span>
            </a>
          ))
        }
      </div>
      <p class="orte-note" data-reveal>
        Und natürlich auch in: {weitere.join(", ")}, kurzum: in der ganzen Region
        Winterthur und im Zürcher Oberland.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container faq-wrap">
      <header class="section-head" data-reveal>
        <span class="eyebrow">FAQ</span>
        <h2>Die wichtigsten Fragen, ehrlich beantwortet</h2>
      </header>
      <div class="faq" data-reveal>
        {
          faq.map((f, i) => (
            <details class="faq-item" name="faq" open={i === 0}>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <LocalTrust />

  <section class="section section--yellow">
    <div class="container lp-cta" data-reveal>
      <h2>Bereit für deinen neuen Webauftritt in Winterthur?</h2>
      <Button href="/kontakt/" variant="blue">Schriib eus</Button>
    </div>
  </section>

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faq.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    })}
  />
</Layout>

<style>
  .lp-blocks { display: flex; flex-direction: column; gap: clamp(2.5rem, 5vw, 4.5rem); }
  .lp-block { display: grid; grid-template-columns: 1fr 2fr; gap: clamp(1rem, 3vw, 3rem); align-items: start; }
  .lp-block h2 { position: sticky; top: 100px; }
  .lp-text p { color: var(--color-blue); font-size: 1.1rem; line-height: 1.7; margin-bottom: 1rem; }
  .lp-text a { color: var(--color-blue); text-decoration: underline; text-underline-offset: 0.15em; }

  .orte { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(0.75rem, 2vw, 1.5rem); }
  .ort-card {
    display: flex; flex-direction: column; gap: 0.3rem;
    background: #fff; border: 1px solid #e7ecf3; padding: clamp(1.25rem, 2.5vw, 1.75rem);
    transition: border-color 0.3s var(--ease), transform 0.3s var(--ease);
  }
  .ort-card:hover { border-color: var(--color-blue); transform: translateY(-2px); }
  .ort-name { font-weight: 700; font-size: 1.25rem; color: var(--color-blue); }
  .ort-note { color: var(--color-blue); opacity: 0.8; font-size: 0.95rem; }
  .orte-note { margin-top: 1.5rem; color: var(--color-blue); line-height: 1.7; max-width: 75ch; }

  .faq-wrap { max-width: 860px; }
  .faq-item { border-bottom: 1px solid rgba(1, 64, 128, 0.2); }
  .faq-item summary {
    cursor: var(--cur-hand); list-style: none; padding: 1.1rem 0;
    font-weight: 700; color: var(--color-blue); font-size: 1.15rem;
    display: flex; justify-content: space-between; gap: 1rem;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: "+"; display: inline-flex; align-items: center; justify-content: center; width: 1em; height: 1em; line-height: 1; transform-origin: center; font-weight: 700; transition: transform 0.3s var(--ease); }
  .faq-item[open] summary::after { transform: rotate(45deg); }
  .faq-item p { color: var(--color-blue); line-height: 1.7; padding-bottom: 1.1rem; max-width: 70ch; }
  .lp-cta { display: flex; flex-direction: column; align-items: flex-start; gap: 1.25rem; }

  @media (max-width: 900px) {
    .orte { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 760px) {
    .lp-block { grid-template-columns: 1fr; }
    .lp-block h2 { position: static; }
  }
  @media (max-width: 520px) {
    .orte { grid-template-columns: 1fr; }
  }
</style>
