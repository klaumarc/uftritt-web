---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Button from "../components/Button.astro";
import LocalTrust from "../components/LocalTrust.astro";
import OfferLink from "../components/OfferLink.astro";
import TeamSection from "../components/TeamSection.astro";
import Reviews from "../components/Reviews.astro";
import { projects } from "../data/projects";

const cases = projects.filter((p) =>
  ["emotion-hinwil", "stahel-koeng", "cynterim", "dtb-redesign", "beat-brugger", "architekturmacher"].includes(p.slug)
);

const faq = [
  { q: "Was kostet ein Logo oder Corporate Design?", a: "Das hängt vom Umfang ab: Logo allein, oder das ganze Erscheinungsbild mit Farbwelt, Typografie und Drucksachen. Nach einem kostenlosen Erstgespräch erhältst du ein transparentes Angebot mit klarem Preis, ohne versteckte Kosten." },
  { q: "Gestaltet ihr auch nur eine Broschüre oder einen Flyer?", a: "Klar, es muss nicht immer das komplette Branding sein. Wir gestalten einzelne Drucksachen genauso sorgfältig wie ganze Auftritte." },
  { q: "Kommst du zu uns in die Region?", a: "Gerne, unser Büro ist in Saland, und wir sind in wenigen Minuten in Wetzikon, Hinwil, Bauma, Rüti oder Pfäffikon. Persönliche Besprechungen sind bei uns Standard." },
  { q: "Was ist, wenn wir schon ein Logo haben?", a: "Dann bauen wir darauf auf: Wir können bestehende Logos behutsam modernisieren oder das fehlende Drumherum ergänzen, Farben, Typografie, Vorlagen. So wie beim Unihockeyverein emotion Hinwil." },
];
---

<Layout
  title="Grafikdesign Zürcher Oberland, Uftritt"
  description="Grafikdesign im Zürcher Oberland: Logo, Corporate Design und Editorial Design für KMU, von der Agentur aus Saland. Echte Cases aus Hinwil und Bauma."
>
  <PageHero
    eyebrow="Grafikdesign · Zürcher Oberland"
    title={"Grafik­design im\nZürcher Oberland"}
    lead="Uftritt ist die Kommunikationsagentur aus Saland für Grafikdesign im Zürcher Oberland: Logo, Corporate Design und Editorial Design für KMU aus Wetzikon, Hinwil, Bauma und Umgebung, von der ersten Idee bis zur fertigen Drucksache, alles aus einer Hand."
    lottie="/lottie/grafikdesign.json"
    lottieLabel="Grafikdesign"
  >
    <div slot="hero-extra" class="hero-ctas">
      <Button href="/kontakt/" variant="blue">Kostenloses Erstgespräch</Button>
      <Button href="/projekte/" variant="text">Projekte ansehen</Button>
    </div>
  </PageHero>

  <OfferLink href="/angebot/grafikdesign/" label="Grafikdesign" lottie="/lottie/grafikdesign.json" projects={cases} />

  <section class="section">
    <div class="container lp-blocks">
      <article class="lp-block" data-reveal>
        <h2>Marken aus der Region</h2>
        <div class="lp-text">
          <p>
            Das pinke Erscheinungsbild von emotion Hinwil, das Jubiläumslogo für die
            Schreinerei Stahel + Köng, der Auftritt des Salesforce-Partners Cynterim -
            alles Markenarbeit aus unserem Büro in Saland, für Betriebe aus dem
            Zürcher Oberland.
          </p>
          <p>
            Wir kennen die Region und ihre Gewerbetreibenden. Darum sieht unsere Arbeit
            nicht nach Agentur-Hochglanz von weither aus, sondern nach dir, passend
            zu deinen Kundinnen und Kunden vor Ort.
          </p>
        </div>
      </article>
      <article class="lp-block" data-reveal>
        <h2>Vom Logo bis zum Magazin</h2>
        <div class="lp-text">
          <p>
            Bei uns bekommst du das ganze Handwerk aus einer Hand: Logo und Corporate
            Design, Visitenkarten und Briefschaften, Broschüren, Flyer, Plakate -
            und auf Wunsch die komplette Betreuung deines Kunden- oder Vereinsmagazins.
          </p>
          <p>
            Und weil wir auch Websites, Fotografie und Video selbst machen, bleibt
            dein Auftritt über alle Kanäle konsistent, ohne Schnittstellenchaos.
          </p>
        </div>
      </article>
    </div>
  </section>

  <TeamSection />

  <section class="section">
    <div class="container faq-wrap">
      <header class="section-head" data-reveal>
        <span class="eyebrow">FAQ</span>
        <h2>Die wichtigsten Fragen, ehrlich beantwortet</h2>
      </header>
      <div class="faq" data-reveal>
        {
          faq.map((f, i) => (
            <details class="faq-item" name="faq" open={i === 0}>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <LocalTrust check={false} />

  <section class="section">
    <div class="container">
      <Reviews />
    </div>
  </section>

  <section class="section section--yellow">
    <div class="container lp-cta" data-reveal>
      <h2>Bereit für deinen neuen Look?</h2>
      <Button href="/kontakt/" variant="blue">Schriib eus</Button>
    </div>
  </section>

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faq.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    })}
  />
</Layout>

<style>
  .lp-blocks { display: flex; flex-direction: column; gap: clamp(2.5rem, 5vw, 4.5rem); }
  .lp-block { display: grid; grid-template-columns: 1fr 2fr; gap: clamp(1rem, 3vw, 3rem); align-items: start; }
  .lp-block h2 { position: sticky; top: 100px; }
  .lp-text p { color: var(--color-blue); font-size: 1.1rem; line-height: 1.7; margin-bottom: 1rem; }

  .faq-wrap { max-width: 860px; }
  .faq-item { border-bottom: 1px solid rgba(1, 64, 128, 0.2); }
  .faq-item summary {
    cursor: var(--cur-hand); list-style: none; padding: 1.1rem 0;
    font-weight: 700; color: var(--color-blue); font-size: 1.15rem;
    display: flex; justify-content: space-between; gap: 1rem;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: "+"; display: inline-flex; align-items: center; justify-content: center; width: 1em; height: 1em; line-height: 1; transform-origin: center; font-weight: 700; transition: transform 0.3s var(--ease); }
  .faq-item[open] summary::after { transform: rotate(45deg); }
  .faq-item p { color: var(--color-blue); line-height: 1.7; padding-bottom: 1.1rem; max-width: 70ch; }
  .lp-cta { display: flex; flex-direction: column; align-items: flex-start; gap: 1.25rem; }

  @media (max-width: 760px) {
    .lp-block { grid-template-columns: 1fr; }
    .lp-block h2 { position: static; }
  }
</style>
