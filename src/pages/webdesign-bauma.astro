---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Button from "../components/Button.astro";
import LocalTrust from "../components/LocalTrust.astro";
import OfferLink from "../components/OfferLink.astro";
import { projects } from "../data/projects";

const cases = projects.filter((p) =>
  ["physio-rothe", "100pro-openair-2024", "it-stall"].includes(p.slug)
);

const orte = [
  { name: "Saland", href: "/webdesign-saland/", note: "hier sind wir zuhause" },
  { name: "Tösstal", href: "/webdesign-toesstal/", note: "unsere Heimregion" },
  { name: "Wetzikon", href: "/webdesign-wetzikon/", note: "grösste Stadt der Region" },
  { name: "Hinwil", href: "/webdesign-hinwil/", note: "Bezirkshauptort am Bachtel" },
  { name: "Bäretswil", href: "/webdesign-baeretswil/", note: "zwischen Glatt- und Tösstal" },
  { name: "Wald", href: "/webdesign-wald/", note: "Gewerbeort im Jonatal" },
];

const weitere = ["Turbenthal", "Fischenthal", "Wila", "Wildberg", "Hittnau", "Sternenberg"];

const faq = [
  { q: "Was kostet eine Website für einen Betrieb in Bauma?", a: "Das hängt vom Umfang ab, vom Onepager bis zur grösseren Plattform. Nach einem kostenlosen Erstgespräch erhältst du ein transparentes Angebot mit klarem Preis. Ohne Kleingedrucktes." },
  { q: "Kommst du zu uns nach Bauma?", a: "Gerne, unser Büro ist selbst in der Gemeinde Bauma, in Saland. Näher geht es nicht: In fünf Minuten sind wir bei dir." },
  { q: "Lohnt sich eine eigene Website auch für ein kleines Gewerbe?", a: "Ja. Gerade im Tösstal googeln Kundinnen und Kunden zuerst, eine klare, schnelle Website mit Öffnungszeiten, Leistungen und Kontakt wirkt rund um die Uhr. Wir sagen dir ehrlich, was sich lohnt und was nicht." },
  { q: "Werde ich als Baumer Betrieb überhaupt gefunden?", a: "Nur mit einer Website allein ist es nicht getan, aber fast: Wir liefern jede Website mit sauberer SEO-Basis aus (Struktur, Ladezeiten, Meta-Texte, Google-Anmeldung). Dazu gehört ein gepflegtes Google-Unternehmensprofil, damit wirst du in Bauma und Umgebung gefunden, auch auf der Karte." },
  { q: "Wir haben schon eine Website, lohnt sich ein Relaunch?", a: "Oft ja: Wenn die Seite älter als vier, fünf Jahre ist, auf dem Handy hakt oder bei Google abrutscht, bringt ein Relaunch mehr als Flickwerk. Wir schauen uns deine Seite kostenlos an und sagen dir ehrlich, ob sich ein Neubau lohnt." },
  { q: "Wer kümmert sich nach dem Launch um die Website?", a: "Auf Wunsch wir: Updates, Backups, kleine Anpassungen und laufende Betreuung, damit die Seite sicher bleibt und wächst. Oder wir zeigen dir, wie du Inhalte selbst pflegst." },
  { q: "Wie lange dauert ein Website-Projekt?", a: "Je nach Umfang 4 bis 12 Wochen, du siehst früh einen klickbaren Prototypen." },
];
---

<Layout
  title="Webdesign Bauma, Uftritt"
  description="Webdesign für Bauma: Websites für KMU, Gewerbe und Vereine im oberen Tösstal, von der Agentur aus Saland, fünf Minuten entfernt. Persönlich und ohne Template."
  noindex={true}
>
  <PageHero
    eyebrow="Webdesign · Bauma"
    title={"Webdesign\nBauma"}
    lead="Du suchst Webdesign in Bauma? Uftritt ist die Kommunikationsagentur aus Saland, wir entwickeln Websites für KMU, Gewerbe und Vereine in Bauma und im ganzen Tösstal: persönlich, ehrlich und ohne Template. Näher an dir geht es nicht."
    lottie="/lottie/webdesign.json"
    lottieLabel="Webdesign"
  >
    <div slot="hero-extra" class="hero-ctas">
      <Button href="/kontakt/" variant="blue">Kostenloses Erstgespräch</Button>
      <Button href="/projekte/" variant="text">Projekte ansehen</Button>
    </div>
  </PageHero>

  <OfferLink href="/angebot/webdesign/" label="Webdesign und Entwicklung" lottie="/lottie/webdesign.json" projects={cases} />

  <section class="section">
    <div class="container lp-blocks">
      <article class="lp-block" data-reveal>
        <h2>Fürs obere Tösstal</h2>
        <div class="lp-text">
          <p>
            Die Gemeinde Bauma, seit der Fusion mit Sternenberg rund 5000 Einwohnerinnen
            und Einwohner, liegt im oberen Tösstal, gezeichnet von der Töss, den
            Festhütten und einem Gewerbe, das die Region versorgt. Wir gehören selbst
            dazu: Unser Büro ist in Saland, an der Frauwisstrasse 9.
          </p>
          <p>
            Für dich heisst das: Die Agentur ist keine anonyme Adresse in der Stadt,
            sondern nur fünf Minuten entfernt. Besprechungen bei dir im Betrieb sind
            bei uns Alltag, nicht die Ausnahme.
          </p>
        </div>
      </article>
      <article class="lp-block" data-reveal>
        <h2>Aus Bauma kennst du uns vielleicht schon</h2>
        <div class="lp-text">
          <p>
            Für die Physiotherapie &amp; Sport-Reha in Bauma haben wir die Website neu
            gebaut, inklusive Fotografie der Praxis und des Teams. Und das 100pro
            Openair, das im Tösstal jedes Jahr die Festwirtschaft füllt, läuft mit
            einem kompletten Marketingpaket von uns: Erscheinungsbild, Website,
            Print-Werbung und Social Media.
          </p>
          <p>
            Ob Praxis, Gewerbebetrieb oder Vereinsanlass: Wir wissen, wie Kommunikation
            im Tösstal funktioniert, weil wir selbst hier leben und arbeiten.
          </p>
        </div>
      </article>
      <article class="lp-block" data-reveal>
        <h2>Webseite erstellen lassen, bei der Webagentur von nebenan</h2>
        <div class="lp-text">
          <p>
            Was muss eine Website für einen Baumer Betrieb leisten? In erster Linie
            dies: Wer nach dir sucht, findet dich, mit Leistungen, Öffnungszeiten und
            Kontakt auf einen Blick, auf dem Handy genauso wie am Computer. Und wer
            noch nicht nach dir sucht, soll dich über Google entdecken können. Genau
            dafür bauen wir: schnell, klar strukturiert und mit der SEO-Basis gleich
            mitgeliefert.
          </p>
          <p>
            Uftritt ist dabei mehr als eine Webagentur: Als Werbeagentur decken wir
            ab, was darüber hinausgeht, Logo und Erscheinungsbild, Printwerbung,
            Video und die laufende Betreuung deiner Kommunikation. Ein Partner für
            alles, statt fünf Ansprechpersonen für fünf Disziplinen.
          </p>
          <p>
            Und wir sagen es auch, wenn weniger genügt: Für viele Betriebe im Tösstal
            ist ein gut gemachter Onepager die richtige Lösung, kein Grossprojekt.
          </p>
        </div>
      </article>
      <article class="lp-block" data-reveal>
        <h2>In vier Schritten zur neuen Website</h2>
        <div class="lp-text">
          <p>
            <strong>1. Erstgespräch bei dir.</strong> Kostenlos und unverbindlich, am
            liebsten bei dir im Betrieb in Bauma, auf Wunsch auch bei uns in Saland
            oder per Video-Call. Wir hören zu, fragen nach und beraten ehrlich.
          </p>
          <p>
            <strong>2. Konzept und Prototyp.</strong> Du bekommst früh einen klickbaren
            Entwurf zu sehen, nicht erst am Ende. So gibt es keine Überraschungen.
          </p>
          <p>
            <strong>3. Umsetzung.</strong> Wir bauen die Seite, schreiben auf Wunsch
            die Texte und organisieren Fotografie, alles aus einer Hand.
          </p>
          <p>
            <strong>4. Launch und Betreuung.</strong> Nach dem Go-Live lassen wir dich
            nicht im Stich: <a href="/website-betreuung/">Betreuung und Wartung</a>,
            <a href="/seo-betreuung/">SEO-Begleitung</a> oder Schulung, damit du die
            Seite selbst pflegen kannst. Du hast eine ältere Website? Dann ist ein
            <a href="/website-relaunch/">Relaunch</a> der richtige Einstieg.
          </p>
        </div>
      </article>
      <article class="lp-block" data-reveal>
        <h2>Auch für Vereine und Anlässe</h2>
        <div class="lp-text">
          <p>
            Bauma lebt von seinen Vereinen, den Festhütten, dem Gewerbeverein, den
            Sportclubs. Wir kennen diese Welt von innen: Als Mitglied des
            Gewerbevereins Bauma und als Partner von Anlässen wie dem 100pro Openair
            wissen wir, wie Vereinskommunikation mit kleinen Budgets funktioniert.
          </p>
          <p>
            Von der Vereins-Website über das Sponsoring-Dossier bis zum Plakat für
            den nächsten Anlass: Gerade für Vereine machen wir viel mit wenig -
            und sagen ehrlich, welche Massnahmen sich lohnen.
          </p>
        </div>
      </article>
      <article class="lp-block" data-reveal>
        <h2>Was kostet das?</h2>
        <div class="lp-text">
          <p>
            Die ehrliche Antwort: Es kommt darauf an, was du brauchst, ein Onepager
            kostet weniger als eine Plattform mit Shop. Pauschalpreise von der Stange
            wären unseriös. Was wir stattdessen anbieten: Nach dem kostenlosen
            Erstgespräch erhältst du ein transparentes Angebot mit allen Leistungen
            und einem klaren Preis.
          </p>
          <p>
            Zur Orientierung vorab: In unserem <a href="/website-kosten/">Guide zu
            Website-Kosten</a> zeigen wir echte Marktpreise in der Schweiz, damit du
            weisst, was eine Website kosten darf, bevor du mit uns oder einer anderen
            Agentur sprichst.
          </p>
        </div>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <header class="section-head" data-reveal>
        <span class="eyebrow">In deiner Nähe</span>
        <h2>Webdesign in deinem Ort</h2>
      </header>
      <div class="orte" data-reveal>
        {
          orte.map((o) => (
            <a class="ort-card" href={o.href}>
              <span class="ort-name">{o.name}</span>
              <span class="ort-note">{o.note}</span>
            </a>
          ))
        }
      </div>
      <p class="orte-note" data-reveal>
        Und natürlich auch in: {weitere.join(", ")}, kurzum: im ganzen Tösstal und
        Zürcher Oberland.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container faq-wrap">
      <header class="section-head" data-reveal>
        <span class="eyebrow">FAQ</span>
        <h2>Die wichtigsten Fragen, ehrlich beantwortet</h2>
      </header>
      <div class="faq" data-reveal>
        {
          faq.map((f, i) => (
            <details class="faq-item" name="faq" open={i === 0}>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <LocalTrust />

  <section class="section section--yellow">
    <div class="container lp-cta" data-reveal>
      <h2>Bereit für deinen neuen Webauftritt in Bauma?</h2>
      <Button href="/kontakt/" variant="blue">Schriib eus</Button>
    </div>
  </section>

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faq.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    })}
  />
</Layout>

<style>
  .lp-blocks { display: flex; flex-direction: column; gap: clamp(2.5rem, 5vw, 4.5rem); }
  .lp-block { display: grid; grid-template-columns: 1fr 2fr; gap: clamp(1rem, 3vw, 3rem); align-items: start; }
  .lp-block h2 { position: sticky; top: 100px; }
  .lp-text p { color: var(--color-blue); font-size: 1.1rem; line-height: 1.7; margin-bottom: 1rem; }
  .lp-text a { color: var(--color-blue); text-decoration: underline; text-underline-offset: 0.15em; }

  .orte { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(0.75rem, 2vw, 1.5rem); }
  .ort-card {
    display: flex; flex-direction: column; gap: 0.3rem;
    background: #fff; border: 1px solid #e7ecf3; padding: clamp(1.25rem, 2.5vw, 1.75rem);
    transition: border-color 0.3s var(--ease), transform 0.3s var(--ease);
  }
  .ort-card:hover { border-color: var(--color-blue); transform: translateY(-2px); }
  .ort-name { font-weight: 700; font-size: 1.25rem; color: var(--color-blue); }
  .ort-note { color: var(--color-blue); opacity: 0.8; font-size: 0.95rem; }
  .orte-note { margin-top: 1.5rem; color: var(--color-blue); line-height: 1.7; max-width: 75ch; }

  .faq-wrap { max-width: 860px; }
  .faq-item { border-bottom: 1px solid rgba(1, 64, 128, 0.2); }
  .faq-item summary {
    cursor: var(--cur-hand); list-style: none; padding: 1.1rem 0;
    font-weight: 700; color: var(--color-blue); font-size: 1.15rem;
    display: flex; justify-content: space-between; gap: 1rem;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: "+"; display: inline-flex; align-items: center; justify-content: center; width: 1em; height: 1em; line-height: 1; transform-origin: center; font-weight: 700; transition: transform 0.3s var(--ease); }
  .faq-item[open] summary::after { transform: rotate(45deg); }
  .faq-item p { color: var(--color-blue); line-height: 1.7; padding-bottom: 1.1rem; max-width: 70ch; }
  .lp-cta { display: flex; flex-direction: column; align-items: flex-start; gap: 1.25rem; }

  @media (max-width: 900px) {
    .orte { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 760px) {
    .lp-block { grid-template-columns: 1fr; }
    .lp-block h2 { position: static; }
  }
  @media (max-width: 520px) {
    .orte { grid-template-columns: 1fr; }
  }
</style>
