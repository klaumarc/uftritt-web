---
import Layout from "../layouts/Layout.astro";
import SubHero from "../components/SubHero.astro";
import TeamSection from "../components/TeamSection.astro";
import Spiel from "../components/Spiel.astro";
---

<Layout title="Agentur, Uftritt" description="Wir sind Uftritt, die Kommunikationsagentur im Zürcher Oberland. Keine Krawatten, dafür echte Begeisterung.">
  <SubHero
    eyebrow="Agentur"
    title="Das sind wir"
    lead="Wir sind Uftritt, die Kommunikationsagentur, bei der du keine Krawatten, dafür echte Begeisterung findest. Wir lieben es, gemeinsam mit dir kreative Projekte zu starten und mindestens eine, wenn nicht mehr Stufen auf der Erfolgstreppe zu erklimmen."
    lottie="/lottie/agentur-smile.json"
    lottieLabel="Uftritt Smile"
  />

  <section class="section">
    <div class="container so-sind-wir" data-reveal>
      <div class="so-sind-wir-text">
        <span class="eyebrow">Unser Kern</span>
        <h2>Aufschwung mit Tiefgang</h2>
        <p>
          Uftritt steht für visuelle Kommunikation mit Substanz. Wir verbinden
          fundiertes, durchdachtes Design mit digitaler Power und einer
          unkomplizierten Zusammenarbeit. So wird deine Marke sichtbar, spürbar
          und sie bleibt im Gedächtnis.
        </p>
        <p>
          Als kleine, aber feine Agentur mit jungen, neugierigen Menschen und
          neuen und kreativen Ideen freuen wir uns immer wieder auf neue
          Herausforderungen. Im Oktober 2023 durch Marcel Klausberger und Jeffrey
          Meier gegründet, hat sich die Uftritt GmbH inzwischen zu einer
          ernstzunehmenden Adresse im Bereich der <a href="/angebot/">visuellen
          Kommunikation</a> entwickelt. Wir lieben Menschen und möchten mit
          unserer Arbeit Identität stiften, Werkzeuge für deine effektive
          Kommunikation entwickeln und damit zu deinem Unternehmenserfolg
          beitragen, von der Start-up-Idee bis zum bewährten mittelgrossen
          Unternehmen.
        </p>
      </div>
      <figure class="so-sind-wir-media">
        <img
          src="/agentur/uftritt-buero-saland-1.jpg"
          alt="Blick in unser Büro in Saland, blaue Sessel, viel Grün und Arbeitsplätze am Fenster"
          loading="lazy"
        />
      </figure>
    </div>
  </section>

  <TeamSection />

  {/* ---------- SPIEL (Abschluss + CTA) ---------- */}
  <Spiel />
</Layout>

<style>
  .so-sind-wir {
    display: grid;
    grid-template-columns: 1fr 0.85fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  .so-sind-wir-text {
    max-width: 60ch;
  }
  .so-sind-wir .eyebrow {
    display: block;
    margin-bottom: 0.5rem;
  }
  .so-sind-wir-media {
    margin: 0;
  }
  .so-sind-wir-media img {
    width: 100%;
    aspect-ratio: 3 / 2; /* Originalproportion (1600×1066), kein Beschnitt, Revision 2 */
    object-fit: cover;
    display: block;
  }
  @media (max-width: 860px) {
    .so-sind-wir {
      grid-template-columns: 1fr;
    }
  }
  .so-sind-wir p {
    color: var(--color-blue);
    font-size: 1.15rem;
    line-height: 1.7;
    margin-bottom: 1rem;
  }
  .so-sind-wir p a {
    color: var(--color-blue);
  }
  .so-sind-wir p a:hover {
    color: var(--color-pink);
  }
  .section-head {
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

</style>
