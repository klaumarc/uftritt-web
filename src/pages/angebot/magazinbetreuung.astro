---
import Layout from "../../layouts/Layout.astro";
import ProcessSteps from "../../components/ProcessSteps.astro";
import ServiceMarquee from "../../components/ServiceMarquee.astro";
import RefStrip from "../../components/RefStrip.astro";
import PageHero from "../../components/PageHero.astro";
import Button from "../../components/Button.astro";
import { projects } from "../../data/projects";

const bySlug = (slug: string) => projects.find((p) => p.slug === slug)!;
const portfolio = ["sam-focus", "dt-baeretswil", "youngstars-broschuere"].map(bySlug);

const blocks = [
  {
    title: "Redaktion und Konzept",
    text: [
      "Welche Themen bewegen deine Leserinnen und Leser? Gemeinsam entwickeln wir das inhaltliche Konzept, planen Rubriken und Ausgaben und sorgen dafür, dass jede Geschichte ihren Platz findet.",
      "So entsteht ein roter Faden, der sich durch einzelne Ausgaben und auch durch alle Erscheinungen zieht.",
      'Das gilt vor allem für das klassische <a href="/kundenmagazin/">Kundenmagazin</a>: Es hält deine Kundinnen und Kunden informiert und bleibt auf dem Tisch liegen, statt im Postfach unterzugehen.',
    ],
  },
  {
    title: "Gestaltung und Layout",
    text: [
      "Ein durchdachtes Layout führt durch die Seiten und macht Lust aufs Weiterblättern. Wir gestalten ein Erscheinungsbild, das zu deiner Marke passt, der Leserschaft klare Leitlinien und gleichzeitig grosszügigen Raum für jeden einzelnen Inhalt bietet.",
      "Bild und Text werden professionell bearbeitet und spielen mal mutig, mal dezent miteinander.",
    ],
  },
  {
    title: "Druckproduktion",
    text: [
      "Vom Reinzeichnen bis zur Druckabwicklung behalten wir Termine, Budget und Qualität im Blick. Gemeinsam mit der Druckerei deiner Wahl oder mit unseren Druckpartnern garantieren wir eine termingerechte Auslieferung.",
      "Auch die digitale Ausgabe des Magazins stellen wir dir optimiert zur Verfügung.",
    ],
  },
];

const steps = [
  { icon: "/img/icons/zuhoeren-icon.svg", t: "Zuhören und verstehen", d: "Wir lernen dich, dein Publikum und deine Ziele kennen und nehmen deine Themen auf." },
  { icon: "/img/icons/analyse-icon.svg", t: "Konzept und Redaktionsplan", d: "Wir strukturieren Inhalte, Rubriken und Ausgaben in einem klaren Redaktionsplan." },
  { icon: "/img/icons/brainstorm-icon.svg", t: "Gestaltung", d: "Wir entwickeln Layout und Bildsprache, ein Auftritt, der zu deiner Marke passt." },
  { icon: "/img/icons/austauschen-icon.svg", t: "Feinschliff und Korrektorat", d: "Du gibst Feedback, wir feilen an Text und Gestaltung, bis alles sitzt." },
  { icon: "/img/icons/abheben-icon.svg", t: "Produktion und Auslieferung", d: "Wir bereiten alles für den Druck oder die digitale Ausgabe vor und begleiten dich bis zum Erscheinen." },
];
---

<Layout title="Kundenmagazin erstellen lassen, Uftritt" description="Von der Redaktion über die Gestaltung bis zur Produktion, wir begleiten dein Magazin Ausgabe für Ausgabe.">
  <PageHero
    eyebrow="Angebot"
    title="Magazinbetreuung"
    lead="Ein Magazin ist eine grosse Bühne für deine Geschichten in haptisch erlebbarer Form. Von der ersten Idee über die Redaktion bis zur fertigen Ausgabe begleiten wir dein periodisch erscheinendes Medium Schritt für Schritt."
    lottie="/lottie/magazinbetreuung.json"
    lottieLabel="Magazinbetreuung"
  />

  <section class="section">
    <div class="container lp-blocks">
      {
        blocks.map((b) => (
          <article class="lp-block" data-reveal>
            <h2>{b.title}</h2>
            <div class="lp-text">{b.text.map((p) => <p set:html={p} />)}</div>
          </article>
        ))
      }
    </div>
  </section>

  {/* Das gestalten wir für dich */}
  <ServiceMarquee
    title="Von der Idee bis zur fertigen Ausgabe"
    terms={["Konzept", "Redaktion", "Text", "Layout", "Bildredaktion", "Illustration", "Inserate", "Druckvorstufe", "Korrektorat", "Distribution", "Themenplanung", "Interviews", "Reportagen", "Editorial Design", "Jubiläumsmagazine"]}
  />

  {/* Prozess */}
  <section class="section section--yellow">
    <div class="container">
      <header class="section-head" data-reveal>
        <span class="eyebrow">Unser Magazin-Prozess</span>
        <h2>Persönlich. Kreativ. Partnerschaftlich.</h2>
      </header>
      <ProcessSteps steps={steps} />
    </div>
  </section>


  {/* Referenzen */}
  <RefStrip title="Magazine und Editorials aus unserem Portfolio" projects={portfolio} />

  {/* Interne Verlinkung LP-Programm */}
  <section class="section">
    <div class="container mehr-dazu" data-reveal>
      <h2>Erfahre mehr</h2>
      <ul class="md-liste">
        <li><a href="/magazin-erstellen-lassen/">Magazin erstellen und drucken lassen</a></li>
        <li><a href="/vereinsmagazin/">Vereinsmagazin erstellen lassen</a></li>
      </ul>
    </div>
  </section>

  <section class="section section--yellow">
    <div class="container lp-cta" data-reveal>
      <h2>Bereit für deine nächste Ausgabe?</h2>
      <Button href="/kontakt/" variant="blue">Schriib eus</Button>
    </div>
  </section>
</Layout>

<style>
  .lp-blocks { display: flex; flex-direction: column; gap: clamp(2.5rem, 5vw, 4.5rem); }
  .lp-block { display: grid; grid-template-columns: 1fr 2fr; gap: clamp(1rem, 3vw, 3rem); align-items: start; }
  .lp-block h2 { position: sticky; top: 100px; }
  .lp-text p { color: var(--color-blue); font-size: 1.1rem; line-height: 1.7; margin-bottom: 1rem; }

  .section-head { margin-bottom: clamp(2rem, 4vw, 3rem); }

  .steps { display: grid; grid-template-columns: repeat(5, 1fr); gap: clamp(1rem, 2vw, 1.75rem); }
  .step { display: flex; flex-direction: column; align-items: flex-start; }
  .step-icon { width: 64px; height: 64px; margin-bottom: 0.9rem; }
  .step-no { display: block; width: 100%; border-bottom: 3px solid var(--color-blue); padding-bottom: 0.6rem; font-weight: 900; font-size: 1.6rem; color: var(--color-blue); margin-bottom: 0.5rem; }
  .step h3 { font-size: 1.1rem; color: var(--color-blue); margin-bottom: 0.4rem; }
  .step p { color: var(--color-blue); font-size: 0.95rem; line-height: 1.55; }

  .portfolio { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(0.5rem, 1.2vw, 0.9rem); }
  .ref-card { position: relative; display: block; aspect-ratio: 4 / 3; overflow: hidden; background: #eef2f7; }
  .ref-img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.85s var(--ease); }
  .ref-card:hover .ref-img, .ref-card:focus-visible .ref-img { transform: scale(1.05); }
  .ref-overlay {
    position: absolute; inset: 0; display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: 0.35rem; padding: 1.5rem;
    text-align: center; background: rgba(1, 64, 128, 0.82); color: #fff;
    opacity: 0; transition: opacity 0.5s var(--ease);
  }
  .ref-card:hover .ref-overlay, .ref-card:focus-visible .ref-overlay { opacity: 1; }
  .ref-cat { font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; opacity: 0.85; }
  .ref-title { font-size: clamp(1.1rem, 1.8vw, 1.5rem); font-weight: 700; line-height: 1.15; }
  .center-cta { margin-top: clamp(2.5rem, 5vw, 3.5rem); text-align: center; }

  .lp-cta { display: flex; flex-direction: column; align-items: flex-start; gap: 1.25rem; }

  @media (max-width: 900px) {
    .steps { grid-template-columns: repeat(2, 1fr); }
    .portfolio { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 760px) {
    .lp-block { grid-template-columns: 1fr; }
    .lp-block h2 { position: static; }
  }
  @media (max-width: 520px) {
    .steps { grid-template-columns: 1fr; }
    .portfolio { grid-template-columns: 1fr; }
  }
</style>
