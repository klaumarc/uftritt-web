---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Button from "../components/Button.astro";
import LocalTrust from "../components/LocalTrust.astro";
import OfferLink from "../components/OfferLink.astro";
import { projects } from "../data/projects";

const cases = projects
  .filter((p) =>
    ["it-stall", "smart-navigator", "seatalytics"].includes(p.slug)
  )
  .slice(0, 3);

const grundbedarf = [
  {
    title: "Leistungen verständlich erklärt",
    note: "Managed Services, Support-Abo, Cloud-Umzug: Deine Kundschaft kauft keinen Fachjargon, sondern ein Ergebnis. Pro Leistung eine klare Seite mit Nutzen, Ablauf und für wen sie gedacht ist.",
  },
  {
    title: "Vertrauen sichtbar machen",
    note: "IT vergibt man an Partner, denen man vertraut. Referenzen, Kundenstimmen und ein Team mit Gesichtern zeigen, wer dahinter steht, bevor das erste Gespräch stattfindet.",
  },
  {
    title: "Support-Anfragen entlasten",
    note: "Ein klares Anfrageformular mit Dringlichkeit, Antworten auf Standardfragen und eindeutige Kontaktwege nehmen Druck aus dem Telefonalltag und sortieren Anliegen vor.",
  },
  {
    title: "Fachkräfte gewinnen",
    note: "Gute Leute schauen sich vor der Bewerbung deine Website an. Offene Stellen, ein ehrlicher Einblick ins Team und klare Rahmenbedingungen entscheiden mit.",
  },
];

const prozess = [
  "Kostenloses Erstgespräch: Was verkaufst du, wer entscheidet, was ist schon da",
  "Struktur und Konzept: Leistungen, Referenzen, Support und Karriere am richtigen Platz",
  "Inhalte: Wir schreiben verständlich und ordnen ein, du prüfst die fachliche Tiefe",
  "Bau und Feinschliff: schnell, sicher und mobil zuerst, mit deinem Feedback",
  "Online und betreut: Für CHF 33 pro Monat bleiben wir auch nach dem Launch dran",
];

const faq = [
  {
    q: "Was kostet eine Website für ein IT-Unternehmen?",
    a: "Das hängt vom Umfang ab: Leistungsseiten, Referenzen, Karrierebereich und Wissensartikel treiben den Aufwand mehr als die Seitenzahl. Nach einem kostenlosen Erstgespräch bekommst du ein transparentes Angebot mit klarem Preis. Grössenordnungen aus Schweizer Quellen findest du auf unserer Seite <a href=\"/website-kosten/\">Website-Kosten</a>. Danach bleibt die Seite für CHF 33 pro Monat betreut.",
  },
  {
    q: "Wir sind selbst eine IT-Firma. Warum die Website nicht selbst bauen?",
    a: "Ehrlich gesagt: Wenn bei euch Zeit, Gestaltung und Textkompetenz frei sind, spricht nichts dagegen. In der Praxis gehen Kundenprojekte vor, und die eigene Site bleibt jahrelang liegen. Unser Teil ist die Arbeit, die im Alltag untergeht: Positionierung von aussen, Texte, die auch Nichttechniker verstehen, Gestaltung und ein sauberer Bau, den dein Team danach selbst pflegt.",
  },
  {
    q: "Unsere Leistungen sind komplex. Wie werden die auf einer Website verständlich?",
    a: "Mit zwei Ebenen: Oben steht der Nutzen für die entscheidende Geschäftsleitung, etwa planbare Kosten, weniger Ausfallzeiten und ein fester Ansprechpartner. Dahinter liegt die Tiefe für die Person, die dich technisch prüft: Referenzprojekte, konkrete Leistungsbeschreibungen, Wissensartikel. Wir schreiben die Texte verständlich, du prüfst die fachliche Korrektheit.",
  },
  {
    q: "Hilft die Website bei der Suche nach Fachkräften?",
    a: "Ja, mehr als viele denken: Bewerbende schauen sich deine Website an, bevor sie sich melden. Eine Karriereseite mit offenen Stellen, ehrlichen Einblicken ins Team und klaren Rahmenbedingungen entscheidet mit, ob sich jemand bewirkt. Wir bauen den Bereich so, dass du Stellen selbst eintragen und wieder herausnehmen kannst.",
  },
  {
    q: "Wie wichtig ist lokale Sichtbarkeit für einen IT-Dienstleister?",
    a: "Sehr wichtig: KMU suchen IT-Support in ihrer Nähe, weil jemand vor Ort sein soll, wenn es brennt. Suchanfragen wie IT-Support plus Ortschaft willst du gewinnen. Dafür braucht es klare Leistungsseiten, regionale Bezüge und ein gepflegtes Google Business Profile. Mehr dazu auf unserer Seite zu <a href=\"/local-seo/\">Local SEO</a>.",
  },
  {
    q: "Was passiert nach dem Launch?",
    a: "Die Seite geht online, und wir bleiben dran: Mit der <a href=\"/website-betreuung/\">Website-Betreuung</a> für CHF 33 pro Monat kümmern wir uns um Hosting, Updates und deine Änderungen, von der neuen Leistung bis zum Teamfoto. Willst du Inhalte selbst pflegen, bauen wir die Seite so, dass dein Team das ohne uns kann. Beides ist ehrlich gemeint.",
  },
];
---

<Layout
  title="Website für IT-Unternehmen - Uftritt"
  description="Website für IT-Unternehmen und Softwarefirmen: komplexe Leistungen verständlich erklärt, Referenzen, die Vertrauen schaffen, Support ohne Umweg."
>
  <PageHero
    eyebrow="Für IT-Dienstleister und Softwarefirmen"
    title={"Website für\nIT-Unternehmen und Softwarefirmen"}
    lead="Die kurze Antwort: Eine Website für ein IT-Unternehmen muss zwei Publikum gleichzeitig überzeugen: die Geschäftsleitung, die entscheidet, und die Technik, die prüft. Wir bauen sie so, dass komplexe Leistungen verständlich werden, Referenzen Vertrauen schaffen und Support-Anfragen ohne Umweg ankommen, vom Erstkontakt bis zum Notdienst."
    lottie="/lottie/webdesign.json"
    lottieLabel="Website für IT-Unternehmen"
  >
    <div slot="hero-extra" class="hero-ctas">
      <Button href="/kontakt/" variant="blue">Kostenloses Erstgespräch</Button>
      <Button href="/projekte/" variant="text">Projekte ansehen</Button>
    </div>
  </PageHero>

  <OfferLink href="/angebot/webdesign/" label="Webdesign und Entwicklung" lottie="/lottie/webdesign.json" projects={cases} />

  {/* Was die Seite braucht */}
  <section class="section">
    <div class="container">
      <header class="section-head" data-reveal>
        <span class="eyebrow">Das Fundament</span>
        <h2>Was eine Website für IT-Unternehmen können muss</h2>
      </header>
      <div class="karten karten--4" data-reveal>
        {
          grundbedarf.map((g) => (
            <article class="karte">
              <h3>{g.title}</h3>
              <p class="karte-note">{g.note}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* Zwei Publikum, ein Anspruch */}
  <section class="section section--soft">
    <div class="container lp-blocks">
      <article class="lp-block" data-reveal>
        <h2>Für Entscheider lesbar, für Prüfer tief genug</h2>
        <div class="lp-text">
          <p>
            Eine Website für ein IT-Unternehmen hat zwei Lesergruppen: Die
            Geschäftsleitung des potenziellen Kunden entscheidet, ob sie mit dir
            spricht. Die technische Person im Hintergrund prüft, ob du liefern
            kannst, was du versprichst. Beide müssen auf derselben Seite fündig
            werden.
          </p>
          <p>
            Darum bauen wir in Ebenen: Oben der Nutzen in Alltagssprache, etwa
            planbare Kosten, weniger Ausfallzeiten, ein fester Ansprechpartner.
            Dahinter die Tiefe für die Prüfenden: konkrete
            Leistungsbeschreibungen, Referenzprojekte und Wissensartikel, die
            zeigen, dass du dein Handwerk verstehst.
          </p>
        </div>
      </article>
      <article class="lp-block" data-reveal>
        <h2>Sicherheit und Datenschutz vorgelebt</h2>
        <div class="lp-text">
          <p>
            Wer IT-Sicherheit und Datenschutz verkauft, wird an der eigenen
            Website gemessen: aktuelle Technik, verschlüsselte Formulare, ein
            sauberer Umgang mit Cookies und Einwilligungen. Eine veraltete oder
            unsichere Seite kostet dich Glaubwürdigkeit, bevor das erste
            Gespräch stattfindet.
          </p>
          <p>
            Wir bauen darum mit demselben Anspruch, den deine Kundschaft von dir
            erwartet: aktuelle Software, das Schweizer Datenschutzgesetz im
            Blick und Formulare, die nur abfragen, was du wirklich brauchst.
            Barrierefreiheit gehört für uns ebenfalls dazu, damit alle deine
            Inhalte nutzen können.
          </p>
        </div>
      </article>
    </div>
  </section>

  {/* Cases */}
  <section class="section">
    <div class="container lp-blocks">
      <article class="lp-block" data-reveal>
        <h2>Gebaut für eine IT-Firma: it-stall</h2>
        <div class="lp-text">
          <p>
            Für die neu gegründete IT-Firma <a href="/projekte/it-stall/">it-stall</a>
            haben wir das komplette Erscheinungsbild gestaltet und eine einfache,
            übersichtliche Website entwickelt: Logo, Corporate Design und
            Webentwicklung aus einer Hand.
          </p>
          <p>
            Die Tonalität passt zum Angebot: der «IT-Partner von nebenan»,
            nahbar und unkompliziert statt Hochglanz und Fachjargon. Genau diese
            Positionierung trägt die Seite, vom ersten Absatz bis zum
            Kontaktformular.
          </p>
        </div>
      </article>
      <article class="lp-block" data-reveal>
        <h2>Komplexe Angebote, klar erzählt</h2>
        <div class="lp-text">
          <p>
            Nicht alle unsere Cases sind IT-Firmen, und das sagen wir offen: Für
            die Unternehmensberatung <a href="/projekte/smart-navigator/">smart
            navigator</a> haben wir von der Namensfindung über Logo und
            Briefschaften bis zur informativen Website alles aufgebaut. Für
            <a href="/projekte/seatalytics/">Seatalytics</a>, eine Expertin für
            Rollstuhlversorgung, war die Herausforderung, Fachleute und
            Privatpersonen gleichermassen abzuholen.
          </p>
          <p>
            Die Handwerksaufgabe dahinter ist dieselbe wie bei deiner Website:
            Ein komplexes, erklärungsbedürftiges Angebot so strukturieren, dass
            zwei verschiedene Publikum sofort verstehen, was es ihnen bringt.
          </p>
        </div>
      </article>
    </div>
  </section>

  {/* Ablauf und Betreuung */}
  <section class="section section--soft">
    <div class="container lp-blocks">
      <article class="lp-block" data-reveal>
        <h2>Der Ablauf in fünf Schritten</h2>
        <div class="lp-text">
          <ul class="modul-liste">
            {prozess.map((p, i) => <li><span class="modul-nr">{i + 1}</span>{p}</li>)}
          </ul>
        </div>
      </article>
      <article class="lp-block" data-reveal>
        <h2>Nach dem Launch bleiben wir dran</h2>
        <div class="lp-text">
          <p>
            IT-Dienstleister verkaufen Verlässlichkeit, also darf die eigene
            Website nicht verwaisten: Mit der <a href="/website-betreuung/">Website-Betreuung</a>
            für CHF 33 pro Monat kümmern wir uns um Hosting, Updates und deine
            Änderungen, von der neuen Leistung bis zum offenen Job.
          </p>
          <p>
            Übrigens: Wenn es bei dir oder deiner Kundschaft über die Website
            hinausgeht, kennen wir die Themen aus eigener Arbeit, von der
            <a href="/digitalisierung-kmu/">Digitalisierung für KMU</a> bis zur
            <a href="/ki-automatisierung/">KI-Automatisierung</a>. Und für
            kleine und mittlere Firmen allgemein bauen wir mit demselben
            Anspruch, mehr dazu unter <a href="/webdesign-fuer-kmu/">Webdesign
            für KMU</a>.
          </p>
        </div>
      </article>
    </div>
  </section>

  {/* FAQ */}
  <section class="section">
    <div class="container faq-wrap">
      <header class="section-head" data-reveal>
        <span class="eyebrow">FAQ</span>
        <h2>Häufige Fragen von IT-Unternehmen</h2>
      </header>
      <div class="faq" data-reveal>
        {
          faq.map((f, i) => (
            <details class="faq-item" name="faq" open={i === 0}>
              <summary>{f.q}</summary>
              <p set:html={f.a} />
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <LocalTrust check={false} />

  <section class="section section--yellow">
    <div class="container lp-cta" data-reveal>
      <h2>Zeit für eine Website, die so klar arbeitet wie dein Support?</h2>
      <p class="lp-cta-text">
        Erzähl uns in einem kostenlosen Erstgespräch, was dein IT-Unternehmen
        anbietet und wer deine Kundschaft ist. Wir sagen dir ehrlich, was eine
        Website bringen kann und was sie kostet.
      </p>
      <Button href="/kontakt/" variant="blue">Kostenloses Erstgespräch</Button>
    </div>
  </section>

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faq.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a.replace(/<[^>]*>/g, "") },
      })),
    })}
  />
</Layout>

<style>
  .karten { display: grid; gap: clamp(0.75rem, 2vw, 1.5rem); }
  .karten--3 { grid-template-columns: repeat(3, 1fr); }
  .karten--4 { grid-template-columns: repeat(4, 1fr); }
  .karte {
    display: flex; flex-direction: column; gap: 0.5rem;
    background: #fff; border: 1px solid #e7ecf3; padding: clamp(1.25rem, 2.5vw, 1.75rem);
  }
  .karte h3 { color: var(--color-blue); font-size: 1.15rem; }
  .karte-note { color: var(--color-blue); opacity: 0.85; font-size: 0.95rem; line-height: 1.6; margin: 0; }

  .lp-blocks { display: flex; flex-direction: column; gap: clamp(2.5rem, 5vw, 4.5rem); }
  .lp-block { display: grid; grid-template-columns: 1fr 2fr; gap: clamp(1rem, 3vw, 3rem); align-items: start; }
  .lp-block h2 { position: sticky; top: 100px; }
  .lp-text p { color: var(--color-blue); font-size: 1.1rem; line-height: 1.7; margin-bottom: 1rem; }
  .lp-text a { color: var(--color-blue); font-weight: 700; }
  .lp-text a:hover { color: var(--color-pink); }

  .modul-liste { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .modul-liste li {
    display: flex; align-items: baseline; gap: 0.9rem;
    padding: 0.8rem 0; border-bottom: 1px solid rgba(1, 64, 128, 0.15);
    color: var(--color-blue); font-size: 1.05rem; line-height: 1.5;
  }
  .modul-liste li:last-child { border-bottom: 0; }
  .modul-nr {
    flex: none; display: inline-flex; align-items: center; justify-content: center;
    width: 1.6em; height: 1.6em; background: var(--color-yellow); color: var(--color-blue);
    font-weight: 700; font-size: 0.9rem;
  }

  .faq-wrap { max-width: 860px; }
  .faq-item { border-bottom: 1px solid rgba(1, 64, 128, 0.2); }
  .faq-item summary {
    cursor: var(--cur-hand); list-style: none; padding: 1.1rem 0;
    font-weight: 700; color: var(--color-blue); font-size: 1.15rem;
    display: flex; justify-content: space-between; gap: 1rem;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: "+"; display: inline-flex; align-items: center; justify-content: center; width: 1em; height: 1em; line-height: 1; transform-origin: center; font-weight: 700; transition: transform 0.3s var(--ease); }
  .faq-item[open] summary::after { transform: rotate(45deg); }
  .faq-item p { color: var(--color-blue); line-height: 1.7; padding-bottom: 1.1rem; max-width: 70ch; }
  .lp-cta { display: flex; flex-direction: column; align-items: flex-start; gap: 1.25rem; }
  .lp-cta-text { color: var(--color-blue); font-size: 1.1rem; line-height: 1.7; max-width: 60ch; margin: 0; }

  @media (max-width: 900px) {
    .karten--3, .karten--4 { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 760px) {
    .lp-block { grid-template-columns: 1fr; }
    .lp-block h2 { position: static; }
  }
  @media (max-width: 520px) {
    .karten--3, .karten--4 { grid-template-columns: 1fr; }
  }
</style>
