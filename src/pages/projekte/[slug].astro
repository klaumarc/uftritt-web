---
import Layout from "../../layouts/Layout.astro";
import Button from "../../components/Button.astro";
import Lottie from "../../components/Lottie.astro";
import RefStrip from "../../components/RefStrip.astro";
import { projects } from "../../data/projects";
import { projectDetails } from "../../data/projectDetails";
import { projectStories } from "../../data/projectStories";
import { webpSrcSet } from "../../utils/img";

export function getStaticPaths() {
  return projects.map((p, i) => ({
    params: { slug: p.slug },
    props: {
      project: p,
      detail: projectDetails[p.slug] ?? { body: [], services: [], gallery: [] },
      story: projectStories[p.slug] ?? null,
      prev: projects[(i - 1 + projects.length) % projects.length],
      next: projects[(i + 1) % projects.length],
    },
  }));
}

const { project, detail, story, prev, next } = Astro.props;
const gallery = detail.gallery?.length ? detail.gallery : [project.image];
const services = story?.services ?? detail.services ?? [];
const intro = story?.intro ?? detail.body ?? [];
const website = story?.website ?? project.website ?? null;

// Meta-Description: Fliesstext auf SERP-taugliche Laenge kuerzen (Wortgrenze, ~155 Z.)
const truncate = (s: string, max = 155) =>
  s.length <= max ? s : s.slice(0, s.lastIndexOf(" ", max)).replace(/[.,;:\s]+$/, "") + " …";
const metaDescription = truncate(intro?.[0] ?? project.title);

// #1 Leistungen → Angebotsseiten verlinken (Keyword-Mapping; Unbekanntes bleibt Text)
const SERVICE_LINKS = [
  { re: /video|film|dreh|imagefilm/i, href: "/angebot/videoproduktion/" },
  { re: /app|applikation|software/i, href: "/angebot/applikationsentwicklung/" },
  { re: /web|website|ui|ux|online/i, href: "/angebot/webdesign/" },
  { re: /magazin|zeitschrift/i, href: "/angebot/magazinbetreuung/" },
  { re: /marketing|social|kampagne|werbung/i, href: "/angebot/marketingbegleitung/" },
  { re: /grafik|corporate|editorial|logo|branding|brosch|gestaltung|design/i, href: "/angebot/grafikdesign/" },
];
const serviceHref = (s: string) => SERVICE_LINKS.find((x) => x.re.test(s))?.href ?? null;

// #2 Ähnliche Projekte: gleiche Kategorie, max. 3
const relatedProjects = projects
  .filter((p) => p.slug !== project.slug && p.categories.some((c) => project.categories.includes(c)))
  .slice(0, 3);

// srcset-sizes: Hero/Full = volle Container-Breite (90vw), Split/Duo/Galerie-Rest
// = 2-spaltig (~45vw); Galerie <=520px 1-spaltig. Erste Galerie-Kachel Vollbreite.
const SIZES_FULL = "90vw";
const SIZES_HALF = "45vw";
const SIZES_GALLERY_FIRST = "90vw";
const SIZES_GALLERY_REST = "(max-width: 520px) 90vw, 45vw";
---

<Layout title={`${project.title}, Uftritt`} description={metaDescription}>
  <article class="pd">
    <div class="container">
      <nav class="pd-nav" data-reveal>
        <Button href="/projekte/" variant="text">Zur Übersicht</Button>
        <span class="pd-arrows">
          <a href={`/projekte/${prev.slug}/`} class="pd-arrow pd-arrow-prev" aria-label={`Vorheriges Projekt: ${prev.title}`}></a>
          <a href={`/projekte/${next.slug}/`} class="pd-arrow pd-arrow-next" aria-label={`Nächstes Projekt: ${next.title}`}></a>
        </span>
      </nav>

      <div class="pd-intro">
        <div class="pd-text" data-reveal>
          <span class="eyebrow">{project.categories.join(" · ")}</span>
          <h1>{project.title}</h1>
          {intro?.map((p) => <p>{p}</p>)}
        </div>
        {
          (services.length > 0 || website || story?.links) && (
            <aside class="pd-services" data-reveal>
              {services.length > 0 && (
                <>
                  <span class="pd-services-title">Leistungen</span>
                  <p class="pd-services-list">
                    {services.map((s, i) => {
                      const href = serviceHref(s);
                      return (
                        <>
                          {i > 0 && ", "}
                          {href ? <a href={href}>{s}</a> : <span>{s}</span>}
                        </>
                      );
                    })}
                  </p>
                </>
              )}
              {story?.links
                ? story.links.map((l) => (
                    <p class="pd-website">
                      <a href={l.href} target="_blank" rel="noopener">{l.label} ↗</a>
                    </p>
                  ))
                : website && (
                    <p class="pd-website">
                      <a href={website} target="_blank" rel="noopener">Zur Website ↗</a>
                    </p>
                  )}
            </aside>
          )
        }
      </div>
    </div>

    {
      story ? (
        <div class="pd-story">
          {story.blocks.map((b) =>
            b.type === "hero" ? (
              <div class="container">
                <div class="st-hero" data-reveal>
                  <picture>
                    {webpSrcSet(b.img) && <source type="image/webp" srcset={webpSrcSet(b.img)!} sizes={SIZES_FULL} />}
                    <img src={b.img} alt={b.alt ?? project.title} loading="lazy" decoding="async" />
                  </picture>
                </div>
              </div>
            ) : b.type === "text" ? (
              <div class="container">
                <div class="st-text" data-reveal>
                  {b.body.map((p) => <p>{p}</p>)}
                </div>
              </div>
            ) : b.type === "split" ? (
              <div class="container">
                <div class="st-split" data-reveal>
                  {[b.left, b.right].map((cell) => (
                    <figure class="st-cell">
                      <div class="st-media" style={cell.bg ? `background:${cell.bg}` : undefined}>
                        {cell.img && (
                          <picture>
                            {webpSrcSet(cell.img) && <source type="image/webp" srcset={webpSrcSet(cell.img)!} sizes={SIZES_HALF} />}
                            <img src={cell.img} alt={cell.alt ?? ""} class:list={[{ contain: cell.contain }]} loading="lazy" decoding="async" />
                          </picture>
                        )}
                        {cell.lottie && (
                          <div class="st-lottie">
                            <Lottie src={cell.lottie} loop={true} ariaLabel={cell.label ?? ""} />
                          </div>
                        )}
                      </div>
                    </figure>
                  ))}
                </div>
              </div>
            ) : b.type === "duo" ? (
              <div class="container">
                <div class="st-duo" data-reveal>
                  {b.cells.map((cell) => (
                    <figure class="st-cell">
                      <div class="st-media">
                        <picture>
                          {webpSrcSet(cell.img) && <source type="image/webp" srcset={webpSrcSet(cell.img)!} sizes={SIZES_HALF} />}
                          <img src={cell.img} alt={cell.alt ?? ""} loading="lazy" decoding="async" />
                        </picture>
                      </div>
                    </figure>
                  ))}
                </div>
              </div>
            ) : b.type === "slider" ? (
              <div class="container">
                <div class="st-slider" data-reveal data-st-slider aria-roledescription="Karussell" aria-label={b.label ?? project.title}>
                  <div class="st-slider-track">
                    {b.cells.map((cell) => (
                      <figure class="st-slide">
                        <picture>
                          {cell.img && webpSrcSet(cell.img) && <source type="image/webp" srcset={webpSrcSet(cell.img)!} sizes={SIZES_FULL} />}
                          {cell.img && <img src={cell.img} alt={cell.alt ?? ""} loading="lazy" decoding="async" draggable="false" />}
                        </picture>
                      </figure>
                    ))}
                  </div>
                  <div class="st-slider-ui">
                    <button type="button" class="st-slider-arrow st-slider-prev" aria-label="Vorheriges Bild"></button>
                    <span class="st-slider-dots">
                      {b.cells.map((cell, i) => (
                        <button type="button" class="st-slider-dot" data-index={i} aria-label={`Bild ${i + 1} von ${b.cells.length}: ${cell.alt ?? ""}`}></button>
                      ))}
                    </span>
                    <button type="button" class="st-slider-arrow st-slider-next" aria-label="Nächstes Bild"></button>
                  </div>
                </div>
              </div>
            ) : b.type === "tech" ? (
              <div class="container">
                <div class="st-tech" data-reveal>
                  {b.label && <span class="eyebrow">{b.label}</span>}
                  <dl class="st-tech-list">
                    {b.rows.map((r) => (
                      <div class="st-tech-row">
                        <dt>{r.name}</dt>
                        <dd>{r.desc}</dd>
                      </div>
                    ))}
                  </dl>
                </div>
              </div>
            ) : (
              /* full */
              <div class:list={["st-full", { grey: b.grey }]}>
                <div class="container">
                  <div class:list={["st-full-inner", { narrow: b.narrow }]} data-reveal>
                    {b.img && (
                      <picture>
                        {webpSrcSet(b.img) && <source type="image/webp" srcset={webpSrcSet(b.img)!} sizes={SIZES_FULL} />}
                        <img src={b.img} alt={b.alt ?? project.title} class:list={[{ contain: b.contain }]} loading="lazy" decoding="async" />
                      </picture>
                    )}
                    {b.video && (
                      <video src={b.video} muted loop playsinline preload="none" data-play-once></video>
                    )}
                    {b.youtube && (
                      <div class="st-embed">
                        <iframe
                          src={`https://www.youtube-nocookie.com/embed/${b.youtube}?rel=0`}
                          title={b.label ?? project.title}
                          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen"
                          loading="lazy"
                        />
                      </div>
                    )}
                    {b.lottie && (
                      <div class="st-lottie">
                        <Lottie src={b.lottie} loop={true} ariaLabel={b.label ?? ""} />
                      </div>
                    )}
                  </div>
                </div>
              </div>
            )
          )}
        </div>
      ) : (
        <>
          {gallery.length > 0 && (
            <div class="container pd-gallery">
              {gallery.map((img, i) => {
                const srcset = webpSrcSet(img);
                return (
                  <span class="pd-tile" data-reveal>
                    <picture>
                      {srcset && <source type="image/webp" srcset={srcset} sizes={i === 0 ? SIZES_GALLERY_FIRST : SIZES_GALLERY_REST} />}
                      <img src={img} alt={`${project.title}, Projektansicht ${i + 1}`} loading="lazy" decoding="async" />
                    </picture>
                  </span>
                );
              })}
            </div>
          )}
          {detail.youtube && (
            <div class="container pd-video" data-reveal>
              <div class="pd-embed">
                <iframe
                  src={`https://www.youtube-nocookie.com/embed/${detail.youtube}?rel=0`}
                  title={project.title}
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen"
                  loading="lazy"
                />
              </div>
            </div>
          )}
        </>
      )
    }

    {relatedProjects.length > 0 && (
      <div class="pd-related">
        <RefStrip title="Ähnliche Projekte" projects={relatedProjects} />
      </div>
    )}

    <div class="container pd-cta" data-reveal>
      <h2>Sollen wir auch deinen Auftritt umsetzen?</h2>
      <Button href="/kontakt/" variant="blue">Schriib eus</Button>
    </div>
  </article>
</Layout>

<script>
  // Website-Mockup-Video: einmal abspielen, wenn es in den Blick kommt (kein Loop).
  const vids = document.querySelectorAll<HTMLVideoElement>("video[data-play-once]");
  if (vids.length && "IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            (e.target as HTMLVideoElement).play().catch(() => {});
            obs.unobserve(e.target);
          }
        });
      },
      { threshold: 0.4 }
    );
    vids.forEach((v) => io.observe(v));
  }

  // Karussell (Auto-Loop): pausiert bei Hover/Fokus, kein Autoplay bei reduzierter Bewegung.
  document.querySelectorAll<HTMLElement>("[data-st-slider]").forEach((root) => {
    const track = root.querySelector<HTMLElement>(".st-slider-track");
    const slides = root.querySelectorAll<HTMLElement>(".st-slide");
    const dots = root.querySelectorAll<HTMLButtonElement>(".st-slider-dot");
    if (!track || slides.length < 2) return;
    let i = 0;
    let timer: number | undefined;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const go = (n: number) => {
      i = (n + slides.length) % slides.length;
      track.style.transform = `translateX(-${i * 100}%)`;
      dots.forEach((d, k) => d.classList.toggle("active", k === i));
    };
    const stop = () => {
      if (timer !== undefined) {
        clearInterval(timer);
        timer = undefined;
      }
    };
    const start = () => {
      if (!reduced && timer === undefined) timer = window.setInterval(() => go(i + 1), 4500);
    };
    root.querySelector<HTMLButtonElement>(".st-slider-prev")?.addEventListener("click", () => go(i - 1));
    root.querySelector<HTMLButtonElement>(".st-slider-next")?.addEventListener("click", () => go(i + 1));
    dots.forEach((d) => d.addEventListener("click", () => go(Number(d.dataset.index ?? 0))));
    root.addEventListener("pointerenter", stop);
    root.addEventListener("pointerleave", start);
    root.addEventListener("focusin", stop);
    root.addEventListener("focusout", start);
    // Wischen auf Touch-Geraeten
    let x0: number | null = null;
    track.addEventListener("pointerdown", (e) => {
      x0 = e.clientX;
    });
    track.addEventListener("pointerup", (e) => {
      if (x0 === null) return;
      const dx = e.clientX - x0;
      if (Math.abs(dx) > 40) go(i + (dx < 0 ? 1 : -1));
      x0 = null;
    });
    go(0);
    start();
  });
</script>

<style>
  .pd {
    padding-block: clamp(2rem, 5vw, 4rem) clamp(3rem, 7vw, 6rem);
  }
  .pd-related {
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
  }
  .pd-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: clamp(3rem, 6vw, 5rem);
    font-weight: 600;
  }
  .pd-arrows {
    display: flex;
    gap: 1.1rem;
  }
  .pd-arrow {
    width: 1.7rem;
    height: 1.7rem;
    display: inline-block;
    background: var(--color-blue);
    -webkit-mask: no-repeat center / contain;
    mask: no-repeat center / contain;
    transition: background 0.3s var(--ease);
  }
  .pd-arrow-prev {
    -webkit-mask-image: url("/img/icons/pfeil-links-blau.svg");
    mask-image: url("/img/icons/pfeil-links-blau.svg");
  }
  .pd-arrow-next {
    -webkit-mask-image: url("/img/icons/pfeil-rechts-blau.svg");
    mask-image: url("/img/icons/pfeil-rechts-blau.svg");
  }
  .pd-arrow:hover {
    background: var(--color-pink);
  }

  .pd-intro {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: start;
  }
  .pd-text .eyebrow {
    display: block;
    margin-bottom: 0.25rem;
  }
  .pd-text h1 {
    font-size: clamp(2rem, 4vw, 3.1rem);
    margin-bottom: 1.25rem;
  }
  .pd-text p {
    color: var(--color-blue);
    font-size: 1.1rem;
    line-height: 1.7;
    margin-bottom: 1rem;
  }
  .pd-services-title {
    display: block;
    font-weight: 700;
    color: var(--color-blue);
    margin-bottom: 0.75rem;
  }
  .pd-services-list {
    color: var(--color-blue);
    font-size: 1.05rem;
    line-height: 1.7;
    margin: 0;
  }
  .pd-services-list a {
    color: var(--color-blue);
  }
  .pd-services-list a:hover {
    color: var(--color-pink);
  }
  .pd-website {
    margin-top: 1.1rem;
  }
  .pd-website a {
    color: var(--color-blue);
    font-weight: 700;
  }
  .pd-website a:hover {
    color: var(--color-pink);
  }

  /* ---- Story-Layout (redaktionell, nach XD) ---- */
  .pd-story {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 6vw, 5rem);
  }
  /* picture-Wrapper (webp/srcset): keine eigene Box -> die img liegen
     layout-seitig weiter direkt in ihrem Container (Containing Block gleich) */
  picture {
    display: contents;
  }
  .st-hero img {
    width: 100%;
    display: block;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }
  .st-text {
    max-width: 680px;
    margin-inline: auto;
  }
  .st-text p {
    color: var(--color-blue);
    font-size: 1.15rem;
    line-height: 1.8;
    margin-bottom: 1rem;
  }
  .st-text p:last-child {
    margin-bottom: 0;
  }

  /* Tech-Stack als ruhige Tabelle (gleiche Spalte wie Fliesstext) */
  .st-tech {
    max-width: 680px;
    margin-inline: auto;
  }
  .st-tech .eyebrow {
    display: block;
    margin-bottom: 0.75rem;
  }
  .st-tech-list {
    margin: 0;
  }
  .st-tech-row {
    display: grid;
    grid-template-columns: minmax(150px, 1fr) 2fr;
    gap: 1rem;
    padding-block: 0.95rem;
    border-top: 1px solid #e7ecf3;
  }
  .st-tech-row:last-child {
    border-bottom: 1px solid #e7ecf3;
  }
  .st-tech-row dt {
    font-weight: 700;
    color: var(--color-blue);
  }
  .st-tech-row dd {
    margin: 0;
    color: var(--color-blue);
    font-size: 1.05rem;
    line-height: 1.65;
  }
  @media (max-width: 520px) {
    .st-tech-row {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }

  .st-split,
  .st-duo {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(0.75rem, 2vw, 1.5rem);
    align-items: start;
  }
  /* 3+ Zellen im Duo-Block: echte 3-Spalten-Reihe (z. B. Festfuehrer-Trio) */
  .st-duo:has(> :nth-child(3)) {
    grid-template-columns: 1fr 1fr 1fr;
  }
  /* YouTube-Embed in Story-Bloecken */
  .st-embed {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #000;
  }
  .st-embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  /* Karussell (Auto-Loop) */
  .st-slider {
    position: relative;
    overflow: hidden;
  }
  .st-slider-track {
    display: flex;
    transition: transform 0.55s var(--ease);
  }
  .st-slide {
    flex: 0 0 100%;
    margin: 0;
  }
  .st-slide img {
    width: 100%;
    display: block;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    user-select: none;
  }
  .st-slider-ui {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    margin-top: 0.9rem;
  }
  .st-slider-arrow {
    width: 1.7rem;
    height: 1.7rem;
    padding: 0;
    border: 0;
    cursor: pointer;
    background: var(--color-blue);
    -webkit-mask: no-repeat center / contain;
    mask: no-repeat center / contain;
    transition: background 0.3s var(--ease);
  }
  .st-slider-prev {
    -webkit-mask-image: url("/img/icons/pfeil-links-blau.svg");
    mask-image: url("/img/icons/pfeil-links-blau.svg");
  }
  .st-slider-next {
    -webkit-mask-image: url("/img/icons/pfeil-rechts-blau.svg");
    mask-image: url("/img/icons/pfeil-rechts-blau.svg");
  }
  .st-slider-arrow:hover {
    background: var(--color-pink);
  }
  .st-slider-dots {
    display: inline-flex;
    gap: 0.5rem;
  }
  .st-slider-dot {
    width: 0.6rem;
    height: 0.6rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    cursor: pointer;
    background: rgba(1, 64, 128, 0.25);
    transition: background 0.3s var(--ease);
  }
  .st-slider-dot.active {
    background: var(--color-pink);
  }
  .st-cell {
    margin: 0;
  }
  .st-media {
    aspect-ratio: 3 / 2; /* Bilder & Lotties sind 1500×1000 (3:2) */
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .st-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .st-media img.contain {
    object-fit: contain;
  }
  /* Lottie füllt dieselbe Box wie die Bilder (gleich gross) */
  .st-lottie {
    width: 100%;
    height: 100%;
  }

  .st-full.grey {
    background: #e9e9ea;
    padding-block: clamp(2rem, 5vw, 4.5rem);
  }
  .st-full-inner img,
  .st-full-inner video {
    width: 100%;
    display: block;
  }
  .st-full-inner img.contain {
    object-fit: contain;
  }
  /* Icons-Block: gleiche Grösse wie eine Bild-Kachel, zentriert */
  .st-full-inner.narrow {
    max-width: min(600px, 100%);
    margin-inline: auto;
  }
  .st-full-inner.narrow .st-lottie {
    aspect-ratio: 3 / 2;
  }

  /* alle Bilder als gleichmässige Kacheln (Fallback ohne Story) */
  .pd-gallery {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(0.5rem, 1.2vw, 0.9rem);
  }
  .pd-tile {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }
  /* Erstes Bild gross über die ganze Breite, Rest 2-spaltig */
  .pd-tile:first-child {
    grid-column: 1 / -1;
    aspect-ratio: 16 / 9;
  }
  .pd-tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .pd-video {
    margin-top: clamp(2rem, 4vw, 3rem);
  }
  .pd-embed {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #000;
  }
  .pd-embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .pd-cta {
    margin-top: clamp(3rem, 6vw, 5rem);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  @media (max-width: 860px) {
    .pd-intro {
      grid-template-columns: 1fr;
    }
    .pd-gallery {
      grid-template-columns: repeat(2, 1fr);
    }
