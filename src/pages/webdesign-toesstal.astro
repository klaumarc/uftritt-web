---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Button from "../components/Button.astro";
import LocalTrust from "../components/LocalTrust.astro";
import OfferLink from "../components/OfferLink.astro";
import { projects } from "../data/projects";

const cases = projects.filter((p) =>
  ["100pro-openair-2024", "physio-rothe", "it-stall"].includes(p.slug)
);

const orte = [
  { name: "Bauma", href: "/webdesign-bauma/", note: "Endstation der Dampfbahn" },
  { name: "Saland", href: "/webdesign-saland/", note: "hier sind wir zuhause" },
  { name: "Wald", href: "/webdesign-wald/", note: "Gewerbeort im Jonatal" },
  { name: "Wetzikon", href: "/webdesign-wetzikon/", note: "grösste Stadt der Region" },
  { name: "Hinwil", href: "/webdesign-hinwil/", note: "Bezirkshauptort am Bachtel" },
  { name: "Bäretswil", href: "/webdesign-baeretswil/", note: "zwischen Glatt- und Tösstal" },
];

const weitere = ["Turbenthal", "Wila", "Fischenthal", "Zell", "Rikon", "Kollbrunn", "Steg", "Gibswil"];

const faq = [
  { q: "Was kostet eine Website für einen Betrieb im Tösstal?", a: "Das hängt vom Umfang ab, vom schlanken Onepager bis zur Plattform mit Shop. Nach einem kostenlosen Erstgespräch erhältst du ein transparentes Angebot mit klarem Preis. Ohne Kleingedrucktes." },
  { q: "Kommt ihr zu uns ins Tösstal?", a: "Wir sind schon da: Unser Büro liegt an der Frauwisstrasse 9 in Saland, mitten im Dorf und mitten im Tal. Ob Bauma, Wila, Turbenthal oder Fischenthal, wir kommen gerne zu dir in den Betrieb, die Wege sind kurz. Auf Wunsch geht es auch per Video-Call." },
  { q: "Werde ich als Betrieb im Tösstal überhaupt gefunden?", a: "Ja, wenn die Basis stimmt: Wir liefern jede Website mit sauberer SEO-Grundausstattung aus, Struktur, Ladezeiten, Meta-Texte und Google-Anmeldung. Dazu gehört ein gepflegtes Google-Unternehmensprofil, damit dich die Kundschaft auch auf der Karte findet, egal ob im Dorf oder im Weiler." },
  { q: "Lohnt sich eine eigene Website auch für ein kleines Gewerbe?", a: "Ja. Die Kundschaft im Tal ist weit verteilt, und googelt zuerst. Eine klare, schnelle Website mit Leistungen, Öffnungszeiten und Kontakt wirkt rund um die Uhr. Wir sagen dir ehrlich, was sich lohnt und was nicht." },
  { q: "Wir haben schon eine Website, lohnt sich ein Relaunch?", a: "Oft ja: Wenn die Seite älter als vier, fünf Jahre ist, auf dem Handy hakt oder bei Google abrutscht, bringt ein Neubau mehr als Flickwerk. Wir schauen uns deine Seite kostenlos an und sagen dir ehrlich, ob sich ein Relaunch lohnt." },
  { q: "Macht ihr auch mehr als Websites?", a: "Ja: Logo, Corporate Design, Broschüren, Fotografie und Video kommen bei uns aus demselben Haus. Das 100pro Openair im Tösstal betreuen wir zum Beispiel komplett, vom Plakat bis zur Website." },
  { q: "Wie lange dauert ein Website-Projekt?", a: "Je nach Umfang 4 bis 12 Wochen, du siehst früh einen klickbaren Prototypen, nicht erst am Ende. Je schneller Inhalte und Entscheide da sind, desto schneller geht es." },
  { q: "Wer kümmert sich nach dem Launch um die Website?", a: "Auf Wunsch wir: Updates, Backups, kleine Anpassungen und laufende Betreuung, damit die Seite sicher bleibt und wächst. Oder wir schulen dich, damit du die Inhalte selbst pflegen kannst." },
];
---

<Layout
  title="Webdesign Tösstal, Uftritt"
  description="Webdesign fürs Tösstal: Webseite erstellen lassen bei der Agentur aus Saland, für KMU, Gewerbe und Vereine von Fischenthal bis Zell. Ohne Template."
>
  <PageHero
    eyebrow="Webdesign · Tösstal"
    title={"Webdesign\nTösstal"}
    lead="Du suchst Webdesign im Tösstal? Uftritt ist die Kommunikationsagentur mitten im Tal: Unser Büro liegt in Saland, zwischen Bauma und Wila. Wir entwickeln Websites für KMU, Gewerbe und Vereine im ganzen Tösstal, von Fischenthal bis Zell. Persönlich, ehrlich und ohne Template."
    lottie="/lottie/webdesign.json"
    lottieLabel="Webdesign"
  >
    <div slot="hero-extra" class="hero-ctas">
      <Button href="/kontakt/" variant="blue">Kostenloses Erstgespräch</Button>
      <Button href="/projekte/" variant="text">Projekte ansehen</Button>
    </div>
  </PageHero>

  <OfferLink href="/angebot/webdesign/" label="Webdesign und Entwicklung" lottie="/lottie/webdesign.json" projects={cases} />

  <section class="section">
    <div class="container lp-blocks">
      <article class="lp-block" data-reveal>
        <h2>Mitten im Tösstal zu Hause</h2>
        <div class="lp-text">
          <p>
            Das Tösstal ist keine Gemeinde, sondern eine Talschaft im Osten des
            Kantons Zürich, im alten Dialekt auch «Pirg» genannt. Von Fischenthal
            über Bauma und Saland bis Wila, Turbenthal und Zell zieht es sich
            entlang der Töss, mit der Bahn geht es weiter über Wald bis Rüti.
            Geprägt wurde das Tal von der Textilindustrie, die im 19. Jahrhundert
            die Wasserkraft des Flusses nutzte, und davor vom Schnitzen von
            Holzlöffeln, das der Region den Übernamen «Chelleland» einbrachte.
          </p>
          <p>
            Die Tösstalbahn verbindet die Orte seit 1876 mit Winterthur und
            Rapperswil, zwischen Bauma und Hinwil fährt bis heute die Dampfbahn.
            Geblieben ist auch das Gewerbe: Kleine und mittlere Betriebe,
            Handwerk und Landwirtschaft prägen das Tal, dazu ein Vereinsleben,
            das die Festhütten füllt.
          </p>
          <p>
            Und genau hier sind wir zuhause: an der Frauwisstrasse 9 in Saland, mitten
            im Dorf und mitten im Tal. Bei uns sprichst du nicht mit einer
            anonymen Stadtagentur, sondern mit Leuten, die selbst im Tösstal
            leben und arbeiten. Besprechungen finden bei dir im Betrieb statt,
            die Wege sind kurz. Unser Revier ist ohnehin das ganze
            <a href="/webdesign-zuercher-oberland/">Zürcher Oberland</a>.
          </p>
        </div>
      </article>
      <article class="lp-block" data-reveal>
        <h2>Im Tal schon gut sichtbar</h2>
        <div class="lp-text">
          <p>
            Das 100pro Openair, das christliche Musikfest, das im Tösstal die
            Festwirtschaft füllt, läuft mit dem kompletten Marketingpaket von
            uns: Erscheinungsbild, Website, Online-Ticketing, Print-Werbung,
            Social Media und Video, 2024 und wieder 2026.
          </p>
          <p>
            Für die Physiotherapie &amp; Sport-Reha in Bauma haben wir die
            Website neu gebaut, inklusive Fotos von Praxis und Team. Und für
            it-stall, das IT-Unternehmen hier in Saland, stammen Corporate Design
            und Website von uns.
          </p>
          <p>
            Wir sind nicht nur Dienstleister, sondern Teil des Tals: Im
            Gewerbeverein Bauma sind wir Mitglied und wirken im OK des kommenden
            Gewerbeevents mit. Ob Fest, Praxis oder Gewerbebetrieb, wir wissen, wie
            Kommunikation im Tösstal funktioniert, weil wir selbst von hier
            kommen.
          </p>
        </div>
      </article>
      <article class="lp-block" data-reveal>
        <h2>Webseite erstellen lassen, von der Webagentur aus dem Tal</h2>
        <div class="lp-text">
          <p>
            Was muss eine Website für einen Tösstaler Betrieb leisten? Die
            Kundschaft hier wohnt verteilt, in Dörfern, Weilern und auf
            Einzelhöfen. Wer einen Handwerker, eine Praxis oder ein Restaurant
            sucht, googelt zuerst. Deine Homepage muss dann sofort liefern:
            Leistungen, Öffnungszeiten und Kontakt auf einen Blick, auf dem
            Handy genauso wie am Computer. Genau dafür bauen wir: schnell, klar
            strukturiert und mit der SEO-Basis gleich mitgeliefert.
          </p>
          <p>
            Damit du auch auf der Karte gefunden wirst, gehört ein gepflegtes
            Google-Unternehmensprofil dazu.
            <a href="/google-business-profile/">Wir richten es dir ein</a> und
            zeigen dir, wie du es aktuell hältst, gerade für Betriebe abseits
            der Dorfstrasse ist das die halbe Miete.
          </p>
          <p>
            Uftritt ist dabei mehr als eine Webagentur: Als Werbeagentur decken
            wir ab, was darüber hinausgeht, Logo und Erscheinungsbild,
            Printwerbung, Video und die laufende Betreuung deiner Kommunikation.
            Ein Partner für alles, statt fünf Ansprechpersonen für fünf
            Disziplinen. Und wir sagen es auch, wenn weniger genügt: Für viele
            Betriebe im Tal ist ein gut gemachter Onepager die richtige Lösung -
            kein Grossprojekt.
          </p>
        </div>
      </article>
      <article class="lp-block" data-reveal>
        <h2>In vier Schritten zur neuen Website</h2>
        <div class="lp-text">
          <p>
            <strong>1. Erstgespräch bei dir.</strong> Kostenlos und unverbindlich
           , am liebsten bei dir im Betrieb, ob in Turbenthal, Fischenthal oder
            Zell: Wir sind ohnehin im Tal unterwegs. Wir hören zu, fragen nach
            und beraten ehrlich.
          </p>
          <p>
            <strong>2. Konzept und Prototyp.</strong> Du bekommst früh einen
            klickbaren Entwurf zu sehen, nicht erst am Ende. So gibt es keine
            Überraschungen.
          </p>
          <p>
            <strong>3. Umsetzung.</strong> Wir bauen die Seite, schreiben auf
            Wunsch die Texte und organisieren Fotografie, alles aus einer Hand.
          </p>
          <p>
            <strong>4. Launch und Betreuung.</strong> Nach dem Go-Live lassen
            wir dich nicht im Stich: <a href="/website-betreuung/">Betreuung
            und Wartung</a>, <a href="/seo-betreuung/">SEO-Begleitung</a> oder
            eine Schulung, damit du die Seite selbst pflegen kannst. Du hast
            schon eine ältere Website? Dann ist ein
            <a href="/website-relaunch/">Relaunch</a> der richtige Einstieg.
          </p>
        </div>
      </article>
      <article class="lp-block" data-reveal>
        <h2>Die Kostenfrage, ehrlich beantwortet</h2>
        <div class="lp-text">
          <p>
            Es kommt darauf an, was du brauchst: Ein Onepager kostet weniger als
            eine Plattform mit Shop, Pauschalpreise von der Stange wären
            unseriös. Was wir stattdessen anbieten: Nach dem kostenlosen
            Erstgespräch erhältst du ein transparentes Angebot mit allen
            Leistungen und einem klaren Preis.
          </p>
          <p>
            Zur Orientierung vorab: In unserem <a href="/website-kosten/">Guide
            zu Website-Kosten</a> zeigen wir echte Marktpreise in der Schweiz -
            damit du weisst, was eine Website kosten darf, bevor du mit uns oder
            einer anderen Agentur sprichst.
          </p>
          <p>
            Und wir beraten auch darin, was du dir sparen kannst: Nicht jeder
            Betrieb braucht jede Funktion, das Budget eines Tösstaler Gewerbes
            ist uns so vertraut wie der Weg zum Bahnhof.
          </p>
        </div>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <header class="section-head" data-reveal>
        <span class="eyebrow">In deiner Nähe</span>
        <h2>Webdesign in deinem Ort</h2>
      </header>
      <div class="orte" data-reveal>
        {
          orte.map((o) => (
            <a class="ort-card" href={o.href}>
              <span class="ort-name">{o.name}</span>
              <span class="ort-note">{o.note}</span>
            </a>
          ))
        }
      </div>
      <p class="orte-note" data-reveal>
        Und natürlich auch in: {weitere.join(", ")}, kurzum: in jedem Dorf und
        jedem Weiler des Tals.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container faq-wrap">
      <header class="section-head" data-reveal>
        <span class="eyebrow">FAQ</span>
        <h2>Die wichtigsten Fragen, ehrlich beantwortet</h2>
      </header>
      <div class="faq" data-reveal>
        {
          faq.map((f, i) => (
            <details class="faq-item" name="faq" open={i === 0}>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <LocalTrust />

  <section class="section section--yellow">
    <div class="container lp-cta" data-reveal>
      <h2>Bereit für deinen neuen Webauftritt im Tösstal?</h2>
      <Button href="/kontakt/" variant="blue">Schriib eus</Button>
    </div>
  </section>

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faq.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    })}
  />
</Layout>

<style>
  .lp-blocks { display: flex; flex-direction: column; gap: clamp(2.5rem, 5vw, 4.5rem); }
  .lp-block { display: grid; grid-template-columns: 1fr 2fr; gap: clamp(1rem, 3vw, 3rem); align-items: start; }
  .lp-block h2 { position: sticky; top: 100px; }
  .lp-text p { color: var(--color-blue); font-size: 1.1rem; line-height: 1.7; margin-bottom: 1rem; }
  .lp-text a { color: var(--color-blue); text-decoration: underline; text-underline-offset: 0.15em; }

  .orte { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(0.75rem, 2vw, 1.5rem); }
  .ort-card {
    display: flex; flex-direction: column; gap: 0.3rem;
    background: #fff; border: 1px solid #e7ecf3; padding: clamp(1.25rem, 2.5vw, 1.75rem);
    transition: border-color 0.3s var(--ease), transform 0.3s var(--ease);
  }
  .ort-card:hover { border-color: var(--color-blue); transform: translateY(-2px); }
  .ort-name { font-weight: 700; font-size: 1.25rem; color: var(--color-blue); }
  .ort-note { color: var(--color-blue); opacity: 0.8; font-size: 0.95rem; }
  .orte-note { margin-top: 1.5rem; color: var(--color-blue); line-height: 1.7; max-width: 75ch; }

  .faq-wrap { max-width: 860px; }
  .faq-item { border-bottom: 1px solid rgba(1, 64, 128, 0.2); }
  .faq-item summary {
    cursor: var(--cur-hand); list-style: none; padding: 1.1rem 0;
    font-weight: 700; color: var(--color-blue); font-size: 1.15rem;
    display: flex; justify-content: space-between; gap: 1rem;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: "+"; display: inline-flex; align-items: center; justify-content: center; width: 1em; height: 1em; line-height: 1; transform-origin: center; font-weight: 700; transition: transform 0.3s var(--ease); }
  .faq-item[open] summary::after { transform: rotate(45deg); }
  .faq-item p { color: var(--color-blue); line-height: 1.7; padding-bottom: 1.1rem; max-width: 70ch; }
  .lp-cta { display: flex; flex-direction: column; align-items: flex-start; gap: 1.25rem; }

  @media (max-width: 900px) {
    .orte { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 760px) {
    .lp-block { grid-template-columns: 1fr; }
    .lp-block h2 { position: static; }
  }
  @media (max-width: 520px) {
    .orte { grid-template-columns: 1fr; }
  }
</style>
