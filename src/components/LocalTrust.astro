---
// Vertrauens-Band fuer lokale Landingpages: Gratis-Website-Check als Lead-Magnet
// (Muster der Wettbewerber, siehe
// Strategie/2026-08-14_Wettbewerbsanalyse-SEO-Agenturen.md).
// 2026-10-20: Die Zeile «5.0 aus 15 Google-Bewertungen» mit Sternen ist auf
// Marcels Entscheid raus («sieht billig aus»). Die echten Google-Stimmen
// leben in Reviews.astro / src/data/reviews.ts weiter.
// 2026-11-11: Umzug von /kontakt/ (48 h, manuell) auf /website-check/
// (60 Sekunden, automatisch), Marcel. Die manuelle Besprechung bleibt als
// CTA im Tool erreichbar.

interface Props {
  check?: boolean;
}

const { check = true } = Astro.props;
---

{
  check && (
    <div class="lt" data-reveal>
      <div class="container lt-inner">
        <p class="lt-audit">
          Schon eine Website? Unser Check analysiert sie in 60 Sekunden: Note, über 45
          Kriterien, ehrliches Fazit. Gratis und ohne Anmeldung.
          <a href="/website-check/">Jetzt gratis prüfen →</a>
        </p>
      </div>
    </div>
  )
}

<style>
  .lt {
    background: #fff;
    border-block: 1px solid #e7ecf3;
  }
  .lt-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    flex-wrap: wrap;
    padding-block: 1.4rem;
  }
  .lt-audit {
    color: var(--color-blue);
    margin: 0;
    line-height: 1.6;
    max-width: 60ch;
  }
  .lt-audit a {
    color: var(--color-blue);
    font-weight: 700;
    white-space: nowrap;
  }
  .lt-audit a:hover {
    color: var(--color-pink);
  }
  @media (max-width: 760px) {
    .lt-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
  }
</style>
